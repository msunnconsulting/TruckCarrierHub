    <!-- Monthly Calendar Heatmap -->
    @if (Model.MonthlyAll != null && Model.MonthlyAll.Count > 0)
    {
        int nrCalMax = Model.MonthlyAll.Max(x => x.Count);
        if (nrCalMax == 0) { nrCalMax = 1; }
        var nrByYM   = Model.MonthlyAll.ToDictionary(x => x.YearMonth, x => x.Count);
        var nrYears  = Model.MonthlyAll.Select(x => x.YearMonth / 100).Distinct().OrderBy(y => y).ToList();
        string[] nrMNames = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

        <div class="nr-card" style="margin-bottom:24px;">
            <div class="nr-card-header">
                <div class="nr-card-title"><i class="fa fa-calendar"></i> Monthly Registration Calendar <span style="font-weight:400;color:#6b7280;font-size:.88em;">(@rangeLabel)</span></div>
                <span style="font-size:.78em;color:#6b7280;">Darker = more registrations</span>
            </div>
            <div class="nr-cal-wrap">
                <table class="nr-cal-table">
                    <thead>
                        <tr>
                            <th style="text-align:right;padding-right:8px;">Year</th>
                            @foreach (var mn in nrMNames) { <th>@mn</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var yr in nrYears)
                        {
                            <tr>
                                <td class="nr-cal-year">@yr</td>
                                @for (int mo = 1; mo <= 12; mo++)
                                {
                                    int ym = yr * 100 + mo;
                                    if (nrByYM.ContainsKey(ym))
                                    {
                                        int cnt = nrByYM[ym];
                                        double intensity = (double)cnt / nrCalMax;
                                        int r = (int)(237 + (91  - 237) * intensity);
                                        int g = (int)(233 + (33  - 233) * intensity);
                                        int b = (int)(254 + (182 - 254) * intensity);
                                        string bg = "rgb(" + r + "," + g + "," + b + ")";
                                        string fg = intensity > 0.55 ? "#fff" : "#374151";
                                        <td><span class="nr-cal-cell" style="background:@bg;color:@fg;">@cnt.ToString("N0")</span></td>
                                    }
                                    else
                                    {
                                        <td><span class="nr-cal-cell" style="background:#f9fafb;color:#d1d5db;">—</span></td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

