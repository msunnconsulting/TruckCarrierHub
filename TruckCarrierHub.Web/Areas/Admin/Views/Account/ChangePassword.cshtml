@model PartnerCarrier.ViewModels.Admin.ChangePasswordVM
@{
    ViewBag.Title = "Change Password";
}

<div class="row">
    <div class="col-md-12">
        <h2>@ViewBag.Title</h2>

    </div>
</div>
<hr class="small" />
<div id="dvNotification"></div>

@using (Ajax.BeginForm("ChangePassword", "Account", null, new AjaxOptions
{
    OnSuccess = "vm.ChangePasswordOnSuccess",
    OnFailure = "vm.ChangePasswordOnFailure"
}))
{

    @Html.AntiForgeryToken()
    <div class="row form-group">
        <div class="col-sm-6 col-md-8">
            <div class="form-group">
                <div class="col-sm-6 col-md-3">
                    @Html.LabelFor(m => m.OldPassword, new { @class = "" })
                </div>
                <div class="col-md-6">
                    @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", placeholder = "Current password", maxlength = "50" })
                    @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-sm-6 col-md-8">
            <div class="form-group">
                <div class="col-sm-6 col-md-3">
                    @Html.LabelFor(m => m.NewPassword, new { @class = "" })
                </div>
                <div class="col-md-6">
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "New password", maxlength = "50" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-sm-6 col-md-8">
            <div class="form-group">
                <div class="col-sm-6 col-md-3">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "" })
                </div>
                <div class="col-md-6">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm password", maxlength = "50" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-sm-6 col-md-8">
            <div class="form-group">
                <div class="col-sm-6 col-md-3">
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-primary" title="Change Password"><i class="fa fa-lock"></i> Change Password</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Areas/Admin/Content/PageScript/Account/change-password.js"></script>
}
