@using PartnerCarrier.ViewModels.Admin
@model ManageCitiesVM
@{
    ViewBag.Title = "Manage Cities";
}

<style>
    .city-table td { vertical-align: middle; }
    .edit-row td { padding: 12px 16px; background: #f9f9f9; }
    .desc-preview { color: #666; font-size: 12px; }
    .renew-panel .form-group { margin-bottom: 0; }
    #renewStatus .progress { margin-bottom: 4px; }
</style>

<div class="row">
    <div class="col-md-12">
        <h2>@ViewBag.Title</h2>
    </div>
</div>
<hr class="small" />
<div class="row" id="dvNotification"></div>

@* City count update *@
<div class="row" style="margin-bottom:16px;">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading"><strong>City Count Update</strong></div>
            <div class="panel-body">
                <button type="button" class="btn btn-default" onclick="onStartCitiesUpdateButtonClick()">Start Cities Update</button>
                <button type="button" class="btn btn-primary" onclick="onFinishCitiesUpdateButtonClick()" style="margin-left:8px;">Finish Cities Update</button>
                <span id="updateStatus" class="text-muted small" style="margin-left:12px;"></span>
            </div>
        </div>
    </div>
</div>

@* Renew content panel *@
<div class="row" style="margin-bottom:16px;">
    <div class="col-md-12">
        <div class="panel panel-default renew-panel">
            <div class="panel-heading"><strong>Renew City Content</strong></div>
            <div class="panel-body">
                <div class="form-inline" style="margin-bottom:10px;">
                    <div class="form-group">
                        <label>Min Companies:</label>
                        <input type="number" id="minCompanies" class="form-control input-sm" value="1" min="0" style="width:80px; margin-left:6px;">
                    </div>
                    <div class="form-group" style="margin-left:16px;">
                        <label>Max Companies:</label>
                        <input type="number" id="maxCompanies" class="form-control input-sm" value="0" min="0" style="width:80px; margin-left:6px;" title="0 = no upper limit">
                    </div>
                    <div class="form-group" style="margin-left:16px;">
                        <label>Last renewed before:</label>
                        <input type="date" id="lastRenewedBefore" class="form-control input-sm" style="width:150px; margin-left:6px;" title="Include cities with LastRenewedDate older than this date, or never renewed (NULL)">
                    </div>
                    <button type="button" id="filterBtn" class="btn btn-default btn-sm" onclick="applyFilter(this)" style="margin-left:12px;">Filter Table</button>
                    <button type="button" class="btn btn-link btn-sm" onclick="clearFilter()">Clear</button>
                    <span id="filteredCount" class="text-muted small" style="margin-left:8px;"></span>
                </div>
                <div>
                    <button type="button" class="btn btn-warning btn-sm" onclick="renewSelected()">Renew Selected</button>
                    <button type="button" class="btn btn-primary btn-sm" onclick="renewAllFiltered()" style="margin-left:6px;">Renew All Filtered</button>
                </div>
                <div id="renewStatus" style="margin-top:10px; display:none;">
                    <div class="progress" style="margin-bottom:4px; height:18px;">
                        <div id="renewProgressBar" class="progress-bar progress-bar-striped active" role="progressbar" style="width:0%; min-width:2em;">0%</div>
                    </div>
                    <span id="renewMessage" class="text-muted small"></span>
                </div>
            </div>
        </div>
    </div>
</div>

@* City table *@
<div class="row">
    <div class="col-md-12">
        <div style="margin-bottom:8px;" class="form-inline">
            <button type="button" class="btn btn-xs btn-default" onclick="selectAllVisible()">Select All Visible</button>
            <button type="button" class="btn btn-xs btn-default" onclick="deselectAll()" style="margin-left:4px;">Deselect All</button>
            <span id="selectedCount" class="text-muted small" style="margin-left:10px;">0 selected</span>
        </div>
        <table class="table table-bordered table-condensed city-table" id="citiesTable">
            <thead>
                <tr>
                    <th width="3%"><input type="checkbox" id="selectAllCheck" onclick="toggleSelectAll(this)" title="Select all visible"></th>
                    <th width="6%">Country</th>
                    <th width="13%">State</th>
                    <th width="13%">City</th>
                    <th width="4%">#</th>
                    <th width="28%">Description</th>
                    <th width="7%">Article</th>
                    <th width="11%">Last Renewed</th>
                    <th width="7%"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.List != null && Model.List.Count > 0)
                {
                    foreach (var city in Model.List)
                    {
                        var hasDesc = !string.IsNullOrEmpty(city.Description);
                        var hasArticle = !string.IsNullOrEmpty(city.Article);
                        var descPreview = hasDesc
                            ? (city.Description.Length > 70 ? city.Description.Substring(0, 70) + "..." : city.Description)
                            : "-";
                        var renewedStr = city.LastRenewedDate.HasValue
                            ? city.LastRenewedDate.Value.ToString("yyyy-MM-dd")
                            : "-";

                        <tr class="city-row"
                            data-companies="@city.NoCompanies"
                            data-url="@city.CityURL"
                            data-statecode="@city.StateCode"
                            data-cityname="@city.City">
                            <td><input type="checkbox" class="city-checkbox"></td>
                            <td>@city.Country</td>
                            <td>@city.State</td>
                            <td><a href="/@city.CityURL" target="_blank">@city.City</a></td>
                            <td>@city.NoCompanies</td>
                            <td class="desc-preview">@descPreview</td>
                            <td class="text-center article-indicator">@(hasArticle ? "Yes" : "-")</td>
                            <td class="small renewed-date">@renewedStr</td>
                            <td>
                                <button type="button" class="btn btn-xs btn-default edit-btn" onclick="toggleEdit(this)">Edit</button>
                                <button type="button" class="btn btn-xs btn-info preview-btn" onclick="previewCity(this)" style="margin-left:3px;" title="Generate preview with AI">AI</button>
                            </td>
                        </tr>
                        <tr class="edit-row" style="display:none;"
                            data-statecode="@city.StateCode"
                            data-cityname="@city.City">
                            <td colspan="9">
                                <div class="form-group">
                                    <label>Description <small class="text-muted">(max 500 chars, ~140–160 ideal for SEO)</small></label>
                                    <textarea class="form-control edit-description" rows="2" maxlength="500">@city.Description</textarea>
                                    <span class="desc-char-count text-muted small"></span>
                                </div>
                                <div class="form-group" style="margin-top:8px;">
                                    <label>Article <small class="text-muted">(leave blank to hide article section on city page)</small></label>
                                    <textarea class="form-control edit-article" rows="6">@city.Article</textarea>
                                </div>
                                <div style="margin-top:8px;">
                                    <button type="button" class="btn btn-sm btn-primary save-btn" onclick="saveCity(this)">Save</button>
                                    <button type="button" class="btn btn-sm btn-default" onclick="cancelEdit(this)" style="margin-left:6px;">Cancel</button>
                                    <span class="save-status small" style="margin-left:10px;"></span>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center well">No cities found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script type="text/javascript">

// ── Edit / Save ──────────────────────────────────────────────────────────────

function toggleEdit(btn) {
    var dataRow = $(btn).closest('tr');
    var editRow = dataRow.next('.edit-row');
    var opening = !editRow.is(':visible');

    // Close any other open rows
    $('.edit-row:visible').hide();
    $('.edit-btn').text('Edit');

    if (opening) {
        editRow.show();
        $(btn).text('Close');
        updateCharCount(editRow.find('.edit-description'));
    }
}

function cancelEdit(btn) {
    var editRow = $(btn).closest('tr');
    editRow.hide();
    editRow.prev('.city-row').find('.edit-btn').text('Edit');
}

function updateCharCount(textarea) {
    var len = $(textarea).val().length;
    $(textarea).next('.desc-char-count').text(len + ' / 500');
}

function saveCity(btn) {
    var editRow = $(btn).closest('tr');
    var stateCode = editRow.data('statecode');
    var cityName = editRow.data('cityname');
    var description = editRow.find('.edit-description').val();
    var article = editRow.find('.edit-article').val();
    var statusEl = editRow.find('.save-status');

    $(btn).prop('disabled', true);
    statusEl.removeClass('text-success text-danger').text('Saving...');

    $.ajax({
        url: '/admin/business/save-city-content',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ stateCode: stateCode, cityName: cityName, description: description, article: article }),
        success: function (res) {
            $(btn).prop('disabled', false);
            if (res.success) {
                statusEl.addClass('text-success').text('Saved');
                var dataRow = editRow.prev('.city-row');
                var preview = description.length > 70 ? description.substring(0, 70) + '...' : description;
                dataRow.find('.desc-preview').text(description ? preview : '-');
                dataRow.find('.article-indicator').text(article ? 'Yes' : '-');
                dataRow.find('.renewed-date').text(new Date().toLocaleDateString());
                setTimeout(function () { statusEl.text(''); }, 3000);
            } else {
                statusEl.addClass('text-danger').text(res.message || 'Error');
            }
        },
        error: function () {
            $(btn).prop('disabled', false);
            statusEl.addClass('text-danger').text('Request failed');
        }
    });
}

// ── Filter ───────────────────────────────────────────────────────────────────

function pad2(n) { return n < 10 ? '0' + n : '' + n; }

function formatDotNetDate(val) {
    if (!val) return '-';
    var m = /\/Date\((-?\d+)\)\//.exec(val);
    if (!m) return '-';
    var d = new Date(parseInt(m[1]));
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
}

function escHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

function buildCityRowsHtml(cities) {
    if (!cities || !cities.length) {
        return '<tr><td colspan="9" class="text-center well">No cities match the filter.</td></tr>';
    }
    var parts = [];
    for (var i = 0; i < cities.length; i++) {
        var c = cities[i];
        var renewedStr = formatDotNetDate(c.LastRenewedDate);
        var hasDesc = c.Description && c.Description.length > 0;
        var descPreview = hasDesc
            ? (c.Description.length > 70 ? c.Description.substring(0, 70) + '...' : c.Description)
            : '-';
        var articleIndicator = (c.Article && c.Article.length > 0) ? 'Yes' : '-';
        parts.push(
            '<tr class="city-row"'
            + ' data-companies="' + c.NoCompanies + '"'
            + ' data-url="' + escHtml(c.CityURL) + '"'
            + ' data-statecode="' + escHtml(c.StateCode) + '"'
            + ' data-cityname="' + escHtml(c.City) + '">'
            + '<td><input type="checkbox" class="city-checkbox"></td>'
            + '<td>' + escHtml(c.Country) + '</td>'
            + '<td>' + escHtml(c.State) + '</td>'
            + '<td><a href="/' + escHtml(c.CityURL) + '" target="_blank">' + escHtml(c.City) + '</a></td>'
            + '<td>' + c.NoCompanies + '</td>'
            + '<td class="desc-preview">' + escHtml(descPreview) + '</td>'
            + '<td class="text-center article-indicator">' + articleIndicator + '</td>'
            + '<td class="small renewed-date">' + renewedStr + '</td>'
            + '<td>'
            + '<button type="button" class="btn btn-xs btn-default edit-btn" onclick="toggleEdit(this)">Edit</button>'
            + '<button type="button" class="btn btn-xs btn-info preview-btn" onclick="previewCity(this)" style="margin-left:3px;" title="Generate preview with AI">AI</button>'
            + '</td>'
            + '</tr>'
            + '<tr class="edit-row" style="display:none;"'
            + ' data-statecode="' + escHtml(c.StateCode) + '"'
            + ' data-cityname="' + escHtml(c.City) + '">'
            + '<td colspan="9">'
            + '<div class="form-group">'
            + '<label>Description <small class="text-muted">(max 500 chars, ~140-160 ideal for SEO)</small></label>'
            + '<textarea class="form-control edit-description" rows="2" maxlength="500">' + escHtml(c.Description || '') + '</textarea>'
            + '<span class="desc-char-count text-muted small"></span>'
            + '</div>'
            + '<div class="form-group" style="margin-top:8px;">'
            + '<label>Article <small class="text-muted">(leave blank to hide article section on city page)</small></label>'
            + '<textarea class="form-control edit-article" rows="6">' + escHtml(c.Article || '') + '</textarea>'
            + '</div>'
            + '<div style="margin-top:8px;">'
            + '<button type="button" class="btn btn-sm btn-primary save-btn" onclick="saveCity(this)">Save</button>'
            + '<button type="button" class="btn btn-sm btn-default" onclick="cancelEdit(this)" style="margin-left:6px;">Cancel</button>'
            + '<span class="save-status small" style="margin-left:10px;"></span>'
            + '</div>'
            + '</td>'
            + '</tr>'
        );
    }
    return parts.join('');
}

function applyFilter(btn) {
    var min = parseInt($('#minCompanies').val()) || 0;
    var max = parseInt($('#maxCompanies').val()) || 0;
    var lastRenewedBefore = $('#lastRenewedBefore').val() || '';
    var $btn = $(btn);
    $btn.prop('disabled', true).text('Filtering...');
    $('#filteredCount').text('Loading...');
    var filterData = { min: min, max: max };
    if (lastRenewedBefore) filterData.lastRenewedBefore = lastRenewedBefore;
    $.ajax({
        url: '/admin/business/filter-cities',
        type: 'GET',
        dataType: 'json',
        cache: false,
        global: false,
        data: filterData,
        success: function (cities) {
            try {
                var $tbody = $('#citiesTable tbody');
                $tbody[0].innerHTML = '';
                $tbody.append(buildCityRowsHtml(cities));
                $('#filteredCount').text((cities && cities.length ? cities.length : 0) + ' cities visible');
                updateSelectedCount();
            } catch (e) {
                alert('Filter render error: ' + e.message);
                $('#filteredCount').text('');
            }
        },
        error: function (xhr) {
            $('#filteredCount').text('');
            alert('Filter failed (HTTP ' + xhr.status + ').');
        },
        complete: function () {
            $btn.prop('disabled', false).text('Filter Table');
        }
    });
}

function clearFilter() {
    $('#minCompanies').val('1');
    $('#maxCompanies').val('0');
    $('#lastRenewedBefore').val('');
    window.location.reload();
}

// ── Selection ────────────────────────────────────────────────────────────────

function selectAllVisible() {
    $('.city-row:visible .city-checkbox').prop('checked', true);
    updateSelectedCount();
}

function deselectAll() {
    $('.city-checkbox').prop('checked', false);
    $('#selectAllCheck').prop('checked', false);
    updateSelectedCount();
}

function toggleSelectAll(cb) {
    $('.city-row:visible .city-checkbox').prop('checked', $(cb).prop('checked'));
    updateSelectedCount();
}

function updateSelectedCount() {
    var n = $('.city-checkbox:checked').length;
    $('#selectedCount').text(n + ' selected');
}

$(document).on('change', '.city-checkbox', function () { updateSelectedCount(); });

// ── Renew ────────────────────────────────────────────────────────────────────

var renewPollTimer = null;
var renewJobStartedThisSession = false;

function getVisibleUrls(checkedOnly) {
    var urls = [];
    $('.city-row:visible').each(function () {
        if (!checkedOnly || $(this).find('.city-checkbox').prop('checked')) {
            urls.push($(this).data('url'));
        }
    });
    return urls;
}

function renewSelected() {
    var urls = getVisibleUrls(true);
    if (urls.length === 0) { alert('Select at least one city first.'); return; }
    startRenew(urls);
}

function renewAllFiltered() {
    var urls = getVisibleUrls(false);
    if (urls.length === 0) { alert('No cities visible - adjust the filter first.'); return; }
    if (!confirm('Renew content for ' + urls.length + ' cities?')) return;
    startRenew(urls);
}

function startRenew(urls) {
    var min = parseInt($('#minCompanies').val()) || 0;
    var max = parseInt($('#maxCompanies').val()) || 0;
    var lastRenewedBefore = $('#lastRenewedBefore').val() || null;

    $.ajax({
        url: '/admin/business/start-city-renew',
        type: 'POST',
        global: false,
        contentType: 'application/json',
        data: JSON.stringify({ minCompanies: min, maxCompanies: max, cityURLs: urls, lastRenewedBefore: lastRenewedBefore }),
        success: function () {
            renewJobStartedThisSession = true;
            $('#renewStatus').show();
            $('#renewProgressBar').addClass('active').css('width', '0%').text('0%');
            $('#renewMessage').text('');
            pollRenewProgress();
        },
        error: function () { alert('Failed to start renew job.'); }
    });
}

function pollRenewProgress() {
    if (renewPollTimer) clearTimeout(renewPollTimer);
    $.ajax({
        url: '/admin/business/city-renew-progress',
        type: 'GET',
        global: false,
        success: function (res) {
            if (res.IsInProgress) {
                renewJobStartedThisSession = true;
                $('#renewStatus').show();
                var pct = res.Total > 0 ? Math.round(res.Processed / res.Total * 100) : 0;
                $('#renewProgressBar').css('width', pct + '%').text(pct + '%');
                $('#renewMessage').text(res.Message || '');
                renewPollTimer = setTimeout(pollRenewProgress, 2000);
            } else {
                $('#renewProgressBar').removeClass('active');
                if (renewJobStartedThisSession) {
                    $('#renewStatus').show();
                    $('#renewProgressBar').css('width', '100%').text('100%');
                    $('#renewMessage').text((res.Message || 'Complete') + ' — reloading...');
                    setTimeout(function () { location.reload(); }, 1500);
                } else {
                    $('#renewStatus').hide();
                }
            }
        }
    });
}

// ── City count update (existing) ─────────────────────────────────────────────

function onStartCitiesUpdateButtonClick() {
    $('#updateStatus').text('Loading...');
    $.ajax({
        url: '/admin/business/get-city-list-for-manage-city',
        type: 'GET',
        success: function (response) {
            var tbody = $('#citiesTable tbody');
            tbody.empty();
            if (response && response.length > 0) {
                response.forEach(function (city) {
                    tbody.append(
                        '<tr class="city-row" data-companies="' + city.NoCompanies + '" data-url="' + city.CityURL + '" data-statecode="" data-cityname="">'
                        + '<td><input type="checkbox" class="city-checkbox"></td>'
                        + '<td>' + (city.Country || '') + '</td>'
                        + '<td>' + (city.State || '') + '</td>'
                        + '<td><a href="/' + city.CityURL + '" target="_blank">' + city.City + '</a></td>'
                        + '<td>' + city.NoCompanies + '</td>'
                        + '<td class="desc-preview">-</td>'
                        + '<td class="text-center article-indicator">-</td>'
                        + '<td class="small renewed-date">-</td>'
                        + '<td></td>'
                        + '</tr>'
                    );
                });
                $('#updateStatus').text(response.length + ' pending cities loaded.');
            } else {
                tbody.append('<tr><td colspan="9" class="text-center well">No new cities found.</td></tr>');
                $('#updateStatus').text('No pending cities.');
            }
            updateSelectedCount();
        },
        error: function () { $('#updateStatus').text('Error loading cities.'); }
    });
}

function onFinishCitiesUpdateButtonClick() {
    var $btn = $('button[onclick="onFinishCitiesUpdateButtonClick()"]');
    $btn.prop('disabled', true);
    var fcuStart = Date.now();
    var fcuTimer = setInterval(function () {
        var secs = Math.round((Date.now() - fcuStart) / 1000);
        $('#updateStatus').text('Running... ' + secs + 's (this can take a minute or two - please wait)');
    }, 1000);
    $('#updateStatus').text('Running... 0s (this can take a minute or two - please wait)');
    $.ajax({
        url: '/admin/business/finish-cities-update',
        type: 'GET',
        timeout: 600000,
        success: function (response) {
            clearInterval(fcuTimer);
            $btn.prop('disabled', false);
            var secs = Math.round((Date.now() - fcuStart) / 1000);
            if (response && response.split) {
                var parts = response.split(/:(.+)/);
                var type = (parts[0] || '').trim().toLowerCase();
                var msg  = (parts[1] || response).trim();
                showAlertMessage('#dvNotification', type === 'success' ? 'success' : 'danger', msg + ' (' + secs + 's)');
                $('#updateStatus').text(type === 'success' ? 'Done in ' + secs + 's. Reload page to see updated list.' : 'Finished with errors - see message above.');
            } else {
                showAlertMessage('#dvNotification', 'danger', 'Unexpected response from server.');
                $('#updateStatus').text('Finished with an unexpected response.');
            }
        },
        error: function (xhr, status) {
            clearInterval(fcuTimer);
            $btn.prop('disabled', false);
            var detail = status === 'timeout' ? 'Request timed out - the update may still be running on the server; check the city list in a few minutes.' : 'Request failed (' + status + ').';
            showAlertMessage('#dvNotification', 'danger', detail);
            $('#updateStatus').text('Error running update.');
        }
    });
}

// ── Preview (single city AI generation) ──────────────────────────────────────

function friendlyAiError(raw) {
    if (!raw) return 'Generation failed.';
    // Try to extract OpenAI error object from raw string like "HTTP 429: {...}"
    var jsonStart = raw.indexOf('{');
    if (jsonStart >= 0) {
        try {
            var obj = JSON.parse(raw.substring(jsonStart));
            var code = obj.error && obj.error.code;
            var msg  = obj.error && obj.error.message;
            if (code === 'insufficient_quota')
                return 'OpenAI account has no remaining credits. Add credits at <a href="https://platform.openai.com/account/billing/overview" target="_blank">platform.openai.com</a>.';
            if (code === 'rate_limit_exceeded')
                return 'OpenAI rate limit hit. Wait a minute and try again.';
            if (msg) return 'OpenAI error: ' + msg;
        } catch (e) {}
    }
    if (raw.indexOf('429') >= 0) return 'OpenAI quota exceeded (HTTP 429). Check billing at platform.openai.com.';
    if (raw.indexOf('401') >= 0) return 'OpenAI API key rejected (HTTP 401). Check the OpenAIAPIKey config value.';
    return raw;
}

var _previewStateCode = '';
var _previewCityName  = '';

function previewCity(btn) {
    var dataRow = $(btn).closest('tr');
    _previewStateCode = dataRow.data('statecode');
    _previewCityName  = dataRow.data('cityname');

    if (!_previewStateCode || !_previewCityName) {
        alert('Cannot preview a city that has not yet been saved to the database.');
        return;
    }

    $('#previewModal .modal-title').text('AI Preview: ' + _previewCityName + ', ' + _previewStateCode);
    $('#previewLoading').show();
    $('#previewResult').hide();
    $('#previewError').hide().text('');
    $('#previewAcceptBtn').hide();
    $('#previewModal').modal('show');

    $.ajax({
        url: '/admin/business/preview-city-content',
        type: 'POST',
        global: false,
        contentType: 'application/json',
        data: JSON.stringify({ stateCode: _previewStateCode, cityName: _previewCityName }),
        timeout: 240000,
        success: function (res) {
            $('#previewLoading').hide();
            if (!res.Success) {
                $('#previewError').html(friendlyAiError(res.Error)).show();
                return;
            }
            var descLen = (res.Description || '').length;
            $('#previewCompanyCount').text(res.CompanyCount + ' active companies found.');
            $('#previewDescription').val(res.Description || '');
            $('#previewDescLen').text(descLen + ' chars' + (descLen < 140 || descLen > 160 ? ' (target 140-160)' : ' OK'));
            $('#previewArticle').val(res.Article || '');
            $('#previewResult').show();
            $('#previewAcceptBtn').show();
        },
        error: function (xhr, status) {
            $('#previewLoading').hide();
            $('#previewError').text(status === 'timeout' ? 'Request timed out (240 s). Large cities can be slow — try again.' : 'Request failed.').show();
        }
    });
}

function acceptPreview() {
    var description = $('#previewDescription').val();
    var article     = $('#previewArticle').val();

    $.ajax({
        url: '/admin/business/save-city-content',
        type: 'POST',
        global: false,
        contentType: 'application/json',
        data: JSON.stringify({ stateCode: _previewStateCode, cityName: _previewCityName,
                               description: description, article: article }),
        success: function (res) {
            if (res.success) {
                // Update the table row in place
                var dataRow = $('.city-row[data-statecode="' + _previewStateCode + '"][data-cityname="' + _previewCityName + '"]');
                var preview = description.length > 70 ? description.substring(0, 70) + '...' : description;
                dataRow.find('.desc-preview').text(description ? preview : '-');
                dataRow.find('.article-indicator').text(article ? 'Yes' : '-');
                dataRow.find('.renewed-date').text(new Date().toLocaleDateString());
                // Also populate the edit row textareas if expanded
                var editRow = dataRow.next('.edit-row');
                editRow.find('.edit-description').val(description);
                editRow.find('.edit-article').val(article);
                $('#previewModal').modal('hide');
            } else {
                alert('Save failed: ' + (res.message || 'Unknown error'));
            }
        },
        error: function () { alert('Save request failed.'); }
    });
}

// ── Char counter ─────────────────────────────────────────────────────────────

$(document).on('input', '.edit-description', function () {
    updateCharCount(this);
});

$(document).on('input', '#previewDescription', function () {
    var len = $(this).val().length;
    $('#previewDescLen').text(len + ' chars' + (len < 140 || len > 160 ? ' (target 140-160)' : ' OK'));
});

$(document).ready(function () {
    updateSelectedCount();
    // Check if a renew job is already running on page load
    pollRenewProgress();
});

</script>
}

@* Preview modal *@
<div class="modal fade" id="previewModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">AI Preview</h4>
            </div>
            <div class="modal-body">
                <div id="previewLoading" class="text-center" style="padding:30px;">
                    <span class="glyphicon glyphicon-refresh" style="font-size:24px;"></span>
                    <p class="text-muted" style="margin-top:10px;">Calling OpenAI — this may take 30–120 seconds for large cities...</p>
                </div>
                <div id="previewError" class="alert alert-danger" style="display:none;"></div>
                <div id="previewResult" style="display:none;">
                    <p id="previewCompanyCount" class="text-muted small"></p>
                    <div class="form-group">
                        <label>Description <span id="previewDescLen" class="text-muted small" style="margin-left:6px;"></span></label>
                        <textarea id="previewDescription" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                    <div class="form-group" style="margin-top:10px;">
                        <label>Article</label>
                        <textarea id="previewArticle" class="form-control" rows="10"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="previewAcceptBtn" class="btn btn-primary" onclick="acceptPreview()" style="display:none;">Accept &amp; Save</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Dismiss</button>
            </div>
        </div>
    </div>
</div>
