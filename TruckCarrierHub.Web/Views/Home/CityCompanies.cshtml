@model PartnerCarrier.ViewModels.Admin.StatisticsCityCompaniesVM
@using System.Globalization
@{
    Layout = "~/Themes/Bootstrap/Views/Shared/_Layout.cshtml";
    var pageTitle = ViewBag.Title ?? "Active Trucking Companies | Truck Carrier Hub";
    var ti = CultureInfo.CurrentCulture.TextInfo;
    string cityDisplay = ti.ToTitleCase(Model.CityName.ToLower());
    var sd = Model.SizeDistribution ?? new PartnerCarrier.ViewModels.Admin.CompanySizeDistribution();
    var sdTotal = sd.TotalReporting > 0 ? (double)sd.TotalReporting : 1.0;
    var ad = Model.AgeDistribution ?? new PartnerCarrier.ViewModels.Admin.CompanyAgeDistribution();
    string ccTotal          = Model.TotalActiveCompanies.ToString("N0");
    string ccCitySlug       = Model.CityName.Replace(" ", "-");
    string ccCanonical      = "https://truckcarrierhub.com/statistics/city/" + Model.StateCode + "/" + ccCitySlug;
    string ccStateCanonical = "https://truckcarrierhub.com/statistics/state/" + Model.StateCode;
    string mdash            = System.Char.ConvertFromUtf32(0x2014);
    string ccMetaFull       = cityDisplay + " trucking statistics " + mdash + " " + ccTotal + " active companies, new FMCSA registrations, fleet size analytics, cargo type breakdown, and company age data.";
    string ccMetaShort      = cityDisplay + ", " + Model.StateName + " trucking statistics " + mdash + " " + ccTotal + " active companies, fleet analytics, cargo types, and FMCSA data.";
    string ccMetaDesc       = ccMetaFull.Length <= 160 ? ccMetaFull : (ccMetaShort.Length <= 160 ? ccMetaShort : ccMetaShort.Substring(0, 157) + "...");
    var ccLd = new Newtonsoft.Json.Linq.JObject {
        ["@context"]    = "https://schema.org",
        ["@type"]       = "WebPage",
        ["name"]        = cityDisplay + ", " + Model.StateCode + " Trucking Statistics & Analytics",
        ["description"] = ccMetaDesc,
        ["url"]         = ccCanonical,
        ["breadcrumb"]  = new Newtonsoft.Json.Linq.JObject {
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new Newtonsoft.Json.Linq.JArray {
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home",                      ["item"] = "https://truckcarrierhub.com" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Statistics",                ["item"] = "https://truckcarrierhub.com/statistics" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "Active Trucking Companies", ["item"] = "https://truckcarrierhub.com/statistics/active-companies" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 4, ["name"] = Model.StateName,             ["item"] = ccStateCanonical },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 5, ["name"] = cityDisplay,                 ["item"] = ccCanonical }
            }
        }
    };
}
@section AdditionalMeta {
<meta name="description" content="@ccMetaDesc" />
<link rel="canonical" href="@ccCanonical" />
<script type="application/ld+json">@Html.Raw(ccLd.ToString(Newtonsoft.Json.Formatting.None))</script>
}
