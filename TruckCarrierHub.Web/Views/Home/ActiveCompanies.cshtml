                        {
                            double sliceDeg = Model.TopCargoTypes[di].CompanyCount / ctTotal * 360.0;
                            if (sliceDeg >= 0.1)
                            {
                                double startRad = ctAngle * Math.PI / 180.0;
                                double endRad   = (ctAngle + sliceDeg) * Math.PI / 180.0;
                                double x1 = ctCx + ctR * Math.Cos(startRad); double y1 = ctCy + ctR * Math.Sin(startRad);
                                double x2 = ctCx + ctR * Math.Cos(endRad);   double y2 = ctCy + ctR * Math.Sin(endRad);
                                double ix1 = ctCx + ctInner * Math.Cos(startRad); double iy1 = ctCy + ctInner * Math.Sin(startRad);
                                double ix2 = ctCx + ctInner * Math.Cos(endRad);   double iy2 = ctCy + ctInner * Math.Sin(endRad);
                                int la = sliceDeg > 180 ? 1 : 0;
                                string path = string.Format(System.Globalization.CultureInfo.InvariantCulture,
                                    "M{0:F1},{1:F1} A{2},{2} 0 {7} 1 {3:F1},{4:F1} L{8:F1},{9:F1} A{10},{10} 0 {7} 0 {5:F1},{6:F1} Z",
                                    x1, y1, ctR, x2, y2, ix1, iy1, la, ix2, iy2, ctInner);
                                ctPaths.AppendFormat("<path d=\"{0}\" fill=\"{1}\" />", path, ctColors[di]);
                            }
                            ctAngle += sliceDeg;
