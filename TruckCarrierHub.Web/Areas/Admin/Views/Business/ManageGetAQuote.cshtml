@using PartnerCarrier.ViewModels.Admin;

@model ManageGetAQuoteVM
@{
    ViewBag.Title = "Manage appearance of Get A Quote";
}

    <h2>Manage appearance of Get A Quote</h2>
<hr />

@*Append error message with HTML using jquery*@
<div class="row" id="dvNotification"></div>

@using (Ajax.BeginForm("save-getaquote-to-show", "business", null, new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "vm.OnSuccessGetAQuoteToShow",
    OnFailure = "vm.OnFailureGetAQuoteToShow"
}, new { id = "saveGetAQuoteToShowForm" }))
{

    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-sm-6 col-md-8">
            <label>Get A Quote gadget to show on:  </label>
            <div class="col-md-12 col-sm-12">
                @for (int i = 0; i < Model.GetAQuoteToShowList.Count; i++)
                {
                    <div class="checkbox checkbox-primary">
                        <label>@Html.CheckBoxFor(m => Model.GetAQuoteToShowList[i].ControlToShow) @Model.GetAQuoteToShowList[i].Name</label>
                        @Html.HiddenFor(m => Model.GetAQuoteToShowList[i].Id)
                        @Html.HiddenFor(m => Model.GetAQuoteToShowList[i].Name)
                    </div>
                }
            </div>
        </div>
    </div>

    <hr />
    <div class="row">
        <div class="col-sm-6 col-md-8">
            <button type="submit" class="btn btn-primary" value="update" title="Save"> Update</button>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Areas/Admin/Content/PageScript/AdminUsers/manage-getaquote-to-show.js"></script>
}

