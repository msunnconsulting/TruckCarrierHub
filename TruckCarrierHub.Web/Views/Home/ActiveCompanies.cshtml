        </div>

        <!-- Owner-Operator vs Fleet Companies -->
        <div class="ac-col-33">
            <div class="ac-card" style="height:100%;">
                <div class="ac-card-header">
                    <div class="ac-card-title"><i class="fa fa-pie-chart"></i> Owner-Operator vs Fleet Companies</div>
                </div>
                <div class="ac-donut-wrap">
                    @if (Model.SizeDistribution != null && Model.TotalActiveCompanies > 0)
                    {
                        var sd2 = Model.SizeDistribution;
                        int ooCount    = sd2.OneUnit;
                        int fleetCount = sd2.TwoToFive + sd2.SixToTwenty + sd2.TwentyOneToHundred + sd2.OverHundred;
                        int ooFleetTotal = ooCount + fleetCount;
                        if (ooFleetTotal == 0) { ooFleetTotal = 1; }
                        decimal ooPct    = Math.Round((decimal)ooCount    / ooFleetTotal * 100, 1);
                        decimal fleetPct = Math.Round((decimal)fleetCount / ooFleetTotal * 100, 1);

                        int oo2Size = 140; int oo2Cx = oo2Size / 2; int oo2Cy = oo2Size / 2; int oo2R = 56; int oo2Inner = 36;
                        var oo2Colors = new[] { "#2563eb", "#22c55e" };
                        var oo2Values = new[] { (double)ooCount, (double)fleetCount };
                        double oo2Total = oo2Values[0] + oo2Values[1];
                        if (oo2Total == 0) { oo2Total = 1; }
                        double oo2Angle = -90.0;
                        var oo2Paths = new System.Text.StringBuilder();
                        for (int di = 0; di < oo2Values.Length; di++)
                        {
                            double sliceDeg = oo2Values[di] / oo2Total * 360.0;
                            if (sliceDeg >= 0.1)
                            {
                                double startRad = oo2Angle * Math.PI / 180.0;
                                double endRad   = (oo2Angle + sliceDeg) * Math.PI / 180.0;
                                double x1 = oo2Cx + oo2R * Math.Cos(startRad); double y1 = oo2Cy + oo2R * Math.Sin(startRad);
                                double x2 = oo2Cx + oo2R * Math.Cos(endRad);   double y2 = oo2Cy + oo2R * Math.Sin(endRad);
                                double ix1 = oo2Cx + oo2Inner * Math.Cos(startRad); double iy1 = oo2Cy + oo2Inner * Math.Sin(startRad);
                                double ix2 = oo2Cx + oo2Inner * Math.Cos(endRad);   double iy2 = oo2Cy + oo2Inner * Math.Sin(endRad);
                                int la = sliceDeg > 180 ? 1 : 0;
                                string path2 = string.Format(System.Globalization.CultureInfo.InvariantCulture,
                                    "M{0:F1},{1:F1} A{2},{2} 0 {7} 1 {3:F1},{4:F1} L{8:F1},{9:F1} A{10},{10} 0 {7} 0 {5:F1},{6:F1} Z",
                                    x1, y1, oo2R, x2, y2, ix1, iy1, la, ix2, iy2, oo2Inner);
                                oo2Paths.AppendFormat("<path d=\"{0}\" fill=\"{1}\" />", path2, oo2Colors[di]);
                            }
                            oo2Angle += sliceDeg;
                        }
                        <div class="ac-donut-body">
                            <div class="ac-donut-svg-wrap">
                                <svg width="@oo2Size" height="@oo2Size" viewBox="0 0 @oo2Size @oo2Size">
                                    @Html.Raw(oo2Paths.ToString())
                                    <circle cx="@oo2Cx" cy="@oo2Cy" r="@oo2Inner" fill="#fff" />
                                </svg>
                                <div class="ac-donut-center">
                                    <div class="ac-donut-center-num" style="font-size:.80em;">@ooPct%</div>
                                    <div class="ac-donut-center-lbl">Owner-Op</div>
                                </div>
                            </div>
                            <div>
                                <table class="ac-ranked-table" style="font-size:.80em;">
                                    <thead>
                                        <tr>
                                            <th colspan="2">Company Type</th>
                                            <th>Companies</th>
                                            <th>% of Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="width:12px;padding-right:0;"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#2563eb;"></span></td>
                                            <td>Owner-Operator<br /><span style="color:#9ca3af;font-size:.88em;">(1 Power Unit)</span></td>
                                            <td class="ac-rank-count">@ooCount.ToString("N0")</td>
                                            <td class="ac-rank-pct">@ooPct%</td>
                                        </tr>
                                        <tr>
                                            <td style="padding-right:0;"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#22c55e;"></span></td>
                                            <td>Fleet Companies<br /><span style="color:#9ca3af;font-size:.88em;">(2+ Power Units)</span></td>
                                            <td class="ac-rank-count">@fleetCount.ToString("N0")</td>
                                            <td class="ac-rank-pct">@fleetPct%</td>
                                        </tr>
                                        <tr style="border-top:2px solid #e5e7eb;">
                                            <td colspan="2" style="font-weight:700;color:#111827;">Total reporting fleet size</td>
                                            <td class="ac-rank-count">@ooFleetTotal.ToString("N0")</td>
                                            <td class="ac-rank-pct">100%</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p style="font-size:.75em;color:#9ca3af;margin-top:10px;line-height:1.5;">
                                    Owner-operators represent companies with 1 power unit.<br />
                                    Fleet companies represent companies with 2 or more power units.<br />
                                    Companies that do not report power-unit counts (@((Model.TotalActiveCompanies - ooFleetTotal).ToString("N0"))) are excluded.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
