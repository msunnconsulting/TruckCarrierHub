@using PartnerCarrier.ViewModels.User
@using Common.Utility.Extensions;
@using Common.Utility;
@using PartnerCarrier.ViewModels.Admin;
@using PartnerCarrier.Web.App_Start;
@using PartnerCarrier.Infrastructure.Contracts.Admin.AdminManagement;
@using PartnerCarrier.Web.SessionManager;
@model CompanyVM
@{
    ViewBag.Title = Model.PageTitle;
    var googleAPIKey = Config.GetValue("GoogleAPIKeyForMap");

    var _businessManagements = StructuremapMvc.StructureMapDependencyScope.CurrentNestedContainer.GetInstance<IBusinessMangementService>();
    var globalHiring = _businessManagements.GetGlobalHiring();
    var reviewsFilter = _businessManagements.GetReviewsFilter();
    var IsShowOnCityPage = _businessManagements.GetCheckboxListForShowGetAQuoteControl()
        .Where(a => a.Name.Contains("Show on City page"))
        .Select(a => a.ControlToShow)
        .FirstOrDefault();

    if (globalHiring.GlobalHire == (int)GLobalHiring.CityPage || globalHiring.GlobalHire == (int)GLobalHiring.HomeStateAndCityPage || globalHiring.GlobalHire == (int)GLobalHiring.StateAndCityPage)
    {
        ViewBag.IsShowGlobalHiringCheckbox = true;
    }
    if (reviewsFilter.SelectedFilterValue == (int)ManageReviewEnum.CityPage || reviewsFilter.SelectedFilterValue == (int)ManageReviewEnum.HomeStateAndCityPage || reviewsFilter.SelectedFilterValue == (int)ManageReviewEnum.StateAndCityPage)
    {
        ViewBag.IsShowReviewsCheckbox = true;
    }

    ViewBag.IsHiringCheckboxIsChecked = SessionManager.Instance.IsHiringCheckboxIsChecked;
    ViewBag.IsReviewsFilterCheckboxIsChecked = SessionManager.Instance.IsReviewsFilterCheckboxIsChecked;

    var uri = Request.Url;
    var path = uri.AbsolutePath;
    var parts = path.Split(new[] { '/' }, StringSplitOptions.RemoveEmptyEntries);

    // Keep only /STATE/CITY, strip any sortby/cargo segments
    if (parts.Length >= 2)
    {
        path = "/" + parts[0] + "/" + parts[1];
    }

    // Preserve ?p= in the canonical so paginated pages don't all collapse to page 1.
    // Page 1 gets the clean URL (no query string); pages 2+ get ?p=N.
    var pageParam = Request.QueryString["p"];
    var canonicalQuery = !string.IsNullOrEmpty(pageParam) && pageParam != "1" ? "?p=" + pageParam : "";
    ViewBag.CanonicalUrl = uri.Scheme + "://" + uri.Authority + path + canonicalQuery;

    if (!string.IsNullOrEmpty(pageParam) && pageParam != "1")
    {
        ViewBag.Title = Model.PageTitle + " | Page " + pageParam;
    }


    var totalCount = Model.Companies != null ? Model.Companies.Pagination.TotalCount : 0;

    var cityDisplayName = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
        (Model.hdnCityName ?? "").Replace("-", " ").ToLower());
    var cityMetaFull  = "Find " + cityDisplayName + ", " + (Model.StateName ?? "") + " trucking companies and freight brokers \u2014 " + totalCount.ToString("N0") + " active companies, searchable by name, USDOT, cargo type, and more.";
    var cityMetaShort = "Find " + cityDisplayName + ", " + (Model.StateName ?? "") + " trucking companies and freight brokers \u2014 " + totalCount.ToString("N0") + " active companies.";
    var cityMetaDescription = cityMetaFull.Length <= 160 ? cityMetaFull : (cityMetaShort.Length <= 160 ? cityMetaShort : cityMetaShort.Substring(0, 157) + "...");

    // JSON-LD: ItemList for city listing (page 1 only)
    Newtonsoft.Json.Linq.JObject cityLd = null;
    if (string.IsNullOrEmpty(pageParam) || pageParam == "1")
    {
        string[] caProvinces = { "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT" };
        var cityItems = new Newtonsoft.Json.Linq.JArray();
        if (Model.Companies != null && Model.Companies.Items != null)
        {
            for (int ci = 0; ci < Model.Companies.Items.Count; ci++)
            {
                var co = Model.Companies.Items[ci];
                if (string.IsNullOrEmpty(co.CompanyName) || string.IsNullOrEmpty(co.PhysicalAddressCity)) { continue; }
                string coCountry = System.Array.IndexOf(caProvinces, (co.PhysicalAddressStateCode ?? "").ToUpper()) >= 0 ? "CA" : "US";
                cityItems.Add(new Newtonsoft.Json.Linq.JObject {
                    ["@type"]    = "ListItem",
                    ["position"] = ci + 1,
                    ["item"]     = new Newtonsoft.Json.Linq.JObject {
                        ["@type"]   = "LocalBusiness",
                        ["name"]    = co.CompanyName,
                        ["url"]     = "https://truckcarrierhub.com/" + (co.PhysicalAddressStateCode ?? "") + "/USDOT-" + co.USDOTNumber,
                        ["address"] = new Newtonsoft.Json.Linq.JObject {
                            ["@type"]           = "PostalAddress",
                            ["streetAddress"]   = co.PhysicalAddressStreet ?? "",
                            ["addressLocality"] = co.PhysicalAddressCity ?? "",
                            ["addressRegion"]   = co.PhysicalAddressStateCode ?? "",
                            ["postalCode"]      = co.PhysicalAddressZipCode ?? "",
                            ["addressCountry"]  = coCountry
                        }
                    }
                });
            }
        }
        cityLd = new Newtonsoft.Json.Linq.JObject {
            ["@context"]       = "https://schema.org",
            ["@type"]          = "ItemList",
            ["name"]           = "Trucking Companies in " + cityDisplayName + ", " + (Model.StateName ?? ""),
            ["url"]            = "https://truckcarrierhub.com/" + (parts.Length > 0 ? parts[0] : "") + "/" + (Model.hdnCityName ?? ""),
            ["numberOfItems"]  = totalCount,
            ["itemListElement"] = cityItems
        };
    }
}

@section AdditionalMeta {
    <meta name="description" content="@cityMetaDescription" />
    <link rel="canonical" href="@ViewBag.CanonicalUrl" />
    @if (cityLd != null) {
    <script type="application/ld+json">@Html.Raw(cityLd.ToString(Newtonsoft.Json.Formatting.None))</script>
    }
}

@Html.Partial("_ReviewModal")

@Html.HiddenFor(c => Model.City, new { id = "city" })
@Html.HiddenFor(s => Model.StateCode, new { id = "stateCode" })
@Html.HiddenFor(a => a.hdnCityName, new { id = "cityName" })

<style>
    /* GetAQuote control override */
    .homepage-font-color { color: black !important; }

    /* ---- City page header ---- */
    .city-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin: 20px 0 16px;
        flex-wrap: wrap;
    }
    .city-header-left { flex: 1; min-width: 0; }
    .city-title {
        font-size: 22px;
        margin: 0 0 6px;
        line-height: 1.2;
    }
    .city-result-count {
        font-size: 13px;
        color: var(--steel-500);
    }
    .city-result-count .total-companies { font-weight: 600; color: var(--ink-900); }
    .city-header-toggle { flex-shrink: 0; align-self: flex-start; }

    /* ---- City article ---- */
    .city-article {
        background: var(--white);
        border: 1px solid var(--steel-200);
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 16px;
        font-size: 14px;
        line-height: 1.7;
        color: var(--ink-900);
    }
    .city-article-text { margin: 0 0 10px; }
    .city-article-text.is-truncated { overflow: hidden; max-height: 120px; }
    .city-article-text.expanded { max-height: none; overflow: visible; }
    .city-article-toggle {
        font-size: 12px;
        padding: 3px 10px;
    }

    /* ---- Filter bar ---- */
    .city-filter-wrap {
        background: var(--white);
        border: 1px solid var(--steel-200);
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 16px;
    }
    .city-filter-wrap .facet-bar-container { padding: 0; }
    .city-filter-wrap .facet-options-list { margin: 0; }
    .facet-bar .facet-options-list.col-xs-12 { width: auto; }
    .facet-bar.facet-search-wrapper { background-color: transparent; }
    .city-filter-wrap .filter-dorpdown-padding { padding: 3px 4px; }
    .city-filter-wrap .dropdown-toggle {
        font-size: 13px;
        color: var(--ink-900);
        background: var(--paper-50);
        border: 1px solid var(--steel-200);
        border-radius: 6px;
        padding: 5px 10px;
        white-space: nowrap;
    }
    .city-filter-wrap .dropdown-toggle:hover,
    .city-filter-wrap .dropdown-toggle:focus {
        background: var(--steel-200);
        color: var(--ink-900);
        text-decoration: none;
    }
    .city-filter-wrap .dropdown-menu {
        border-radius: 8px;
        border: 1px solid var(--steel-200);
        box-shadow: 0 4px 14px rgba(15,34,54,0.10);
        padding: 8px 12px;
        min-width: 180px;
    }
    #tags_tagsinput { background: transparent !important; width: auto !important; height: auto !important; border: none !important; }
    .city-filter-wrap .no-hiring-disabled {
        font-size: 13px;
        color: var(--steel-500);
        padding: 5px 6px;
        cursor: default;
    }
    .city-filter-wrap .no-hiring-disabled:hover { text-decoration: none; }
    .city-filter-wrap .facet-search-wrapper .input-group-search { width: 100%; }
    .city-filter-wrap .searchFilterTextbox {
        font-size: 13px;
        height: 32px;
        border-radius: 6px 0 0 6px;
    }
    .city-filter-wrap #exampleButton {
        height: 32px;
        padding: 0 10px;
        border-radius: 0 6px 6px 0;
    }
    .city-filter-wrap .clear-filter-button { margin-right: 8px; }

    /* ---- Company cards ---- */
    .city-co-card {
        background: var(--white);
        border: 1px solid var(--steel-200);
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 12px;
        display: flex;
        gap: 16px;
        align-items: flex-start;
        flex-wrap: wrap;
    }
    .city-co-card:hover { border-color: var(--steel-300); }
    .city-co-main { flex: 1; min-width: 0; }
    .city-co-name-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }
    .city-co-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--ink-900);
        text-decoration: none;
        font-family: var(--font-display);
    }
    .city-co-name:hover { color: var(--signal-600); text-decoration: underline; }
    .city-co-stats {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--steel-500);
    }
    .city-co-stat { display: flex; gap: 4px; align-items: baseline; }
    .city-co-stat-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .city-co-stat-value { color: var(--ink-900); }
    .city-co-address { font-size: 13px; color: var(--steel-500); margin-top: 6px; }
    .city-co-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
        flex-shrink: 0;
    }
    .city-co-stars { color: var(--signal-500); font-size: 13px; white-space: nowrap; }
    .city-co-rating-score { font-weight: 600; color: var(--ink-900); font-size: 13px; margin-right: 3px; }
    .city-co-review-count { font-size: 12px; color: var(--steel-500); margin-left: 2px; }

    /* ---- Empty state ---- */
    .city-empty {
        background: var(--white);
        border: 1px solid var(--steel-200);
        border-radius: 10px;
        padding: 40px 20px;
        text-align: center;
        color: var(--steel-500);
        font-size: 14px;
    }

    /* ---- Responsive ---- */
    @@media (max-width: 767px) {
        .city-header { flex-direction: column; }
        .city-co-card { flex-direction: column; }
        .city-co-right { align-items: flex-start; flex-direction: row; flex-wrap: wrap; }
        .city-filter-wrap .facet-options-list { flex-wrap: wrap; }
    }

    /* ---- City data module ---- */
    .cm-wrap { margin-bottom: 16px; }
    .cm-heading { font-size: 17px; font-weight: 700; color: var(--ink-900); margin: 0 0 12px; }
    .cm-cards-grid .hpb-icon { width: 38px; height: 38px; margin-bottom: 10px; }
    .cm-cards-grid .hpb-icon .fa { font-size: 17px; }
    .cm-cards-grid .hpb-num { font-size: 1.45em; }
    .cm-cards-grid .hpb-label { font-size: 0.83em; }
    .cm-section { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 18px; margin-bottom: 12px; }
    .cm-section-title { font-size: 0.78em; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; }
    .cm-cargo-row { display: -webkit-box; display: -ms-flexbox; display: flex; -webkit-box-align: center; -ms-flex-align: center; align-items: center; gap: 10px; padding: 5px 0; border-bottom: 1px solid #f3f4f6; }
    .cm-cargo-row:last-child { border-bottom: none; }
    .cm-cargo-name { -webkit-box-flex: 1; -ms-flex: 1; flex: 1; font-size: 0.88em; color: #374151; }
    .cm-cargo-bar  { width: 56px; background: #e5e7eb; border-radius: 3px; height: 5px; -ms-flex-negative: 0; flex-shrink: 0; }
    .cm-cargo-fill { background: #3b82f6; border-radius: 3px; height: 5px; }
    .cm-cargo-pct  { font-size: 0.83em; font-weight: 700; color: #111827; min-width: 40px; text-align: right; white-space: nowrap; }
    .cm-hl-list { list-style: none; padding: 0; margin: 0; }
    .cm-hl-item { position: relative; padding: 6px 0 6px 22px; font-size: 0.9em; color: #374151; border-bottom: 1px solid #f3f4f6; line-height: 1.5; }
    .cm-hl-item:last-child { border-bottom: none; }
    .cm-hl-item::before { content: "\2192"; position: absolute; left: 0; color: #3b82f6; font-weight: 700; }
    .cm-footer { display: -webkit-box; display: -ms-flexbox; display: flex; gap: 14px; -ms-flex-wrap: wrap; flex-wrap: wrap; font-size: 0.83em; margin-bottom: 4px; }
    .cm-footer a { color: #2563eb; text-decoration: none; }
    .cm-footer a:hover { text-decoration: underline; }
    @@media (max-width: 640px) {
        .cm-cards-grid .hpb-card { -webkit-box-flex: 1; -ms-flex: 1 1 calc(50% - 6px); flex: 1 1 calc(50% - 6px); }
    }
</style>

<div class="container">

    @* Breadcrumb *@
    <ul class="breadcrumb">
        <li><a href="@Url.Content("~/")">Home</a></li>
        <li><a class="stateName" href="@Url.Content("~/" + Model.StateCode)">@Model.StateName</a></li>
        <li class="active" id="anchorCityName">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase((Model.hdnCityName ?? "").ToLower()))</li>
    </ul>

    @* Header row: heading + result count + List/Map toggle *@
    @{
        var cityModule     = ViewBag.CityModule    as PartnerCarrier.ViewModels.Admin.StatisticsCityCompaniesVM;
        var cityHighlights = ViewBag.CityModuleHighlights as List<string>;
        bool cmRenders     = cityModule != null && (string.IsNullOrEmpty(pageParam) || pageParam == "1");
    }
    <div class="city-header">
        <div class="city-header-left">
            <h1 class="city-title">Trucking companies in @(System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase((Model.hdnCityName ?? "").ToLower())), @Model.StateCode</h1>
            <div class="city-result-count">
                <span class="total-companies">@totalCount</span>
                @(totalCount == 1 ? "active company" : "active companies") found
            </div>
        </div>
        <div class="city-header-toggle">
            <div class="btn-group">
                <a onclick="vm.MapToListView();" href="javascript:void(0);" id="list-button" class="btn btn-default list-toggle-button" data-omtag="srp:list-view">List</a>
                <a onclick="vm.MapView();" id="map-button" class="btn btn-default map-toggle-button" data-omtag="srp:map-view">Map</a>
            </div>
        </div>
    </div>

    @* City data module — page 1 only, gates on 50+ active companies *@
    @if (cmRenders)
    {
        var cmCityUrl   = "/statistics/city/" + cityModule.StateCode + "/" + cityModule.CityName.Replace(" ", "-");
        var cmStateUrl  = "/statistics/state/" + cityModule.StateCode;
        bool cmShowCargo = cityModule.TopCargoTypes != null
                           && cityModule.TopCargoTypes.Any(c => c.CargoTypeName != "Other" && c.CompanyCount >= 30);
        bool cmShowHl    = cityHighlights != null && cityHighlights.Count > 0;
        <div class="cm-wrap"@(ViewBag.CityModuleHidden == true ? Html.Raw(" style=\"display:none;\"") : null)>
            <div class="hpb-grid cm-cards-grid" style="margin-bottom:12px;">
                <div class="hpb-card">
                    <div class="hpb-icon hpb-icon-blue"><i class="fa fa-truck"></i></div>
                    <div class="hpb-num">@cityModule.TotalActiveCompanies.ToString("N0")</div>
                    <div class="hpb-label">Active Companies</div>
                    <div class="hpb-note">@cityModule.PercentOfStateTotal.ToString("F1")% of @cityModule.StateName total</div>
                </div>
                @if (cityModule.MedianFleetSize > 0)
                {
                    <div class="hpb-card">
                        <div class="hpb-icon hpb-icon-green"><i class="fa fa-dashboard"></i></div>
                        <div class="hpb-num">@cityModule.MedianFleetSize</div>
                        <div class="hpb-label">Median Fleet Size</div>
                        <div class="hpb-note">of companies reporting fleet data</div>
                    </div>
                }
                @if (cityModule.NewRegistrationsLast24Months > 0)
                {
                    <div class="hpb-card">
                        <div class="hpb-icon hpb-icon-purple"><i class="fa fa-line-chart"></i></div>
                        <div class="hpb-num">@cityModule.NewRegistrationsLast24Months.ToString("N0")</div>
                        <div class="hpb-label">New Registrations (24 mo)</div>
                        <div class="hpb-note">avg @cityModule.AvgNewPerMonth.ToString("F1")/month</div>
                    </div>
                }
                @if (cityModule.OwnerOperatorPercent > 0
                     && cityModule.SizeDistribution != null
                     && cityModule.SizeDistribution.TotalReporting > 0)
                {
                    <div class="hpb-card">
                        <div class="hpb-icon hpb-icon-orange"><i class="fa fa-user"></i></div>
                        <div class="hpb-num">@cityModule.OwnerOperatorPercent.ToString("F1")%</div>
                        <div class="hpb-label">Owner-Operator Share</div>
                        <div class="hpb-note">of companies reporting fleet size</div>
                    </div>
                }
            </div>
            @if (cmShowCargo)
            {
                var cmCargo = cityModule.TopCargoTypes.Where(c => c.CargoTypeName != "Other").ToList();
                decimal cmCargoMax = cmCargo.Count > 0 ? cmCargo[0].PercentOfTotal : 1m;
                <div class="cm-section">
                    <div class="cm-section-title"><i class="fa fa-list-ul"></i> Top Cargo Types</div>
                    @foreach (var ct in cmCargo.Take(5))
                    {
                        decimal cmBarW = cmCargoMax > 0 ? Math.Round(ct.PercentOfTotal / cmCargoMax * 100m, 0) : 0;
                        <div class="cm-cargo-row">
                            <span class="cm-cargo-name">@ct.CargoTypeName</span>
                            <div class="cm-cargo-bar"><div class="cm-cargo-fill" style="width:@((int)cmBarW)%"></div></div>
                            <span class="cm-cargo-pct">@ct.PercentOfTotal.ToString("F1")%</span>
                        </div>
                    }
                    <div class="hpb-note" style="margin-top:8px;">Companies may select multiple cargo types &mdash; percentages are of @cityModule.TotalActiveCompanies.ToString("N0") active companies. Updated weekly.</div>
                </div>
            }
            @if (cmShowHl)
            {
                <div class="cm-section">
                    <div class="cm-section-title"><i class="fa fa-bolt"></i> What stands out</div>
                    <ul class="cm-hl-list">
                        @foreach (var hl in cityHighlights)
                        {
                            <li class="cm-hl-item">@hl</li>
                        }
                    </ul>
                </div>
            }
            <div class="cm-footer">
                <a href="@cmCityUrl">Full @cityDisplayName trucking statistics &rarr;</a>
                <a href="@cmStateUrl">@cityModule.StateName statistics &rarr;</a>
            </div>
        </div>
    }

    @* Get a Quote (admin-controlled) *@
    @if (IsShowOnCityPage == true)
    {
        <div class="homepage-font-color">
            @Html.Partial("_GetAQuoteControl", Model.GetAQuoteVM)
        </div>
    }

    @* Banner ad slot *@
    @if (Model.OutboundBanner.IsShow)
    {
        <div class="text-center" style="margin-bottom:16px;">
            @if (Model.OutboundBanner.IsFollow)
            {
                <a href="@Model.OutboundBanner.URL" class="banner-link" title="@Model.OutboundBanner.TitleText" target="_blank">
                    <img src="/get-banner-image?fileName=@Model.OutboundBanner.FileName" style="max-width:100%;max-height:200px;" alt="@Model.OutboundBanner.AltText" />
                </a>
            }
            else
            {
                <a href="@Model.OutboundBanner.URL" class="banner-link" title="@Model.OutboundBanner.TitleText" rel="nofollow" target="_blank">
                    <img src="/get-banner-image?fileName=@Model.OutboundBanner.FileName" style="max-width:100%;max-height:200px;" alt="@Model.OutboundBanner.AltText" />
                </a>
            }
        </div>
    }

    @* Filter bar *@
    <div id="facet-bar" class="city-filter-wrap facet-bar-wrap">
        <div class="affix-top facet-bar nopadding-left nopadding-right nomargin-left" data-offset-top="30px">
            @using (Ajax.BeginForm(Url.Content("~/" + Model.StateCode + "/" + Model.City), "", null, new AjaxOptions
            {
                HttpMethod = "POST",
                OnSuccess = "vm.OnSuccessSearchFilterResult",
                OnFailure = "vm.OnFailureSearchFilterResult",
                UpdateTargetId = "companyList"
            }, new { id = "filterCompanyForm" }))
            {
                <div class="container facet-bar-container nopadding-left">
                    <div class="col-md-2 col-sm-6 col-xs-12 nopadding-right nopadding-left">
                        <div class="form-group facet-search-wrapper">
                            <div class="input-group float-left input-group-search nomargin-left">
                                <div class="form-inline">
                                    <input type="search" class="form-control searchFilterTextbox" name="SearchText" placeholder="Search by city">
                                </div>
                                <span class="input-group-btn">
                                    <button type="button" onclick="vm.SearchFilterResult();" class="btn btn-primary" id="exampleButton"><span class="glyphicon glyphicon-search"></span></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-10 col-sm-12 col-xs-12 facet-bar facet-search-wrapper nopadding-left nopadding-right">
                        <ul class="nav navbar-nav facet-options-list float-left filter-button col-xs-12 nomargin-left nopadding-right">
                            <li class="dropdown entity-dropdown filter-dorpdown-padding">
                                <a href="#" class="dropdown-toggle text-center" data-toggle="dropdown" aria-expanded="false">Entity Type <i class="fa fa-angle-down fa-lg" aria-hidden="true"></i><p class="pull-right filterApplyBtnForEntityType hidden-lg hidden-md hidden-sm" style="display:none">Apply</p></a>
                                <ul class="dropdown-menu dropdowntoggle-autoclose">
                                    <div class="checkbox checkbox-primary">
                                        <input id="entitytype-any" name="" value="Any" type="checkbox" checked="checked">
                                        <label for="entitytype-any">Any</label>
                                    </div>
                                    <div class="checkbox checkbox-primary">
                                        <input id="entity-carrier" class="entityType-checkbox" name="SelectedEntityTypes" value="C" type="checkbox">
                                        <label for="entity-carrier">Carrier</label>
                                    </div>
                                    <div class="checkbox checkbox-primary">
                                        <input id="entity-broker" class="entityType-checkbox" name="SelectedEntityTypes" value="B" type="checkbox">
                                        <label for="entity-broker">Broker</label>
                                    </div>
                                    <div class="checkbox checkbox-primary">
                                        <input id="entity-cargo-tank" class="entityType-checkbox" name="SelectedEntityTypes" value="T" type="checkbox">
                                        <label for="entity-cargo-tank">Cargo Tank</label>
                                    </div>
                                </ul>
                            </li>
                            <li class="dropdown cargo-dropdown filter-dorpdown-padding">
                                <a href="#" class="dropdown-toggle text-center" id="cargotypeCheckboxlist" data-toggle="dropdown">Cargo <i class="fa fa-angle-down fa-lg" aria-hidden="true"></i><p class="pull-right filterApplyBtnForCargoType hidden-lg hidden-md hidden-sm" style="display:none">Apply</p></a>
                                <ul class="dropdown-menu dropdowntoggle-autoclose cargo-dropdown-width">
                                    <div class="checkbox checkbox-primary">
                                        <input id="cargotype-all" type="checkbox" value="All" checked="checked">
                                        <label for="cargotype-all">All</label>
                                    </div>
                                    @for (int i = 0; i < Model.SearchFilter.CargoTypeList.Count; i++)
                                    {
                                        <div class="checkbox checkbox-primary">
                                            <input id="SelectedCargoTypes_@i" name="SelectedCargoTypes" type="checkbox" value="@Model.SearchFilter.CargoTypeList[i].Value">
                                            <label class="check" for="SelectedCargoTypes_@i">@Model.SearchFilter.CargoTypeList[i].Key</label>
                                        </div>
                                    }
                                </ul>
                            </li>
                            <li class="dropdown trucktractor-dropdown filter-dorpdown-padding">
                                <a href="#" class="dropdown-toggle text-center" data-toggle="dropdown">Trucks/Tractor <i class="fa fa-angle-down fa-lg" aria-hidden="true"></i><p class="pull-right filterApplyBtnForTruckAndTractor hidden-lg hidden-md hidden-sm" style="display:none">Apply</p></a>
                                <ul class="dropdown-menu dropdowntoggle-autoclose">
                                    <div class="col-xxs-6">
                                        <div class="filter-selection-list">
                                            <div class="checkbox checkbox-primary">
                                                <input id="trucktracktor-any" type="checkbox" value="Any" checked="checked">
                                                <label for="trucktracktor-any">Any</label>
                                            </div>
                                            <div class="checkbox checkbox-primary">
                                                <input name="SelectedTruckOrTractor" class="trucktractor-checkbox" value="1-5" id="truck1-5" type="checkbox">
                                                <label for="truck1-5">1 &ndash; 5</label>
                                            </div>
                                            <div class="checkbox checkbox-primary">
                                                <input name="SelectedTruckOrTractor" class="trucktractor-checkbox" value="6-10" id="truck6-10" type="checkbox">
                                                <label for="truck6-10">6 &ndash; 10</label>
                                            </div>
                                            <div class="checkbox checkbox-primary">
                                                <input name="SelectedTruckOrTractor" id="truck11-20" class="trucktractor-checkbox" value="11-20" type="checkbox">
                                                <label for="truck11-20">11 &ndash; 20</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xxs-6 truckposition">
                                        <div class="filter-selection-list">
                                            <div class="checkbox checkbox-primary">
                                                <input name="SelectedTruckOrTractor" class="trucktractor-checkbox" value="21-50" id="truck21-50" type="checkbox">
                                                <label for="truck21-50">21 &ndash; 50</label>
                                            </div>
                                            <div class="checkbox checkbox-primary">
                                                <input name="SelectedTruckOrTractor" class="trucktractor-checkbox" value="50-100" id="truck50-100" type="checkbox">
                                                <label for="truck50-100">50 &ndash; 100</label>
                                            </div>
                                            <div class="checkbox checkbox-primary">
                                                <input name="SelectedTruckOrTractor" class="trucktractor-checkbox" value="100-1000" id="truck100plus" type="checkbox">
                                                <label for="truck100plus">100+</label>
                                            </div>
                                        </div>
                                    </div>
                                </ul>
                            </li>
                            <li class="dropdown serviceType-dropdown filter-dorpdown-padding">
                                <a href="#" class="dropdown-toggle text-center" data-toggle="dropdown" aria-expanded="false">Service Type <i class="fa fa-angle-down fa-lg" aria-hidden="true"></i><p class="pull-right filterApplyBtnForServiceType hidden-lg hidden-md hidden-sm" style="display:none">Apply</p></a>
                                <ul class="dropdown-menu dropdowntoggle-autoclose serviceType-dropdown-width">
                                    <div class="checkbox checkbox-primary">
                                        <input id="servictype-all" type="checkbox" checked="checked" name="checkbox-proptype" value="">
                                        <label for="servictype-all">All</label>
                                    </div>
                                    @for (int i = 0; i < Model.SearchFilter.ServiceTypeList.Count; i++)
                                    {
                                        <div class="checkbox checkbox-primary">
                                            <input id="SelectedServiceTypes_@i" name="SelectedServiceTypes" type="checkbox" value="@Model.SearchFilter.ServiceTypeList[i].Value">
                                            <label class="check" for="SelectedServiceTypes_@i">@Model.SearchFilter.ServiceTypeList[i].Key</label>
                                        </div>
                                    }
                                </ul>
                            </li>
                            <li class="filter-dorpdown-padding city-filter-now-hiring-color">
                                <a href="#" class="text-center no-hiring-disabled">Now Hiring:</a>
                            </li>
                            <li class="dropdown trailerType-dropdown filter-dorpdown-padding city-filter-now-hiring-color">
                                <a href="#" class="dropdown-toggle text-center" data-toggle="dropdown" aria-expanded="false">Trailer Type <i class="fa fa-angle-down fa-lg" aria-hidden="true"></i><p class="pull-right filterApplyBtnForTrailerType hidden-lg hidden-md hidden-sm" style="display:none">Apply</p></a>
                                <ul class="dropdown-menu dropdowntoggle-autoclose trailerType-dropdown-width">
                                    <div class="checkbox checkbox-primary">
                                        <input id="trailertype-all" type="checkbox" checked="checked" name="checkbox-proptype" value="">
                                        <label for="trailertype-all">Not Interested</label>
                                    </div>
                                    @for (int i = 0; i < Model.SearchFilter.TrailerTypeList.Count; i++)
                                    {
                                        <div class="checkbox checkbox-primary">
                                            <input id="SelectedTrailerTypes_@i" name="SelectedTrailerTypes" type="checkbox" value="@Model.SearchFilter.TrailerTypeList[i].Value">
                                            <label class="check" for="SelectedTrailerTypes_@i">@Model.SearchFilter.TrailerTypeList[i].Key</label>
                                        </div>
                                    }
                                </ul>
                            </li>
                            <li class="dropdown driverType-dropdown filter-dorpdown-padding city-filter-now-hiring-color">
                                <a href="#" class="dropdown-toggle text-center" data-toggle="dropdown" aria-expanded="false">Driver Type <i class="fa fa-angle-down fa-lg" aria-hidden="true"></i><p class="pull-right filterApplyBtnForDriverType hidden-lg hidden-md hidden-sm" style="display:none">Apply</p></a>
                                <ul class="dropdown-menu dropdowntoggle-autoclose driverType-dropdown-width">
                                    <div class="checkbox checkbox-primary">
                                        <input id="drivertype-all" type="checkbox" checked="checked" name="checkbox-proptype" value="">
                                        <label for="drivertype-all">Not Interested</label>
                                    </div>
                                    @for (int i = 0; i < Model.SearchFilter.DriverTypeList.Count; i++)
                                    {
                                        <div class="checkbox checkbox-primary">
                                            <input id="SelectedDriverTypes_@i" name="SelectedDriverTypes" type="checkbox" value="@Model.SearchFilter.DriverTypeList[i].Value">
                                            <label class="check" for="SelectedDriverTypes_@i">@Model.SearchFilter.DriverTypeList[i].Key</label>
                                        </div>
                                    }
                                </ul>
                            </li>
                            <li class="dropdown sort-by-option filter-dorpdown-padding">
                                <a href="#" class="dropdown-toggle text-center" data-toggle="dropdown">Sort By <i class="fa fa-angle-down fa-lg" aria-hidden="true"></i><p class="pull-right filterApplyBtnForSortBy hidden-lg hidden-md hidden-sm" style="display:none">Apply</p></a>
                                <ul class="dropdown-menu dropdowntoggle-autoclose sortby-dropdown-width">
                                    <div class="radio radio-primary">
                                        <input id="Relevance" class="sortBy" name="SortBy" value="Relevance" type="radio">
                                        <label for="Relevance">Relevance</label>
                                    </div>
                                    <div class="radio radio-primary">
                                        <input id="Alphabetical" class="sortBy" name="SortBy" value="AlphabeticOrder" type="radio">
                                        <label for="Alphabetical">Alphabetical Order</label>
                                    </div>
                                    <div class="radio radio-primary">
                                        <input id="noofTrucks" class="sortBy" name="SortBy" value="NumberOfTrucks" type="radio">
                                        <label for="noofTrucks">Number of Trucks</label>
                                    </div>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            }
            <div id="map-progress-bar" class="hide">
                <div id="map-load-bar" class="map-load-bar"></div>
            </div>
        </div>
    </div>

    @* Active filter tags *@
    <div style="margin-bottom:8px;">
        <span id="span-tag" style="display:none">
            <input class="btn btn-warning pull-left clear-filter-button" type="button" value="Clear All" id="clearTags" />
            <input name="tags" id="tags" class="input-medium tm-input" />
        </span>
    </div>

    @* Company list (AJAX update target) *@
    <div id="companyList">
        @if (Model.Companies != null && Model.Companies.Items.Count > 0)
        {
            @* Top pagination *@
            <div style="margin-bottom:12px;">
                @Html.Pager("City", "home", new { stateCode = Model.StateCode, city = Model.City.Replace(" ", "-") }, Model.Companies.Pagination)
            </div>

            @* Company cards *@
            for (int i = 0; i < Model.Companies.Items.Count; i++)
            {
                var company = Model.Companies.Items[i];
                var coState = company.PhysicalAddressStateCode;
                var coUrl = Url.Content("~/" + coState + "/USDOT-" + company.USDOTNumber);

                // Pre-compute star rating so no @{} is needed inside markup below
                int cFull = 0;
                int cEmpty = 0;
                bool cHalf = false;
                if (company.TotalReviews > 0)
                {
                    double cRating = company.AverageRating;
                    cFull = (int)Math.Floor(cRating);
                    double cFrac = cRating - cFull;
                    cHalf = cFrac >= 0.25 && cFrac < 0.75;
                    if (cFrac >= 0.75) { cFull++; }
                    cEmpty = 5 - cFull - (cHalf ? 1 : 0);
                }

                <div class="city-co-card">
                    <div class="city-co-main">
                        <div class="city-co-name-row">
                            <a class="city-co-name" href="@coUrl">@company.CompanyName</a>
                            @if (company.Status != null && company.Status.ToLower() == "a")
                            {
                                <span class="status-badge is-active">Active</span>
                            }
                            else
                            {
                                <span class="status-badge is-inactive">Inactive</span>
                            }
                        </div>
                        <div class="city-co-stats">
                            @if (!string.IsNullOrEmpty(company.EntityType))
                            {
                                var entityMap = new System.Collections.Generic.Dictionary<string, string>
                                {
                                    { "C", "Carrier" }, { "B", "Broker" }, { "S", "Shipper" },
                                    { "F", "Freight Forwarder" }, { "I", "Intermodal Equip." }, { "T", "Cargo Tank" }
                                };
                                var entityNames = company.EntityType.Split(';')
                                    .Select(c => c.Trim())
                                    .Where(c => entityMap.ContainsKey(c))
                                    .Select(c => entityMap[c]);
                                var entityDisplay = string.Join(" · ", entityNames);
                                if (!string.IsNullOrEmpty(entityDisplay))
                                {
                                    <span class="city-co-stat">
                                        <span class="city-co-stat-value">@entityDisplay</span>
                                    </span>
                                }
                            }
                            <span class="city-co-stat">
                                <span class="city-co-stat-label">USDOT</span>
                                <span class="city-co-stat-value data-tag">@company.USDOTNumber</span>
                            </span>
                            @if (company.IccDocketNumberFirst.HasValue)
                            {
                                <span class="city-co-stat">
                                    <span class="city-co-stat-label">MC</span>
                                    <span class="city-co-stat-value data-tag">@company.IccDocketNumberFirst</span>
                                </span>
                            }
                            <span class="city-co-stat">
                                <span class="city-co-stat-label">Trucks</span>
                                <span class="city-co-stat-value">@(company.TruckOrTractor.HasValue ? company.TruckOrTractor.ToString() : "N/A")</span>
                            </span>
                            <span class="city-co-stat">
                                <span class="city-co-stat-label">Hiring</span>
                                @if (company.NowHiring)
                                {
                                    <span class="city-co-stat-value" style="color:var(--verified-600);font-weight:600;">@(company.CompanyDriverType != null && company.CompanyDriverType.Count > 0 ? string.Join(", ", company.CompanyDriverType) : "Yes")</span>
                                }
                                else
                                {
                                    <span class="city-co-stat-value" style="color:#9ca3af;">N/A</span>
                                }
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(company.PhysicalAddressStreet))
                        {
                            <div class="city-co-address">
                                @company.PhysicalAddressStreet, @company.PhysicalAddressCity, @company.StateCode @company.PhysicalAddressZipCode
                            </div>
                        }
                    </div>
                    <div class="city-co-right">
                        @if (company.TotalReviews > 0)
                        {
                            <div class="cursor-pointer" onclick="reviewVm.openReviewOverlay(@company.USDOTNumber)">
                                <span class="city-co-rating-score">@company.AverageRating</span>
                                <span class="city-co-stars">
                                    @for (int j = 0; j < cFull; j++) { <i class="fa fa-star"></i> }
                                    @if (cHalf) { <i class="fa fa-star-half-o"></i> }
                                    @for (int j = 0; j < cEmpty; j++) { <i class="fa fa-star-o"></i> }
                                </span>
                                <span class="city-co-review-count">(@company.TotalReviews)</span>
                            </div>
                        }
                        <a class="btn btn-primary btn-sm" href="@coUrl">View Details</a>
                    </div>
                </div>
            }

            @* Bottom pagination *@
            <div style="margin-top:8px;">
                @Html.Pager("City", "home", new { stateCode = Model.StateCode, city = Model.City.Replace(" ", "-") }, Model.Companies.Pagination)
            </div>
        }
        else
        {
            <div class="city-empty">No trucking companies matched your search criteria.</div>
        }
    </div>

    @* Map view *@
    <div class="col-md-12 col-xs-12 col-sm-12 nopadding-left" id="mapView" style="display:none">
        <div id="map" style="position:absolute;width:100%;height:85%;"></div>
    </div>

</div>@* /container *@

@section scripts {
    <script src="https://maps.googleapis.com/maps/api/js?key=@googleAPIKey"></script>
    <script src="~/Scripts/Common.AJAX.js"></script>
    <script src="~/Content/User/search-filter-on-company.js?v=@(System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/User/search-filter-on-company.js")).Ticks)"></script>
    <script src="~/Content/User/add-edit-review.js"></script>
    <script>
        $(document).ready(function () {
@if (Request.QueryString["view"] == "map")
{
    var mapAutoCityName = System.Web.HttpUtility.JavaScriptStringEncode((Model.hdnCityName ?? Model.City ?? "").Replace("-", " "));
    var mapAutoStateCode = System.Web.HttpUtility.JavaScriptStringEncode(Model.StateCode ?? "");
    @: // Arrived here via the /interactive-map landing page's city search (?view=map) - pre-fill
    @: // the same search box the existing Map/List toggle already uses, then open Map view
    @: // exactly as if the user had clicked the "Map" button themselves. Left entirely to
    @: // search-filter-on-company.js's own vm.MapView() - nothing here duplicates its logic.
    @: $(".searchFilterTextbox").val("@mapAutoCityName,@mapAutoStateCode");
    @: vm.MapView();
}
        });
    </script>
}
