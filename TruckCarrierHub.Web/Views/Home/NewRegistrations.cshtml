                            </div>
                            <div style="-webkit-box-flex:1;-ms-flex:1;flex:1;padding:10px 12px;border-right:1px solid #f3f4f6;">
                                <div style="font-size:.78em;color:#6b7280;margin-bottom:3px;">Motor Carriers</div>
                                <div style="font-size:1.05em;font-weight:700;color:#2563eb;">@Model.NewMotorCarrierCount.ToString("N0")</div>
                            </div>
                            <div style="-webkit-box-flex:1;-ms-flex:1;flex:1;padding:10px 12px;">
                                <div style="font-size:.78em;color:#6b7280;margin-bottom:3px;">Freight Brokers</div>
