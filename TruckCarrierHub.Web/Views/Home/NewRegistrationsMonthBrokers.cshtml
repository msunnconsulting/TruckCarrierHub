@model PartnerCarrier.ViewModels.Admin.StatisticsNewRegistrationsMonthVM
@using System.Globalization
@{
    Layout = "~/Themes/Bootstrap/Views/Shared/_Layout.cshtml";
    string mdash     = System.Char.ConvertFromUtf32(0x2014);
    var ti           = CultureInfo.CurrentCulture.TextInfo;
    string monthLbl  = Model.MonthName;
    string mm2       = Model.Month.ToString("D2");
    string monthBase = "/statistics/new-registrations/" + Model.Year.ToString() + "/" + mm2;
    string nrmCanon  = "https://truckcarrierhub.com" + monthBase + "/brokers";
    string nrmParent = "https://truckcarrierhub.com/statistics/new-registrations";
    string monthUrl  = "https://truckcarrierhub.com" + monthBase;

    string prevMonthName = Model.HasPrev ? new DateTime(Model.PrevYear, Model.PrevMonth, 1).ToString("MMMM yyyy") : "";
    string nextMonthName = Model.HasNext ? new DateTime(Model.NextYear, Model.NextMonth, 1).ToString("MMMM yyyy") : "";

    double shareOfTotal = Model.TotalCount > 0 ? (double)Model.BrokerCount / Model.TotalCount * 100.0 : 0;
    double brkTrend     = Model.PrevBrokerCount > 0 ? ((double)(Model.BrokerCount - Model.PrevBrokerCount)) / Model.PrevBrokerCount * 100.0 : 0;
    string topStateStr  = !string.IsNullOrEmpty(Model.BrokerTopState) ? Model.BrokerTopState : mdash;

    string topStateSuffix = !string.IsNullOrEmpty(Model.BrokerTopState) ? ", led by " + Model.BrokerTopState : "";
    string heroIntro = Model.BrokerCount > 0
        ? Model.BrokerCount.ToString("N0") + " new freight brokers registered with FMCSA in " + monthLbl + " " + mdash + " " + shareOfTotal.ToString("F1") + "% of all new registrations that month" + topStateSuffix + "."
        : "No freight broker registrations were recorded in " + monthLbl + ".";

    string descRaw = Model.BrokerCount > 0
        ? Model.BrokerCount.ToString("N0") + " new freight brokers registered with FMCSA in " + monthLbl + ". Top states, top cities, and daily registration trends."
        : "No new freight broker registrations were recorded with FMCSA in " + monthLbl + ". See motor carrier data for this month.";
    string nrmMetaDesc = descRaw.Length <= 160 ? descRaw : descRaw.Substring(0, 157) + "...";

    var nrmLd = new Newtonsoft.Json.Linq.JObject {
        ["@context"]    = "https://schema.org",
        ["@type"]       = "WebPage",
        ["name"]        = "New Freight Brokers " + mdash + " " + monthLbl,
        ["description"] = nrmMetaDesc,
        ["url"]         = nrmCanon,
        ["breadcrumb"]  = new Newtonsoft.Json.Linq.JObject {
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new Newtonsoft.Json.Linq.JArray {
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home",                    ["item"] = "https://truckcarrierhub.com" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Statistics",              ["item"] = "https://truckcarrierhub.com/statistics" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "New FMCSA Registrations", ["item"] = nrmParent },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 4, ["name"] = monthLbl,                  ["item"] = monthUrl },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 5, ["name"] = "Freight Brokers",         ["item"] = nrmCanon }
            }
        }
    };
}
@section AdditionalMeta {
<meta name="description" content="@nrmMetaDesc" />
<link rel="canonical" href="@nrmCanon" />
<script type="application/ld+json">@Html.Raw(nrmLd.ToString(Newtonsoft.Json.Formatting.None))</script>
}
<link rel="stylesheet" href="@Url.Content("~/Content/statistics-page.css")" />
<style>
    .nr-table { width:100%; border-collapse:collapse; font-size:.88em; }
    .nr-table th { background:#f3f4f6; color:#374151; font-weight:600; padding:9px 12px; text-align:left; border-bottom:2px solid #e5e7eb; white-space:nowrap; }
    .nr-table td { padding:8px 12px; border-bottom:1px solid #f3f4f6; color:#374151; vertical-align:middle; }
    .nr-table tr:last-child td { border-bottom:none; }
    .nr-table tr:hover td { background:#f9fafb; }
    .nr-rank  { font-weight:700; color:#9ca3af; width:28px; }
    .nr-count { font-weight:700; color:#111827; white-space:nowrap; }
    .nr-pct   { color:#6b7280; font-size:.82em; white-space:nowrap; }
    .nr-card  { background:#fff; border:1px solid #e5e7eb; border-radius:10px; box-shadow:0 1px 4px rgba(0,0,0,.06); overflow:hidden; }
    .nr-card-header { padding:14px 18px 12px; border-bottom:1px solid #e5e7eb; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:justify; -ms-flex-pack:justify; justify-content:space-between; gap:10px; }
    .nr-card-title  { font-size:1em; font-weight:700; color:#111827; margin:0; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:8px; }
    .nr-card-title .fa { color:#16a34a; }
    .nr-card-body { padding:0; }
    .nr-row { display:-webkit-box; display:-ms-flexbox; display:flex; gap:20px; margin-bottom:24px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .nr-col-50 { -webkit-box-flex:0; -ms-flex:0 0 calc(50% - 10px); flex:0 0 calc(50% - 10px); min-width:0; }
    @@media (max-width:860px) { .nr-col-50 { -webkit-box-flex:0; -ms-flex:0 0 100%; flex:0 0 100%; } }
    .stat-badge-up   { display:inline-block; background:#f0fdf4; color:#16a34a; font-size:.75em; font-weight:600; border-radius:4px; padding:1px 5px; }
    .stat-badge-down { display:inline-block; background:#fef2f2; color:#dc2626; font-size:.75em; font-weight:600; border-radius:4px; padding:1px 5px; }
    .nrm-chart-wrap { padding:16px 18px 14px; }
    .nrm-chart-svg  { width:100%; overflow:visible; display:block; }
    .nrm-link-card  { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:16px 20px; margin-bottom:14px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:14px; text-decoration:none; -webkit-transition:border-color .15s; transition:border-color .15s; }
    .nrm-link-card:hover { border-color:#bbf7d0; text-decoration:none; }
    .nrm-link-icon  { width:40px; height:40px; border-radius:8px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:center; -ms-flex-pack:center; justify-content:center; -ms-flex-negative:0; flex-shrink:0; font-size:1em; }
    .nrm-link-text strong { display:block; font-size:.88em; color:#111827; font-weight:600; }
    .nrm-link-text span   { display:block; font-size:.78em; color:#6b7280; }
    .nrm-link-arrow { margin-left:auto; color:#9ca3af; -ms-flex-negative:0; flex-shrink:0; }
    .nrm-nav { display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-pack:justify; -ms-flex-pack:justify; justify-content:space-between; -webkit-box-align:center; -ms-flex-align:center; align-items:center; background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:14px 20px; margin-bottom:24px; -ms-flex-wrap:wrap; flex-wrap:wrap; gap:10px; }
    .nrm-nav a { color:#16a34a; text-decoration:none; font-size:.88em; font-weight:600; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:6px; }
    .nrm-nav a:hover { text-decoration:underline; }
    .nrm-nav-spacer { -webkit-box-flex:1; -ms-flex:1; flex:1; }
    .nrm-footer-bar { border-top:1px solid #e5e7eb; padding-top:14px; margin-bottom:30px; }
    .nrm-footer-bar span { font-size:.8em; color:#9ca3af; }
    .sic-green { background:#f0fdf4; color:#16a34a; }
</style>

<div class="container stats-page">

    <!-- Breadcrumb -->
    <div class="stats-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="sep">/</span>
        <a href="@Url.Action("Statistics", "Home")">Statistics</a>
        <span class="sep">/</span>
        <a href="/statistics/new-registrations">New FMCSA Registrations</a>
        <span class="sep">/</span>
        <a href="@monthBase">@monthLbl</a>
        <span class="sep">/</span>
        Freight Brokers
    </div>

    <!-- Hero -->
    <div class="stats-hero">
        <div class="stats-hero-text">
            <h1 class="stats-hero-title">New Freight Brokers<br />@monthLbl</h1>
            <p style="font-size:1.05em;font-weight:600;color:#374151;margin:-6px 0 10px;">Monthly Broker Registration Report</p>
            <p class="stats-hero-desc">@heroIntro Data is updated weekly.</p>
            @if (Model.BothCount > 0)
            {
                <p style="font-size:.88em;color:#6b7280;margin:4px 0 0;">@Model.BothCount.ToString("N0") of these also hold motor carrier authority.</p>
            }
            @if (Model.LastDataUpdate.HasValue)
            {
                <div style="margin-top:10px;font-size:.82em;color:#6b7280;display:-webkit-box;display:-ms-flexbox;display:flex;gap:18px;-ms-flex-wrap:wrap;flex-wrap:wrap;">
                    <span><i class="fa fa-calendar-o" style="margin-right:5px;color:#9ca3af;"></i>Data updated: @Model.LastDataUpdate.Value.ToString("MMMM d, yyyy")</span>
                    <span><i class="fa fa-database" style="margin-right:5px;color:#9ca3af;"></i>Source: FMCSA registration data</span>
                </div>
            }
        </div>
        <div class="stats-hero-map">
            <img src="@Url.Content("~/Content/images/us_states_map_transparent_1200x750.png")" alt="United States map" class="stats-hero-map-img" onerror="this.style.display='none'" />
        </div>
    </div>

    <!-- Month Navigation (top) -->
    <div class="nrm-nav">
        @if (Model.HasPrev)
        {
            <a href="/statistics/new-registrations/@Model.PrevYear/@Model.PrevMonth.ToString("D2")/brokers"><i class="fa fa-chevron-left"></i> @prevMonthName</a>
        }
        else
        {
            <span style="color:#d1d5db;font-size:.88em;"><i class="fa fa-chevron-left"></i> No earlier data</span>
        }
        <span class="nrm-nav-spacer"></span>
        <span style="font-size:.85em;color:#6b7280;font-weight:500;">@monthLbl</span>
        <span class="nrm-nav-spacer"></span>
        @if (Model.HasNext)
        {
            <a href="/statistics/new-registrations/@Model.NextYear/@Model.NextMonth.ToString("D2")/brokers">@nextMonthName <i class="fa fa-chevron-right"></i></a>
        }
        else
        {
            <span style="color:#d1d5db;font-size:.88em;">Data not yet complete <i class="fa fa-chevron-right"></i></span>
        }
    </div>

    <!-- 3 Stat Cards -->
    <div class="stat-cards-wrap" style="margin-bottom:28px;">

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-green"><i class="fa fa-users"></i></div>
                <div class="stat-card-num">@Model.BrokerCount.ToString("N0")</div>
                <div class="stat-card-label">New Freight Brokers</div>
                <div class="stat-card-desc">
                    Registered with FMCSA in @monthLbl
                    @if (Model.BrokerCount > 0 && Model.PrevBrokerCount > 0)
                    {
                        string badgeCls = brkTrend >= 0 ? "stat-badge-up" : "stat-badge-down";
                        string badgeTxt = (brkTrend >= 0 ? "+" : "") + brkTrend.ToString("F0") + "% vs " + prevMonthName;
                        @Html.Raw(" <span class=\"" + badgeCls + "\">" + badgeTxt + "</span>")
                    }
                </div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-purple"><i class="fa fa-pie-chart"></i></div>
                <div class="stat-card-num">@shareOfTotal.ToString("F1")%</div>
                <div class="stat-card-label">Share of All New Registrations</div>
                <div class="stat-card-desc">Freight brokers as % of total new FMCSA registrations in @monthLbl</div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-green"><i class="fa fa-map-marker"></i></div>
                <div class="stat-card-num" style="font-size:@(topStateStr.Length > 9 ? "1.25em" : "1.8em");">@topStateStr</div>
                <div class="stat-card-label">Top State</div>
                <div class="stat-card-desc">State with the most new freight broker registrations in @monthLbl</div>
            </div>
        </div>

    </div>

    @if (Model.BrokerCount == 0)
    {
        <!-- Zero-state: no broker registrations this month -->
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:36px 24px;margin-bottom:28px;text-align:center;">
            <i class="fa fa-users" style="font-size:2.2em;color:#86efac;display:block;margin-bottom:14px;"></i>
            <div style="font-size:1.05em;font-weight:700;color:#166534;margin-bottom:10px;">No Freight Broker Registrations in @monthLbl</div>
            <div style="font-size:.9em;color:#15803d;max-width:480px;margin:0 auto;">No new freight broker registrations were recorded with FMCSA in @monthLbl. This can occur in early months of FMCSA data or periods with very low broker activity.</div>
            <div style="margin-top:20px;">
                <a href="@monthBase/carriers" style="display:inline-block;background:#2563eb;color:#fff;text-decoration:none;font-size:.88em;font-weight:600;padding:9px 20px;border-radius:6px;">View Motor Carriers for @monthLbl</a>
            </div>
        </div>
    }
    else
    {
        <!-- Broker Registrations by Day -->
        if (Model.DailyBrokers != null && Model.DailyBrokers.Count > 0)
        {
            int nW = 480; int nH = 160;
            int nPL = 38; int nPR = 8; int nPT = 10; int nPB = 28;
            int nIW = nW - nPL - nPR;
            int nIH = nH - nPT - nPB;
            int nN = Model.DailyBrokers.Count;
            int nMx = Model.DailyBrokers.Max(x => x.Count);
            if (nMx == 0) { nMx = 1; }
            double nSlot = (double)nIW / nN;
            double nGap  = nSlot > 10 ? 2 : 1;
            double nBW   = nSlot - nGap;
            if (nBW < 2) { nBW = 2; }
            string nMxLbl = nMx >= 1000 ? (nMx / 1000.0).ToString("F0") + "k" : nMx.ToString();
            var nBars  = new System.Text.StringBuilder();
            var nXAxis = new System.Text.StringBuilder();
            for (int di = 0; di < nN; di++)
            {
                var dr = Model.DailyBrokers[di];
                double bx = nPL + di * nSlot + nGap / 2.0;
                double bh = dr.Count == 0 ? 0 : Math.Max(1, (double)dr.Count / nMx * nIH);
                double by = nPT + nIH - bh;
                nBars.AppendFormat(CultureInfo.InvariantCulture,
                    "<rect x=\"{0:F1}\" y=\"{1:F1}\" width=\"{2:F1}\" height=\"{3:F1}\" fill=\"#16a34a\" opacity=\"0.85\" rx=\"1\"/>",
                    bx, by, nBW, bh);
                bool showL = (nN <= 15) || (dr.Day % 5 == 0) || dr.Day == 1 || dr.Day == nN;
                if (showL)
                {
                    nXAxis.AppendFormat(CultureInfo.InvariantCulture,
                        "<text x=\"{0:F1}\" y=\"{1}\" text-anchor=\"middle\" font-size=\"7\" fill=\"#9ca3af\">{2}</text>",
                        bx + nBW / 2.0, nH - 4, dr.Day);
                }
            }
            <div class="nr-card" style="margin-bottom:24px;">
                <div class="nr-card-header">
                    <div class="nr-card-title"><i class="fa fa-bar-chart"></i> Broker Registrations by Day <span style="font-weight:400;color:#6b7280;font-size:.88em;">(@monthLbl)</span></div>
                </div>
                <div class="nrm-chart-wrap">
                    <svg class="nrm-chart-svg" viewBox="0 0 @nW @nH">
                        <line x1="@nPL" y1="@nPT" x2="@nPL" y2="@(nPT + nIH)" stroke="#e5e7eb" stroke-width="1"/>
                        <line x1="@nPL" y1="@(nPT + nIH / 2)" x2="@(nPL + nIW)" y2="@(nPT + nIH / 2)" stroke="#f3f4f6" stroke-width="1" stroke-dasharray="3,3"/>
                        <line x1="@nPL" y1="@(nPT + nIH)" x2="@(nPL + nIW)" y2="@(nPT + nIH)" stroke="#e5e7eb" stroke-width="1"/>
                        <text x="@(nPL - 3)" y="@(nPT + 5)" text-anchor="end" font-size="7" fill="#9ca3af">@nMxLbl</text>
                        <text x="@(nPL - 3)" y="@(nPT + nIH / 2 + 5)" text-anchor="end" font-size="7" fill="#9ca3af">@((nMx / 2) >= 1000 ? ((nMx / 2) / 1000.0).ToString("F0") + "k" : (nMx / 2).ToString())</text>
                        <text x="@(nPL - 3)" y="@(nPT + nIH + 5)" text-anchor="end" font-size="7" fill="#9ca3af">0</text>
                        @Html.Raw(nBars.ToString())
                        @Html.Raw(nXAxis.ToString())
                    </svg>
                    <p style="font-size:.78em;color:#9ca3af;margin:6px 0 0;"><i class="fa fa-info-circle"></i> Companies with any B authority (EntityType contains B). Day-of-month based on FMCSA DateAdded field.</p>
                </div>
            </div>
        }
        <!-- Top States and Cities -->
        double nrmBrkMaxPct = (Model.BrokerTopStates != null && Model.BrokerTopStates.Any()) ? Model.BrokerTopStates.Max(x => x.PercentOfTotal) : 1.0;
        if (nrmBrkMaxPct == 0) { nrmBrkMaxPct = 1; }
        <div class="nr-row">
            <div class="nr-col-50">
                <div class="nr-card" style="height:100%;">
                    <div class="nr-card-header">
                        <div class="nr-card-title"><i class="fa fa-bar-chart"></i> Top 10 States</div>
                    </div>
                    <div class="nr-card-body">
                        @if (Model.BrokerTopStates != null && Model.BrokerTopStates.Any())
                        {
                            <table class="nr-table">
                                <thead>
                                    <tr>
                                        <th style="width:24px;">#</th>
                                        <th>State</th>
                                        <th>Brokers</th>
                                        <th>% of FB</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int si = 0; si < Model.BrokerTopStates.Count; si++)
                                    {
                                        var sRow = Model.BrokerTopStates[si];
                                        <tr>
                                            <td class="nr-rank">@(si + 1)</td>
                                            <td style="color:#374151;font-weight:500;"><a href="/statistics/state/@sRow.StateCode" style="color:#374151;text-decoration:none;">@sRow.StateName</a></td>
                                            <td class="nr-count"><a href="/@sRow.StateCode" style="color:#2563eb;text-decoration:none;">@sRow.Count.ToString("N0")</a></td>
                                            <td class="nr-pct">@sRow.PercentOfTotal.ToString("F1")%</td>
                                            <td style="width:70px;padding-left:4px;">
                                                <div style="background:#e5e7eb;border-radius:3px;height:5px;">
                                                    <div style="background:#16a34a;border-radius:3px;height:5px;width:@(Math.Min(100, sRow.PercentOfTotal / nrmBrkMaxPct * 100).ToString("F1", CultureInfo.InvariantCulture))%;"></div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p style="padding:20px;color:#6b7280;font-size:.88em;">No state data available.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="nr-col-50">
                <div class="nr-card" style="height:100%;">
                    <div class="nr-card-header">
                        <div class="nr-card-title"><i class="fa fa-map-marker"></i> Top 10 Cities</div>
                    </div>
                    <div class="nr-card-body">
                        @if (Model.BrokerTopCities != null && Model.BrokerTopCities.Any())
                        {
                            <table class="nr-table">
                                <thead>
                                    <tr>
                                        <th style="width:24px;">#</th>
                                        <th>City</th>
                                        <th>State</th>
                                        <th>Brokers</th>
                                        <th>% of FB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int ci = 0; ci < Model.BrokerTopCities.Count; ci++)
                                    {
                                        var cRow = Model.BrokerTopCities[ci];
                                        <tr>
                                            <td class="nr-rank">@(ci + 1)</td>
                                            <td>@ti.ToTitleCase((cRow.CityName ?? "").ToLower())</td>
                                            <td style="color:#6b7280;">@cRow.StateCode</td>
                                            <td class="nr-count"><a href="/@cRow.StateCode/@cRow.CityName.Replace(" ", "-")" style="color:#2563eb;text-decoration:none;">@cRow.Count.ToString("N0")</a></td>
                                            <td class="nr-pct">@cRow.PercentOfTotal.ToString("F2")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p style="padding:20px;color:#6b7280;font-size:.88em;">No city data available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Month navigation (broker pages) -->
    <div class="nrm-nav">
        @if (Model.HasPrev)
        {
            <a href="/statistics/new-registrations/@Model.PrevYear/@Model.PrevMonth.ToString("D2")/brokers"><i class="fa fa-chevron-left"></i> @prevMonthName</a>
        }
        else
        {
            <span style="color:#d1d5db;font-size:.88em;"><i class="fa fa-chevron-left"></i> No earlier data</span>
        }
        <span class="nrm-nav-spacer"></span>
        <span style="font-size:.85em;color:#6b7280;font-weight:500;">@monthLbl</span>
        <span class="nrm-nav-spacer"></span>
        @if (Model.HasNext)
        {
            <a href="/statistics/new-registrations/@Model.NextYear/@Model.NextMonth.ToString("D2")/brokers">@nextMonthName <i class="fa fa-chevron-right"></i></a>
        }
        else
        {
            <span style="color:#d1d5db;font-size:.88em;">Data not yet complete <i class="fa fa-chevron-right"></i></span>
        }
    </div>

    <!-- Cross-links -->
    <a href="@monthBase" class="nrm-link-card">
        <div class="nrm-link-icon" style="background:#f5f3ff;color:#7c3aed;"><i class="fa fa-calendar"></i></div>
        <div class="nrm-link-text">
            <strong>@monthLbl Overview</strong>
            <span>All new FMCSA registrations in @monthLbl @mdash motor carriers, freight brokers, and other entity types.</span>
        </div>
        <div class="nrm-link-arrow"><i class="fa fa-chevron-right"></i></div>
    </a>
    <a href="@monthBase/carriers" class="nrm-link-card">
        <div class="nrm-link-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa fa-truck"></i></div>
        <div class="nrm-link-text">
            <strong>New Motor Carriers in @monthLbl</strong>
            <span>@Model.MotorCarrierCount.ToString("N0") new motor carriers @mdash top states, top cities, and daily trends.</span>
        </div>
        <div class="nrm-link-arrow"><i class="fa fa-chevron-right"></i></div>
    </a>
