@using PartnerCarrier.ViewModels.Admin;
@model ResetPasswordVM
@{   ViewBag.Title = "Reset Password";
}
<div class="row">
    <div class="col-md-12">
        <h2>@ViewBag.Title</h2>
    </div>
</div>
<hr class="small" />
<div id="dvNotification"></div>

@using (Ajax.BeginForm("ResetAccountPassword", "Account", null, new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "vm.resetPasswordOnSuccess",
    OnFailure = "vm.resetPasswordOnFailure"
}, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()

    <div class="row form-group">
        <div class="col-sm-6 col-md-8">
            <div class="form-group">
                <div class="col-sm-2 col-md-3">
                   @Html.LabelFor(m => m.NewPassword, new { @class = "" })
                </div>
                <div class="col-md-6">
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", maxlength = "50" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-sm-6 col-md-8">
            <div class="form-group">
                <div class="col-sm-2 col-md-3">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "" })
                </div>
                <div class="col-md-6">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", maxlength = "50" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-sm-6 col-md-8">
            <div class="form-group">
                <div class="col-sm-2 col-md-3">
                </div>
                <div class="col-md-6">
                    <input type="submit" class="btn btn-primary" value="Reset Password" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts{
    <script src="~/Areas/Admin/Content/PageScript/Account/reset-Password.js"></script>
}