@model PartnerCarrier.ViewModels.Admin.StatisticsCargoVM
@using System.Globalization
@using System.Linq
@{
    Layout = "~/Themes/Bootstrap/Views/Shared/_Layout.cshtml";
    string mdash = System.Char.ConvertFromUtf32(0x2014);
    var pageTitle = ViewBag.Title ?? "Cargo Statistics " + mdash + " U.S. Trucking | Truck Carrier Hub";
    string cgCanonical = "https://truckcarrierhub.com/statistics/cargo";
    int cgTotal = Model != null ? Model.TotalActiveCompanies : 0;
    string cgTotalFmt = cgTotal.ToString("N0");
    string cgMetaFull = "U.S. trucking cargo statistics " + mdash + " what " + cgTotalFmt + " active companies haul: cargo types, specialization, and fleet size by cargo, from FMCSA data.";
    string cgMetaDesc = cgMetaFull.Length <= 160 ? cgMetaFull : cgMetaFull.Substring(0, 157) + "...";
    var cgLd = new Newtonsoft.Json.Linq.JObject {
        ["@context"]    = "https://schema.org",
        ["@type"]       = "WebPage",
        ["name"]        = "Cargo Statistics " + mdash + " U.S. Trucking",
        ["description"] = cgMetaDesc,
        ["url"]         = cgCanonical,
        ["breadcrumb"]  = new Newtonsoft.Json.Linq.JObject {
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new Newtonsoft.Json.Linq.JArray {
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home",               ["item"] = "https://truckcarrierhub.com" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Statistics",          ["item"] = "https://truckcarrierhub.com/statistics" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "Cargo Statistics",    ["item"] = cgCanonical }
            }
        }
    };

    var allCargo  = Model.AllCargoTypes ?? new System.Collections.Generic.List<PartnerCarrier.ViewModels.Admin.CgCargoTypeRow>();
    int top10Max  = allCargo.Count > 0 ? allCargo[0].CompanyCount : 1;
    if (top10Max < 1) { top10Max = 1; }

    // Section 2 stat card values
    var genFreight = allCargo.FirstOrDefault(x => x.Label == "General Freight");
    int cgGenFreightCount = genFreight != null ? genFreight.CompanyCount : 0;
    double cgGenFreightPct = cgTotal > 0 ? Math.Round(100.0 * cgGenFreightCount / cgTotal, 1) : 0;

    var topSpecialized = allCargo.FirstOrDefault(x => x.Label != "General Freight");
    string cgTopSpecLabel = topSpecialized != null ? topSpecialized.Label : "N/A";
    int cgTopSpecCount = topSpecialized != null ? topSpecialized.CompanyCount : 0;
    double cgTopSpecPct = cgTotal > 0 ? Math.Round(100.0 * cgTopSpecCount / cgTotal, 1) : 0;

    int cgWithAnyCargo = Model.CompaniesWithAnyCargo;
    int cgWithNoCargo  = Model.CompaniesWithNoCargo;
    double cgNoPct     = cgTotal > 0 ? Math.Round(100.0 * cgWithNoCargo / cgTotal, 1) : 0;
    double cgAvg       = Model.AvgCargoTypesPerCompany;

    // Donut: 4 spec buckets over cgWithAnyCargo base
    int[] dCounts = new int[4];
    string[] dColors = new string[] { "#14b8a6", "#3b82f6", "#8b5cf6", "#f97316" };
    string[] dLabels = new string[] { "1 Cargo Type", "2\u20133 Types", "4\u20136 Types", "7+ Types" };
    var specBuckets = Model.SpecBuckets;
    for (int si = 0; si < 4 && specBuckets != null && si < specBuckets.Count; si++)
    {
        dCounts[si] = specBuckets[si].Count;
    }
    int dTotal = cgWithAnyCargo > 0 ? cgWithAnyCargo : 1;

    double dCx = 90.0; double dCy = 90.0; double dR = 78.0; double dr = 54.0;
    string[] dPaths = new string[4];
    double dAngle = -90.0;
    for (int di = 0; di < 4; di++)
    {
        double sweep = (double)dCounts[di] / dTotal * 360.0;
        if (sweep < 0.01) { sweep = 0.01; }
        double sa = dAngle * Math.PI / 180.0;
        double ea = (dAngle + sweep) * Math.PI / 180.0;
        double ox1 = dCx + dR * Math.Cos(sa); double oy1 = dCy + dR * Math.Sin(sa);
        double ox2 = dCx + dR * Math.Cos(ea); double oy2 = dCy + dR * Math.Sin(ea);
        double ix2 = dCx + dr * Math.Cos(ea); double iy2 = dCy + dr * Math.Sin(ea);
        double ix1 = dCx + dr * Math.Cos(sa); double iy1 = dCy + dr * Math.Sin(sa);
        int la = sweep > 180.0 ? 1 : 0;
        dPaths[di] = string.Format(CultureInfo.InvariantCulture,
            "M {0:F2} {1:F2} A {6:F0} {6:F0} 0 {8} 1 {2:F2} {3:F2} L {4:F2} {5:F2} A {7:F0} {7:F0} 0 {8} 0 {9:F2} {10:F2} Z",
            ox1, oy1, ox2, oy2, ix2, iy2, dR, dr, la, ix1, iy1);
        dAngle += sweep;
    }

    // Section 5: top 10 by company count (already sorted desc in service)
    int cgTop10Max = allCargo.Count > 0 ? allCargo[0].CompanyCount : 1;
    if (cgTop10Max < 1) { cgTop10Max = 1; }
}
@section AdditionalMeta {
<meta name="description" content="@cgMetaDesc" />
<link rel="canonical" href="@cgCanonical" />
<script type="application/ld+json">@Html.Raw(cgLd.ToString(Newtonsoft.Json.Formatting.None))</script>
}
<link rel="stylesheet" href="@Url.Content("~/Content/statistics-page.css")" />
<style>
    /* ── cards ── */
    .cg-card { background:#fff; border:1px solid #e5e7eb; border-radius:10px; box-shadow:0 1px 4px rgba(0,0,0,.06); overflow:hidden; }
    .cg-card-header { padding:14px 18px 12px; border-bottom:1px solid #e5e7eb; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:justify; -ms-flex-pack:justify; justify-content:space-between; gap:10px; }
    .cg-card-title { font-size:1em; font-weight:700; color:#111827; margin:0; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:8px; }
    .cg-card-title .fa { color:#ea580c; }
    .cg-card-note { font-size:.78em; color:#9ca3af; }

    /* ── two-col layout ── */
    .cg-row { display:-webkit-box; display:-ms-flexbox; display:flex; gap:20px; margin-bottom:24px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .cg-col-55 { -webkit-box-flex:0; -ms-flex:0 0 calc(55% - 10px); flex:0 0 calc(55% - 10px); min-width:0; }
    .cg-col-45 { -webkit-box-flex:0; -ms-flex:0 0 calc(45% - 10px); flex:0 0 calc(45% - 10px); min-width:0; }
    @@media (max-width:860px) {
        .cg-col-55, .cg-col-45 { -webkit-box-flex:0; -ms-flex:0 0 100%; flex:0 0 100%; }
    }

    /* ── horizontal bar chart ── */
    .cg-bars-wrap { padding:18px; }
    .cg-bar-row { display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:10px; margin-bottom:10px; }
    .cg-bar-row:last-child { margin-bottom:0; }
    .cg-bar-lbl { -webkit-box-flex:0; -ms-flex:0 0 200px; flex:0 0 200px; font-size:.82em; color:#374151; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .cg-bar-col { -webkit-box-flex:1; -ms-flex:1; flex:1; }
    .cg-bar-bg   { background:#e5e7eb; border-radius:4px; height:14px; }
    .cg-bar-fill { background:#f97316; border-radius:4px; height:14px; }
    .cg-bar-stats { -webkit-box-flex:0; -ms-flex:0 0 160px; flex:0 0 160px; text-align:right; font-size:.82em; }
    .cg-bar-count { font-weight:700; color:#111827; }
    .cg-bar-pct   { color:#6b7280; font-size:.85em; margin-left:4px; }
    @@media (max-width:700px) {
        .cg-bar-lbl   { -webkit-box-flex:0; -ms-flex:0 0 110px; flex:0 0 110px; }
        .cg-bar-stats { -webkit-box-flex:0; -ms-flex:0 0 90px; flex:0 0 90px; }
    }

    /* ── expander ── */
    .cg-expander { border-top:1px solid #f3f4f6; }
    .cg-expand-btn { display:block; width:100%; background:none; border:none; padding:10px 18px; font-size:.85em; color:#ea580c; font-weight:600; cursor:pointer; text-align:left; }
    .cg-expand-btn:hover { background:#fff7ed; }
    .cg-expand-btn .fa { margin-right:5px; }
    #cgFullTable { display:none; }
    .cg-full-table { width:100%; border-collapse:collapse; font-size:.85em; }
    .cg-full-table th { background:#f3f4f6; color:#374151; font-weight:600; padding:8px 12px; text-align:left; border-bottom:2px solid #e5e7eb; white-space:nowrap; }
    .cg-full-table td { padding:7px 12px; border-bottom:1px solid #f3f4f6; color:#374151; vertical-align:middle; }
    .cg-full-table tr:last-child td { border-bottom:none; }
    .cg-full-table tr:hover td { background:#f9fafb; }
    .cg-ft-rank  { font-weight:700; color:#9ca3af; width:28px; }
    .cg-ft-count { font-weight:700; color:#111827; white-space:nowrap; }
    .cg-ft-pct   { color:#6b7280; font-size:.82em; }
    .cg-ft-bar-wrap { width:70px; display:inline-block; vertical-align:middle; }
    .cg-ft-bar-bg   { background:#e5e7eb; border-radius:3px; height:5px; }
    .cg-ft-bar-fill { background:#ea580c; border-radius:3px; height:5px; }

    /* ── donut ── */
    .cg-donut-wrap { padding:18px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:22px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .cg-donut-svg-wrap { position:relative; -ms-flex-negative:0; flex-shrink:0; }
    .cg-donut-center { position:absolute; top:50%; left:50%; -webkit-transform:translate(-50%,-50%); transform:translate(-50%,-50%); text-align:center; pointer-events:none; width:90px; }
    .cg-donut-center-num { font-size:1.05em; font-weight:800; color:#111827; line-height:1.1; }
    .cg-donut-center-lbl { font-size:.65em; color:#6b7280; line-height:1.3; }
    .cg-legend { -webkit-box-flex:1; -ms-flex:1 1 140px; flex:1 1 140px; min-width:0; }
    .cg-legend-row { display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:8px; margin-bottom:8px; font-size:.82em; }
    .cg-legend-dot  { width:10px; height:10px; border-radius:50%; -ms-flex-negative:0; flex-shrink:0; }
    .cg-legend-name { color:#374151; -webkit-box-flex:1; -ms-flex:1; flex:1; }
    .cg-legend-val  { color:#111827; font-weight:600; white-space:nowrap; }
    .cg-legend-pct  { color:#9ca3af; font-size:.82em; margin-left:2px; }
    .cg-donut-note  { font-size:.76em; color:#9ca3af; margin-top:10px; }

    /* ── avg fleet table ── */
    .cg-avg-table { width:100%; border-collapse:collapse; font-size:.88em; }
    .cg-avg-table th { background:#f3f4f6; color:#374151; font-weight:600; padding:9px 12px; text-align:left; border-bottom:2px solid #e5e7eb; white-space:nowrap; }
    .cg-avg-table td { padding:8px 12px; border-bottom:1px solid #f3f4f6; color:#374151; vertical-align:middle; }
    .cg-avg-table tr:last-child td { border-bottom:none; }
    .cg-avg-table tr:hover td { background:#f9fafb; }
    .cg-avg-rank  { font-weight:700; color:#9ca3af; width:28px; }
    .cg-avg-count { font-weight:600; color:#374151; white-space:nowrap; }
    .cg-avg-val   { font-weight:700; color:#111827; white-space:nowrap; }

    /* ── related statistics ── */
    .cg-related { margin-bottom:28px; }
    .cg-related-title { font-size:.88em; font-weight:700; color:#6b7280; text-transform:uppercase; letter-spacing:.06em; margin-bottom:14px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:8px; }
    .cg-related-grid { display:-webkit-box; display:-ms-flexbox; display:flex; gap:14px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .cg-related-item { -webkit-box-flex:1; -ms-flex:1 1 160px; flex:1 1 160px; background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:14px 16px; text-decoration:none; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:12px; -webkit-transition:border-color .15s; transition:border-color .15s; }
    .cg-related-item:hover { border-color:#fed7aa; text-decoration:none; }
    .cg-related-icon { width:36px; height:36px; border-radius:8px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:center; -ms-flex-pack:center; justify-content:center; font-size:.95em; -ms-flex-negative:0; flex-shrink:0; }
    .cg-related-text strong { display:block; font-size:.82em; color:#111827; font-weight:600; }
    .cg-related-text span   { display:block; font-size:.75em; color:#6b7280; }
    .cg-related-arrow { margin-left:auto; color:#9ca3af; font-size:.85em; -ms-flex-negative:0; flex-shrink:0; }

    /* ── source + footer ── */
    .cg-source-bar { background:#fff7ed; border:1px solid #fed7aa; border-radius:10px; padding:16px 22px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:16px; -ms-flex-wrap:wrap; flex-wrap:wrap; margin-bottom:20px; }
    .cg-source-icon { width:46px; height:46px; background:#ffedd5; border-radius:50%; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:center; -ms-flex-pack:center; justify-content:center; color:#ea580c; font-size:1.2em; -ms-flex-negative:0; flex-shrink:0; }
    .cg-source-text strong { font-size:.92em; color:#9a3412; display:block; }
    .cg-source-text span   { font-size:.80em; color:#374151; }
    .cg-footer-bar { display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-pack:justify; -ms-flex-pack:justify; justify-content:space-between; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:16px; border-top:1px solid #e5e7eb; padding-top:14px; margin-bottom:30px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .cg-footer-bar span { font-size:.8em; color:#9ca3af; }
</style>

<div class="container stats-page">

    <!-- Section 1: Breadcrumb + Hero -->
    <div class="stats-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="sep">/</span>
        <a href="@Url.Action("Statistics", "Home")">Statistics</a>
        <span class="sep">/</span>
        Cargo Statistics
    </div>

    <div class="stats-hero">
        <div class="stats-hero-text">
            <h1 class="stats-hero-title">Cargo Statistics</h1>
            <p style="font-size:1.05em;font-weight:600;color:#374151;margin:-6px 0 10px;">U.S. Trucking Statistics Overview</p>
            <p class="stats-hero-desc">
                Explore what U.S. trucking companies haul &mdash; cargo categories, specialization, and how fleet size varies by cargo type.
                Data sourced from FMCSA SAFER records for active U.S. motor carriers.
            </p>
            @if (Model.LastDataUpdate.HasValue)
            {
                <div style="margin-top:10px;font-size:.82em;color:#6b7280;display:-webkit-box;display:-ms-flexbox;display:flex;gap:18px;-ms-flex-wrap:wrap;flex-wrap:wrap;">
                    <span><i class="fa fa-calendar-o" style="margin-right:5px;color:#9ca3af;"></i>Data updated: @Model.LastDataUpdate.Value.ToString("MMMM d, yyyy")</span>
                    <span><i class="fa fa-refresh" style="margin-right:5px;color:#9ca3af;"></i>Updated weekly</span>
                </div>
            }
        </div>
        <div class="stats-hero-map">
            <img src="@Url.Content("~/Content/images/truck.png")" alt="Cargo statistics" class="stats-hero-map-img" />
        </div>
    </div>

    <!-- Section 2: KPI Cards -->
    <div class="stat-cards-wrap" style="margin-bottom:28px;">

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-orange"><i class="fa fa-truck"></i></div>
                <div class="stat-card-num">@cgGenFreightCount.ToString("N0")</div>
                <div class="stat-card-label">General Freight Carriers</div>
                <div class="stat-card-desc">@cgGenFreightPct.ToString("F1", CultureInfo.InvariantCulture)% of all active companies</div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-orange"><i class="fa fa-star"></i></div>
                <div class="stat-card-num-sm">@cgTopSpecLabel</div>
                <div class="stat-card-label">Top Specialized Cargo</div>
                <div class="stat-card-desc">@cgTopSpecCount.ToString("N0") companies (@cgTopSpecPct.ToString("F1", CultureInfo.InvariantCulture)% of all active)</div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-orange"><i class="fa fa-calculator"></i></div>
                <div class="stat-card-num">@cgAvg.ToString("F1", CultureInfo.InvariantCulture)</div>
                <div class="stat-card-label">Avg Cargo Types</div>
                <div class="stat-card-desc">Among companies reporting cargo types</div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-orange"><i class="fa fa-calendar-check-o"></i></div>
                <div class="stat-card-num-sm">
                    @if (Model.LastDataUpdate.HasValue)
                    {
                        @Model.LastDataUpdate.Value.ToString("MMM d, yyyy")
                    }
                    else
                    {
                        <text>N/A</text>
                    }
                </div>
                <div class="stat-card-label">Data As Of</div>
                <div class="stat-card-desc">Updated weekly from FMCSA SAFER</div>
            </div>
        </div>

    </div>

    <!-- Section 3: Cargo Types by Company Count -->
    <div class="cg-card" style="margin-bottom:24px;">
        <div class="cg-card-header">
            <h2 class="cg-card-title"><i class="fa fa-cubes"></i> Cargo Types by Company Count</h2>
            <span class="cg-card-note">% = of all active companies</span>
        </div>
        <div class="cg-bars-wrap">
            @{
                int cgBarRank = 0;
                foreach (var ct in allCargo.Take(10))
                {
                    cgBarRank++;
                    int barW = cgTop10Max > 0 ? (int)Math.Round(100.0 * ct.CompanyCount / cgTop10Max) : 0;
                    double ctPct = cgTotal > 0 ? Math.Round(100.0 * ct.CompanyCount / cgTotal, 1) : 0;
                    <div class="cg-bar-row">
                        <div class="cg-bar-lbl">@ct.Label</div>
                        <div class="cg-bar-col">
                            <div class="cg-bar-bg"><div class="cg-bar-fill" style="width:@(barW)%"></div></div>
                        </div>
                        <div class="cg-bar-stats">
                            <span class="cg-bar-count">@ct.CompanyCount.ToString("N0")</span>
                            <span class="cg-bar-pct">(@ctPct.ToString("F1", CultureInfo.InvariantCulture)%)</span>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="cg-expander">
            <button class="cg-expand-btn" onclick="(function(b,t){var open=t.style.display==='block';t.style.display=open?'none':'block';b.innerHTML=open?'<i class=\'fa fa-chevron-down\'></i> View all cargo types':'<i class=\'fa fa-chevron-up\'></i> Hide full table';})(this,document.getElementById('cgFullTable'))">
                <i class="fa fa-chevron-down"></i> View all cargo types
            </button>
            <div id="cgFullTable">
                <table class="cg-full-table">
                    <thead>
                        <tr>
                            <th class="cg-ft-rank">#</th>
                            <th>Cargo Type</th>
                            <th style="text-align:right;">Companies</th>
                            <th style="text-align:right;">% of Active</th>
                            <th style="text-align:right;width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int cgFtRank = 0;
                            foreach (var ct in allCargo)
                            {
                                cgFtRank++;
                                int ftBarW = cgTop10Max > 0 ? (int)Math.Round(100.0 * ct.CompanyCount / cgTop10Max) : 0;
                                double ftPct = cgTotal > 0 ? Math.Round(100.0 * ct.CompanyCount / cgTotal, 1) : 0;
                                <tr>
                                    <td class="cg-ft-rank">@cgFtRank</td>
                                    <td>@ct.Label</td>
                                    <td style="text-align:right;" class="cg-ft-count">@ct.CompanyCount.ToString("N0")</td>
                                    <td style="text-align:right;" class="cg-ft-pct">@ftPct.ToString("F1", CultureInfo.InvariantCulture)%</td>
                                    <td style="text-align:right;">
                                        <div class="cg-ft-bar-wrap">
                                            <div class="cg-ft-bar-bg"><div class="cg-ft-bar-fill" style="width:@(ftBarW)%"></div></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <p style="font-size:.78em;color:#9ca3af;padding:8px 12px 12px;margin:0;">Companies may select multiple cargo types, so percentages sum to more than 100%.</p>
            </div>
        </div>
        <p style="font-size:.78em;color:#9ca3af;padding:8px 18px 12px;margin:0;">Companies may select multiple cargo types, so percentages sum to more than 100%.</p>
    </div>

    <!-- Section 4: Cargo Specialization Donut + Section 5: Avg Fleet Size -->
    <div class="cg-row">

        <div class="cg-col-45">
            <div class="cg-card" style="height:100%;">
                <div class="cg-card-header">
                    <h2 class="cg-card-title"><i class="fa fa-pie-chart"></i> Cargo Specialization</h2>
                </div>
                <div class="cg-donut-wrap">
                    <div class="cg-donut-svg-wrap">
                        <svg width="180" height="180" viewBox="0 0 180 180">
                            @for (int di = 0; di < 4; di++)
                            {
                                <path d="@dPaths[di]" fill="@dColors[di]" />
                            }
                        </svg>
                        <div class="cg-donut-center">
                            <div class="cg-donut-center-num">@cgWithAnyCargo.ToString("N0")</div>
                            <div class="cg-donut-center-lbl">with any<br/>cargo type</div>
                        </div>
                    </div>
                    <div class="cg-legend">
                        @for (int li = 0; li < 4; li++)
                        {
                            double liPct = cgWithAnyCargo > 0 ? Math.Round(100.0 * dCounts[li] / cgWithAnyCargo, 1) : 0;
                            <div class="cg-legend-row">
                                <div class="cg-legend-dot" style="background:@dColors[li];"></div>
                                <div class="cg-legend-name">@dLabels[li]</div>
                                <div class="cg-legend-val">@dCounts[li].ToString("N0")<span class="cg-legend-pct">(@liPct.ToString("F1", CultureInfo.InvariantCulture)%)</span></div>
                            </div>
                        }
                        <p class="cg-donut-note">@cgWithNoCargo.ToString("N0") companies (@cgNoPct.ToString("F1", CultureInfo.InvariantCulture)% of all active) report no cargo types and are excluded from this chart.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="cg-col-55">
            <div class="cg-card" style="height:100%;">
                <div class="cg-card-header">
                    <h2 class="cg-card-title"><i class="fa fa-bar-chart"></i> Avg Fleet Size by Cargo Type</h2>
                    <span class="cg-card-note">Top 10 by company count</span>
                </div>
                <table class="cg-avg-table">
                    <thead>
                        <tr>
                            <th class="cg-avg-rank">#</th>
                            <th>Cargo Type</th>
                            <th style="text-align:right;">Companies</th>
                            <th style="text-align:right;">Avg Fleet Size</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int cgAvgRank = 0;
                            foreach (var ct in allCargo.Take(10))
                            {
                                cgAvgRank++;
                                <tr>
                                    <td class="cg-avg-rank">@cgAvgRank</td>
                                    <td>@ct.Label</td>
                                    <td style="text-align:right;" class="cg-avg-count">@ct.CompanyCount.ToString("N0")</td>
                                    <td style="text-align:right;" class="cg-avg-val">
                                        @if (ct.ReportingWithPU > 0)
                                        {
                                            @ct.AvgFleetSize.ToString("F2", CultureInfo.InvariantCulture)
                                        }
                                        else
                                        {
                                            <text>&mdash;</text>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <p style="font-size:.78em;color:#9ca3af;padding:8px 12px 12px;margin:0;">Average power units per company within each cargo group reporting fleet size (1&ndash;50,000 units). Outliers above 50,000 excluded.</p>
            </div>
        </div>

    </div>

    <!-- Section 6: Related Statistics -->
    <div class="cg-related">
        <div class="cg-related-title"><i class="fa fa-link"></i> Related Statistics</div>
        <div class="cg-related-grid">
            <a href="@Url.Action("Statistics", "Home")" class="cg-related-item">
                <div class="cg-related-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa fa-home"></i></div>
                <div class="cg-related-text"><strong>Statistics Overview</strong><span>All statistics sections</span></div>
                <div class="cg-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
            <a href="@Url.Action("ActiveCompanies", "Home")" class="cg-related-item">
                <div class="cg-related-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa fa-building"></i></div>
                <div class="cg-related-text"><strong>Active Trucking Companies</strong><span>Company counts by state &amp; city</span></div>
                <div class="cg-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
            <a href="/statistics/active-brokers" class="cg-related-item">
                <div class="cg-related-icon" style="background:#f0fdf4;color:#16a34a;"><i class="fa fa-handshake-o"></i></div>
                <div class="cg-related-text"><strong>Active Freight Brokers</strong><span>Broker statistics &amp; trends</span></div>
                <div class="cg-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
            <a href="/statistics/new-registrations" class="cg-related-item">
                <div class="cg-related-icon" style="background:#f5f3ff;color:#7c3aed;"><i class="fa fa-line-chart"></i></div>
                <div class="cg-related-text"><strong>New FMCSA Registrations</strong><span>Registration trends &amp; data</span></div>
                <div class="cg-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
            <a href="/statistics/fleet-operations" class="cg-related-item">
                <div class="cg-related-icon" style="background:#f0fdfa;color:#0d9488;"><i class="fa fa-truck"></i></div>
                <div class="cg-related-text"><strong>Fleet &amp; Operations</strong><span>Fleet sizes, power units &amp; more</span></div>
                <div class="cg-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
        </div>
    </div>

    <!-- Section 7: Source + Footer -->
    <div class="cg-source-bar">
        <div class="cg-source-icon"><i class="fa fa-database"></i></div>
        <div class="cg-source-text">
            <strong>Data Source: FMCSA SAFER System</strong>
            <span>All data is based on active FMCSA (USDOT) records@(Model.LastDataUpdate.HasValue ? " as of " + Model.LastDataUpdate.Value.ToString("MMMM d, yyyy") : "") and is updated weekly. Active U.S. motor carriers (Status='A', U.S. state codes).</span>
        </div>
    </div>

    <div class="cg-footer-bar">
        <span>Truck Carrier Hub &mdash; Cargo Statistics</span>
        @if (Model.LastDataUpdate.HasValue)
        {
            <span>Data as of @Model.LastDataUpdate.Value.ToString("MMMM d, yyyy")</span>
        }
    </div>

</div>
