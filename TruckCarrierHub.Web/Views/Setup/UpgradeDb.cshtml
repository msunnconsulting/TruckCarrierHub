@{
    ViewBag.Title = "Upgrade Db";
    Layout = "~/Views/Shared/_SetupLayout.cshtml";
}

<h2>@ViewBag.Title</h2>
<hr />

@using (Html.BeginForm("SubmitUpgradeDb", "Setup", FormMethod.Post))
{
    <div class="row">
        <div class="col-lg-12">
            <button class="btn btn-primary" type="submit">Upgrade</button>
            @ViewBag.SuccessMessage
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            @Html.Raw((Html.ValidationSummary(false, "", new { @class = "exception" })).ToHtmlString())
        </div>
    </div>
}

