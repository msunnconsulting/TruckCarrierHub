@using PartnerCarrier.ViewModels.User
@using PartnerCarrier.ViewModels.Admin;
@using PartnerCarrier.Web.App_Start;
@using PartnerCarrier.Infrastructure.Contracts.Admin.AdminManagement;
@using PartnerCarrier.Web.SessionManager;
@using System.Text.RegularExpressions;

@model CityVM
@{
    ViewBag.Title = Model.PageTitle;
    var _businessManagements = StructuremapMvc.StructureMapDependencyScope.CurrentNestedContainer.GetInstance<IBusinessMangementService>();
    var globalHiring = _businessManagements.GetGlobalHiring();
    var reviewsFilter = _businessManagements.GetReviewsFilter();
    var IsShowOnStatePage = _businessManagements.GetCheckboxListForShowGetAQuoteControl()
        .Where(a => a.Name.Contains("Show on State/Province page"))
        .Select(a => a.ControlToShow)
        .FirstOrDefault();

    if (globalHiring.GlobalHire == (int)GLobalHiring.HomeStateAndCityPage || globalHiring.GlobalHire == (int)GLobalHiring.StateAndCityPage)
    {
        ViewBag.IsShowGlobalHiringCheckbox = true;
    }
    if (reviewsFilter.SelectedFilterValue == (int)ManageReviewEnum.HomeStateAndCityPage || reviewsFilter.SelectedFilterValue == (int)ManageReviewEnum.StateAndCityPage)
    {
        ViewBag.IsShowReviewsCheckbox = true;
    }

    ViewBag.IsHiringCheckboxIsChecked = SessionManager.Instance.IsHiringCheckboxIsChecked;
    ViewBag.IsReviewsFilterCheckboxIsChecked = SessionManager.Instance.IsReviewsFilterCheckboxIsChecked;
    ViewBag.CanonicalUrl = Request.Url.GetLeftPart(UriPartial.Path);

    // Stats derived from the full cities list (active-only via GetCityList)
    int totalCities = Model.Cities != null ? Model.Cities.Count : 0;
    int totalCompanies = Model.Cities != null ? Model.Cities.Sum(c => c.CompanyCount) : 0;

    // Meta description \u2014 dynamic format, hard-capped at 160 chars
    string xStr = totalCompanies.ToString("N0");
    string yStr = totalCities.ToString();
    string stateName = Model.StateName ?? "";
    string metaFull  = "Find " + stateName + " trucking companies and freight brokers \u2014 " + xStr + " active companies across " + yStr + " cities, searchable by name, city, USDOT, cargo type, and more.";
    string metaShort = "Find " + stateName + " trucking companies and freight brokers \u2014 " + xStr + " active companies across " + yStr + " cities.";
    string metaDescription = metaFull.Length <= 160 ? metaFull : (metaShort.Length <= 160 ? metaShort : metaShort.Substring(0, 157) + "...");

    // State article: strip HTML for display
    var stateArticleRaw = Regex.Replace(Model.PageDescription ?? "", "<.*?>", " ");
    stateArticleRaw = System.Net.WebUtility.HtmlDecode(
        Regex.Replace(stateArticleRaw, @"\s+", " ").Trim()
    );
    var stateArticleWords = stateArticleRaw.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    const int stateWordLimit = 100;
    string stateArticleTruncated = stateArticleWords.Length > stateWordLimit
        ? string.Join(" ", stateArticleWords, 0, stateWordLimit) + "..."
        : null;

    // JSON-LD: ItemList for state directory
    string stateCode = Request.Url.AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
    var stateLd = new Newtonsoft.Json.Linq.JObject {
        ["@context"]      = "https://schema.org",
        ["@type"]         = "ItemList",
        ["name"]          = "Trucking Companies in " + stateName,
        ["description"]   = "Directory of " + xStr + " trucking companies and freight brokers across " + yStr + " cities in " + stateName,
        ["url"]           = "https://truckcarrierhub.com/" + stateCode,
        ["numberOfItems"] = totalCompanies
    };
}

@section AdditionalMeta {
    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@ViewBag.CanonicalUrl" />
    <script type="application/ld+json">@Html.Raw(stateLd.ToString(Newtonsoft.Json.Formatting.None))</script>
}

<style>
    .homepage-font-color { color: black !important; }

    /* ---- Header ---- */
    .state-header { margin: 20px 0 16px; }
    .state-title {
        font-size: 24px;
        font-family: var(--font-display);
        color: var(--ink-900);
        margin: 0 0 12px;
        line-height: 1.2;
    }
    .state-stats { display: flex; gap: 28px; flex-wrap: wrap; }
    .state-stat { display: flex; flex-direction: column; }
    .state-stat-value {
        font-family: var(--font-data);
        font-size: 22px;
        font-weight: 600;
        color: var(--ink-900);
        line-height: 1;
    }
    .state-stat-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--steel-500);
        margin-top: 4px;
    }

    /* ---- Article ---- */
    .state-article {
        background: var(--white);
        border: 1px solid var(--steel-200);
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 16px;
        font-size: 14px;
        line-height: 1.7;
        color: var(--ink-900);
    }
    .state-article-text { margin: 0 0 10px; overflow: hidden; max-height: 240px; }
    .state-article-text.expanded { max-height: none; }
    .state-article-toggle { font-size: 12px; padding: 3px 10px; }

    /* ---- Section titles ---- */
    .state-section { margin-bottom: 28px; }
    .state-section-title {
        font-size: 18px;
        font-family: var(--font-display);
        color: var(--ink-900);
        margin: 0 0 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--steel-200);
    }

    /* ---- Popular cities grid ---- */
    .state-popular-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }
    @@media (max-width: 768px) { .state-popular-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 480px) { .state-popular-grid { grid-template-columns: 1fr; } }
    .state-popular-card {
        display: flex;
        flex-direction: column;
        background: var(--white);
        border: 1px solid var(--steel-200);
        border-radius: 8px;
        padding: 12px 14px;
        text-decoration: none;
        transition: border-color 0.15s;
    }
    .state-popular-card:hover { border-color: var(--signal-500); text-decoration: none; }
    .state-popular-name { font-size: 14px; font-weight: 500; color: var(--signal-500); }
    .state-popular-count {
        font-size: 12px;
        color: var(--steel-500);
        margin-top: 4px;
        font-family: var(--font-data);
    }

    /* ---- A-Z jump nav ---- */
    .alpha-nav { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
    .alpha-pill {
        font-size: 13px;
        color: var(--ink-900);
        background: var(--paper-50);
        border: 1px solid var(--steel-200);
        border-radius: 6px;
        padding: 5px 10px;
        text-decoration: none;
        white-space: nowrap;
        line-height: 1.4;
    }
    .alpha-pill:hover { background: var(--steel-200); color: var(--ink-900); text-decoration: none; }

    /* ---- A-Z directory ---- */
    .state-alpha-section { margin-bottom: 20px; }
    .state-alpha-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 2px solid var(--steel-200);
    }
    .state-alpha-letter {
        font-size: 22px;
        font-weight: 700;
        font-family: var(--font-display);
        color: var(--ink-900);
        line-height: 1;
    }
    .state-alpha-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--steel-500);
    }
    .state-alpha-up { margin-left: auto; color: var(--steel-500); cursor: pointer; }
    .state-alpha-up:hover { color: var(--ink-900); }
    .state-city-link {
        display: block;
        font-size: 13px;
        color: var(--signal-500);
        padding: 3px 0;
        margin-bottom: 4px;
        text-decoration: none;
    }
    .state-city-link:hover { color: var(--signal-600); text-decoration: underline; }

    /* ---- State data module (cm-* classes mirror city module) ---- */
    .cm-wrap { margin-bottom: 16px; }
    .cm-cards-grid .hpb-icon { width: 38px; height: 38px; margin-bottom: 10px; }
    .cm-cards-grid .hpb-icon .fa { font-size: 17px; }
    .cm-cards-grid .hpb-num { font-size: 1.45em; }
    .cm-cards-grid .hpb-label { font-size: 0.83em; }
    .cm-section { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 18px; margin-bottom: 12px; }
    .cm-section-title { font-size: 0.78em; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; }
    .cm-hl-list { list-style: none; padding: 0; margin: 0; }
    .cm-hl-item { position: relative; padding: 6px 0 6px 22px; font-size: 0.9em; color: #374151; border-bottom: 1px solid #f3f4f6; line-height: 1.5; }
    .cm-hl-item:last-child { border-bottom: none; }
    .cm-hl-item::before { content: "\2192"; position: absolute; left: 0; color: #3b82f6; font-weight: 700; }
    .cm-footer { display: -webkit-box; display: -ms-flexbox; display: flex; gap: 14px; -ms-flex-wrap: wrap; flex-wrap: wrap; font-size: 0.83em; margin-bottom: 4px; }
    .cm-footer a { color: #2563eb; text-decoration: none; }
    .cm-footer a:hover { text-decoration: underline; }
    .sm-badge { display: inline-block; font-size: 0.75em; font-weight: 700; padding: 1px 6px; border-radius: 10px; margin-left: 6px; vertical-align: middle; }
    .sm-badge-up { background: #dcfce7; color: #166534; }
    .sm-badge-dn { background: #fee2e2; color: #991b1b; }
    @@media (max-width: 640px) {
        .cm-cards-grid .hpb-card { -webkit-box-flex: 1; -ms-flex: 1 1 calc(50% - 6px); flex: 1 1 calc(50% - 6px); }
    }
</style>

<input type="hidden" id="fromStatePage" value="true">

<div class="container">

    @* Breadcrumb *@
    <ul class="breadcrumb">
        <li><a href="@Url.Action("Index", "home")">Home</a></li>
        <li class="active">@Model.StateName</li>
    </ul>

    @* Header *@
    <div class="state-header">
        <h1 class="state-title">Trucking Companies in @Model.StateName</h1>
        <div class="state-stats">
            <div class="state-stat">
                <span class="state-stat-value">@totalCities.ToString("N0")</span>
                <span class="state-stat-label">Cities</span>
            </div>
            <div class="state-stat">
                <span class="state-stat-value">@totalCompanies.ToString("N0")</span>
                <span class="state-stat-label">Active Companies</span>
            </div>
        </div>
    </div>

    @* Trucking in {StateName} data module *@
    @{
        var stateModule     = ViewBag.StateModule     as PartnerCarrier.ViewModels.Admin.StatisticsStateCompaniesVM;
        var stateHighlights = ViewBag.StateModuleHighlights as List<string>;
    }
    @if (stateModule != null)
    {
        var smStateUrl = "/statistics/state/" + stateModule.StateCode;
        bool smShowHl  = stateHighlights != null && stateHighlights.Count > 0;

        int smReporting = stateModule.SizeDistribution != null ? stateModule.SizeDistribution.TotalReporting : 0;
        decimal smOOPct = smReporting > 0 && stateModule.SizeDistribution != null
            ? Math.Round((decimal)stateModule.SizeDistribution.OneUnit / smReporting * 100m, 1)
            : 0m;

        decimal smGrowthPct = 0m;
        bool smHasGrowth = stateModule.NewPriorRegistrations12 > 0;
        if (smHasGrowth)
        {
            smGrowthPct = Math.Round(
                (decimal)(stateModule.NewRegistrations12 - stateModule.NewPriorRegistrations12)
                / stateModule.NewPriorRegistrations12 * 100m, 1);
        }

        <div class="cm-wrap">
            <div class="hpb-grid cm-cards-grid" style="margin-bottom:12px;">
                <div class="hpb-card">
                    <div class="hpb-icon hpb-icon-blue"><i class="fa fa-building"></i></div>
                    <div class="hpb-num">@stateModule.TotalActiveCompanies.ToString("N0")</div>
                    <div class="hpb-label">Active Companies</div>
                    <div class="hpb-note">@stateModule.PercentOfUSTotal.ToString("F1")% of U.S. total</div>
                </div>
                @if (stateModule.TotalPowerUnits > 0)
                {
                    <div class="hpb-card">
                        <div class="hpb-icon hpb-icon-green"><i class="fa fa-truck"></i></div>
                        <div class="hpb-num">@stateModule.TotalPowerUnits.ToString("N0")</div>
                        <div class="hpb-label">Active Power Units</div>
                        <div class="hpb-note">reported by @smReporting.ToString("N0") carriers</div>
                    </div>
                }
                @if (stateModule.NewRegistrations12 > 0)
                {
                    <div class="hpb-card">
                        <div class="hpb-icon hpb-icon-purple"><i class="fa fa-line-chart"></i></div>
                        <div class="hpb-num">
                            @stateModule.NewRegistrations12.ToString("N0")
                            @if (smHasGrowth)
                            {
                                string smBadgeClass = smGrowthPct >= 0 ? "sm-badge-up" : "sm-badge-dn";
                                string smSign       = smGrowthPct >= 0 ? "+" : "";
                                <span class="sm-badge @smBadgeClass">@smSign@smGrowthPct.ToString("F1")%</span>
                            }
                        </div>
                        <div class="hpb-label">New Registrations (12 mo)</div>
                        <div class="hpb-note">vs. @stateModule.NewPriorRegistrations12.ToString("N0") prior 12 months</div>
                    </div>
                }
                @if (smOOPct > 0m)
                {
                    <div class="hpb-card">
                        <div class="hpb-icon hpb-icon-orange"><i class="fa fa-user"></i></div>
                        <div class="hpb-num">@smOOPct.ToString("F1")%</div>
                        <div class="hpb-label">Owner-Operator Share</div>
                        <div class="hpb-note">of carriers reporting fleet size</div>
                    </div>
                }
            </div>
            @if (smShowHl)
            {
                <div class="cm-section">
                    <div class="cm-section-title"><i class="fa fa-bolt"></i> What stands out</div>
                    <ul class="cm-hl-list">
                        @foreach (var hl in stateHighlights)
                        {
                            <li class="cm-hl-item">@hl</li>
                        }
                    </ul>
                </div>
            }
            <div class="cm-footer">
                <a href="@smStateUrl">@stateModule.StateName trucking statistics &rarr;</a>
                <a href="/statistics/active-companies">National overview &rarr;</a>
            </div>
        </div>
    }

    @* State article with Read more — below the module, same order as the homepage *@
    @if (!string.IsNullOrEmpty(stateArticleRaw))
    {
        <div class="state-article">
            <div id="stateArticle" class="state-article-text">
                @stateArticleRaw
            </div>
            @if (stateArticleTruncated != null)
            {
                <button id="btnStateArticle" class="btn btn-default state-article-toggle">Read more</button>
            }
        </div>
    }

    @* Get A Quote (admin-controlled) *@
    @if (IsShowOnStatePage == true)
    {
        @Html.Partial("_GetAQuoteControl", Model.GetAQuoteVM)
    }

    @* Outbound banner *@
    @if (Model.OutboundBanner.IsShow)
    {
        <div class="text-center" style="margin-bottom:16px;">
            @if (Model.OutboundBanner.IsFollow)
            {
                <a href="@Model.OutboundBanner.URL" class="banner-link" title="@Model.OutboundBanner.TitleText" target="_blank">
                    <img src="get-banner-image?fileName=@Model.OutboundBanner.FileName" style="max-width:100%;max-height:200px;" alt="@Model.OutboundBanner.AltText" />
                </a>
            }
            else
            {
                <a href="@Model.OutboundBanner.URL" class="banner-link" title="@Model.OutboundBanner.TitleText" rel="nofollow" target="_blank">
                    <img src="get-banner-image?fileName=@Model.OutboundBanner.FileName" style="max-width:100%;max-height:200px;" alt="@Model.OutboundBanner.AltText" />
                </a>
            }
        </div>
    }

    @* Most popular cities *@
    <div class="state-section">
        <h2 class="state-section-title">Most popular cities</h2>
        @if (Model.popularcities != null && Model.popularcities.Count > 0)
        {
            <div class="state-popular-grid">
                @foreach (var city in Model.popularcities)
                {
                    var cityName = city.CityName;
                    var cityUrlSegment = (city.CityName ?? "").Replace(" ", "-");
                    <a href="@Url.Content("~/" + city.StateCode + "/" + cityUrlSegment)"
                       class="state-popular-card"
                       onClick="$('#al').show();">
                        <span class="state-popular-name">@cityName</span>
                        <span class="state-popular-count">@city.CompanyCount.ToString("N0") active companies</span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-center text-muted">No popular cities found.</p>
        }
    </div>

    @* A-Z city directory *@
    @if (Model.Cities != null && Model.Cities.Count > 0)
    {
        <div class="state-section">
            <h2 class="state-section-title">Cities &amp; towns in @Model.StateName</h2>

            @* Jump navigation *@
            <div class="alpha-nav">
                @for (char c = 'A'; c <= 'Z'; c++)
                {
                    <a href="#@c" class="alpha-pill">@c</a>
                }
            </div>

            @* Sections A–Z *@
            @for (char charater = 'A'; charater <= 'Z'; charater++)
            {
                var avalaibleCity = Model.Cities.Where(b => b.CityName.ToUpper().StartsWith(charater.ToString())).ToList();
                if (avalaibleCity.Count > 0)
                {
                    <div class="state-alpha-section">
                        <div class="state-alpha-header" id="@charater">
                            <span class="state-alpha-letter">@charater</span>
                            <span class="state-alpha-label">Cities and towns</span>
                            <a class="state-alpha-up up-arrow-citypage"><i class="fa fa-arrow-up"></i></a>
                        </div>
                        <div class="row">
                            @foreach (var city in avalaibleCity)
                            {
                                var cityName = city.CityName;
                                var cityUrlSegment = (city.CityName ?? "").Replace(" ", "-");
                                <div class="col-md-4 col-sm-6 col-xs-12">
                                    <a class="state-city-link" onClick="$('#al').show();"
                                       href="@Url.Content("~/" + city.StateCode + "/" + cityUrlSegment)">
                                        @cityName Trucking Companies (@city.CompanyCount active)
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="state-section">
            <p class="text-center text-muted">No cities found.</p>
        </div>
    }

</div>

@section scripts {
<script>
    // Back to top
    $(".up-arrow-citypage").click(function () {
        $('html, body').scrollTop(0);
    });

    // Hide loader when returning via browser navigation from city page
    setTimeout(function () {
        $("#al").hide();
    }, 100);

    // Read more / Read less for state article
    $(document).ready(function () {
        $("#btnStateArticle").click(function () {
            var el = $('#stateArticle');
            if (el.hasClass('expanded')) {
                el.removeClass('expanded');
                $(this).text('Read more');
            } else {
                el.addClass('expanded');
                $(this).text('Read less');
            }
        });
    });
</script>
}
