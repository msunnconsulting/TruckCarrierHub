                        var nrAVals   = new[] { Model.AgeDistribution.ZeroToSixMonths, Model.AgeDistribution.SixToTwelveMonths, Model.AgeDistribution.OneToTwoYears, Model.AgeDistribution.TwoToFiveYears, Model.AgeDistribution.FivePlusYears };
                        int nrAS = 130; int nrACx = nrAS / 2; int nrACy = nrAS / 2; int nrAR = 52; int nrAInner = 34;
