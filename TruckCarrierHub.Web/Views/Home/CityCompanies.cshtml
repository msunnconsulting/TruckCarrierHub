</style>

<div class="container stats-page">

    <!-- breadcrumb -->
    <div class="stats-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="sep">/</span>
        <a href="@Url.Action("Statistics", "Home")">Statistics</a>
        <span class="sep">/</span>
        <a href="@Url.Action("ActiveCompanies", "Home")">Active Companies</a>
        <span class="sep">/</span>
        <a href="@Url.Action("StateCompanies", "Home", new { stateCode = Model.StateCode })">@Model.StateName</a>
        <span class="sep">/</span>
        @cityDisplay
    </div>

    <!-- hero -->
    <div class="cc-hero">
        <div class="cc-hero-label">City Statistics</div>
        <h1 class="cc-hero-title">Active Trucking Companies<br />in @cityDisplay, @Model.StateCode</h1>
        <p class="cc-hero-sub">
            @Model.TotalActiveCompanies.ToString("N0") active carriers, brokers &amp; freight companies.
            @if (!string.IsNullOrEmpty(Model.CountyName)
                 && !string.Equals(Model.CountyName.Trim(), (Model.CityName ?? "").Trim(), StringComparison.OrdinalIgnoreCase))
            {
                <span>Located in @(System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(Model.CountyName.ToLower())) County.</span>
            }
        </p>
        <div class="cc-hero-badges">
            <span class="cc-badge"><i class="fa fa-map-marker"></i> @cityDisplay, @Model.StateCode</span>
            <span class="cc-badge"><i class="fa fa-check-circle" style="color:#4ade80;"></i> FMCSA data &bull; updated weekly</span>
            @if (Model.PercentOfStateTotal > 0)
            {
                <span class="cc-badge"><i class="fa fa-bar-chart"></i> @Model.PercentOfStateTotal.ToString("F2")% of @Model.StateName</span>
            }
        </div>
        <a href="@Url.Action("StateCompanies", "Home", new { stateCode = Model.StateCode })" class="cc-back-link">
            <i class="fa fa-arrow-left"></i> Back to @Model.StateName Statistics
        </a>
    </div>

    <!-- ── Section 2: stat cards ── -->
    <div class="stat-cards-wrap" style="margin-bottom:24px;">

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-blue"><i class="fa fa-building"></i></div>
                <div class="stat-card-num">@Model.TotalActiveCompanies.ToString("N0")</div>
                <div class="stat-card-label">Active Trucking Companies</div>
                <div class="stat-card-desc">
                    @Model.PercentOfStateTotal.ToString("F2")% of all active carriers in @Model.StateName
                </div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-green"><i class="fa fa-calendar-plus-o"></i></div>
                <div class="stat-card-num">@Model.NewRegistrationsLast24Months.ToString("N0")</div>
                <div class="stat-card-label">New FMCSA Registrations (24 Mo.)</div>
                <div class="stat-card-desc">
                    Avg @Model.AvgNewPerMonth.ToString("F1") new companies per month
                    @if (Model.NewRegistrationsYoYPercent.HasValue)
                    {
                        string sign = Model.NewRegistrationsYoYPercent.Value >= 0 ? "+" : "";
                        string yoyColor = Model.NewRegistrationsYoYPercent.Value >= 0 ? "#16a34a" : "#dc2626";
                        <span style="font-weight:600;color:@yoyColor;">(@sign@Model.NewRegistrationsYoYPercent.Value.ToString("F1")% YoY)</span>
                    }
                </div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-orange"><i class="fa fa-truck"></i></div>
                @if (Model.MedianFleetSize > 0)
                {
                    <div class="stat-card-num">@Model.MedianFleetSize</div>
                }
                else
                {
                    <div class="stat-card-num">&mdash;</div>
                }
                <div class="stat-card-label">Median Fleet Size</div>
                <div class="stat-card-desc">Power units at the midpoint of all reporting companies</div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-teal"><i class="fa fa-user"></i></div>
                <div class="stat-card-num">@Model.OwnerOperatorPercent.ToString("F1")%</div>
                <div class="stat-card-label">Owner-Operator Rate</div>
                <div class="stat-card-desc">
                    vs. @Model.StateOwnerOperatorPercent.ToString("F1")% statewide in @Model.StateName
                </div>
            </div>
        </div>

    </div>

    <!-- ── Registration Trend & Company Size ── -->
    <div class="sc-row">

        <!-- Monthly Registrations Line Chart -->
        <div class="sc-col-half">
            <div class="sc-donut-wrap" style="padding:20px 24px;">
                <div style="display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:justify;-ms-flex-pack:justify;justify-content:space-between;gap:10px;margin-bottom:8px;">
                    <div class="sc-donut-title" style="margin:0;"><i class="fa fa-line-chart" style="color:#3b82f6;margin-right:8px;"></i>New FMCSA Registrations</div>
                    <div style="position:relative;">
                        <button class="cc-range-btn" onclick="ccToggleRange(event)">@(Model.RangeLabel ?? "Last 24 Months") <i class="fa fa-chevron-down" style="font-size:.7em;margin-left:3px;"></i></button>
                        <div id="ccRangeMenu" class="cc-range-menu" style="display:none;">
                            <a href="?range=24m"@(Model.SelectedRange == "24m" ? " class='cc-range-active'" : "")>Last 24 Months</a>
                            <a href="?range=4y"@(Model.SelectedRange == "4y" ? " class='cc-range-active'" : "")>Last 4 Years</a>
                            <a href="?range=8y"@(Model.SelectedRange == "8y" ? " class='cc-range-active'" : "")>Last 8 Years</a>
                            <a href="?range=all"@(Model.SelectedRange == "all" ? " class='cc-range-active'" : "")>All Data Available</a>
                        </div>
                    </div>
                </div>
                @if (Model.MonthlyRegistrations != null && Model.MonthlyRegistrations.Any())
                {
                    int rangeTotalReg = Model.MonthlyRegistrations.Sum(x => x.Count);
                    int rangeMonthN   = Model.MonthlyRegistrations.Count;
                    decimal rangeAvg  = rangeMonthN > 0 ? Math.Round((decimal)rangeTotalReg / rangeMonthN, 1) : 0;
                    var mr   = Model.MonthlyRegistrations;
                    int mrN  = mr.Count;
                    int mrMax = mrN > 0 ? mr.Max(x => x.Count) : 1;
                    if (mrMax < 1) { mrMax = 1; }
                    int lW = 480; int lH = 160;
                    int lPL = 36; int lPR = 10; int lPT = 8; int lPB = 24;
                    int lPW = lW - lPL - lPR; int lPH = lH - lPT - lPB;
                    double lBotY = lPT + lPH;
                    var lPts = new System.Text.StringBuilder();
                    double lFX = lPL, lLX = lPL;
                    for (int li = 0; li < mrN; li++)
                    {
                        double lx = lPL + (mrN <= 1 ? lPW / 2.0 : (double)li / (mrN - 1) * lPW);
                        double ly = lPT + lPH - (double)mr[li].Count / mrMax * lPH;
                        if (li == 0) { lPts.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, "{0:F1},{1:F1}", lx, ly); lFX = lx; }
                        else         { lPts.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, " {0:F1},{1:F1}", lx, ly); }
                        lLX = lx;
                    }
                    string lArea = string.Format(System.Globalization.CultureInfo.InvariantCulture,
                        "M {0:F1},{1:F1} L {2} L {3:F1},{1:F1} Z", lFX, lBotY, lPts, lLX);
                    var lG = new System.Text.StringBuilder();
                    for (int g = 1; g <= 3; g++)
                    {
                        double gy = lPT + lPH - (double)g / 3.0 * lPH;
                        int gv = (int)Math.Round((double)mrMax * g / 3.0);
                        lG.AppendFormat(System.Globalization.CultureInfo.InvariantCulture,
                            "<line x1='{0}' y1='{1:F1}' x2='{2}' y2='{1:F1}' stroke='#f3f4f6' stroke-width='1'/>" +
                            "<text x='{3}' y='{1:F1}' font-size='9' fill='#9ca3af' text-anchor='end' dominant-baseline='middle'>{4}</text>",
                            lPL, gy, lW - lPR, lPL - 3, gv);
                    }
                    var lXL = new System.Text.StringBuilder();
                    var lIdx = new System.Collections.Generic.HashSet<int> { 0, mrN / 4, mrN / 2, (mrN * 3) / 4, mrN - 1 };
                    foreach (int li in lIdx)
                    {
                        if (li < 0 || li >= mrN) { continue; }
                        double lx = lPL + (mrN <= 1 ? lPW / 2.0 : (double)li / (mrN - 1) * lPW);
                        string lbl = mr[li].Label ?? "";
                        if (lbl.Length >= 8) { lbl = lbl.Substring(0, 3) + " '" + lbl.Substring(lbl.Length - 2); }
                        lXL.AppendFormat(System.Globalization.CultureInfo.InvariantCulture,
                            "<text x='{0:F1}' y='{1}' font-size='9' fill='#9ca3af' text-anchor='middle'>{2}</text>",
                            lx, lH - 4, lbl);
                    }
                    <div style="overflow-x:auto;margin-top:12px;">
                        <svg width="100%" viewBox="0 0 @lW @lH" style="min-width:220px;overflow:visible;">
                            <defs>
                                <linearGradient id="ccLineGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#2563eb" stop-opacity="0.18"/>
                                    <stop offset="100%" stop-color="#2563eb" stop-opacity="0"/>
                                </linearGradient>
                            </defs>
                            @Html.Raw(lG.ToString())
                            <line x1="@lPL" y1="@((int)lBotY)" x2="@(lW - lPR)" y2="@((int)lBotY)" stroke="#e5e7eb" stroke-width="1"/>
                            <path d="@lArea" fill="url(#ccLineGrad)"/>
                            <polyline points="@lPts.ToString()" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
                            @Html.Raw(lXL.ToString())
                        </svg>
                    </div>
                    <div class="cc-monthly-stats" style="margin-top:14px;border-top:1px solid #f3f4f6;padding-top:12px;">
                        <div class="cc-monthly-stat">
                            <div class="cc-monthly-stat-num" style="color:#2563eb;">@rangeTotalReg.ToString("N0")</div>
                            <div class="cc-monthly-stat-lbl">Total</div>
                        </div>
                        <div class="cc-monthly-stat">
                            <div class="cc-monthly-stat-num">@rangeAvg.ToString("F1")</div>
                            <div class="cc-monthly-stat-lbl">Avg / month</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.BestMonthLabel))
                        {
                            <div class="cc-monthly-stat">
                                <div class="cc-monthly-stat-num" style="color:#16a34a;">@Model.BestMonthCount.ToString("N0")</div>
                                <div class="cc-monthly-stat-lbl">Best: @Model.BestMonthLabel</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.LowestMonthLabel))
                        {
                            <div class="cc-monthly-stat">
                                <div class="cc-monthly-stat-num" style="color:#dc2626;">@Model.LowestMonthCount.ToString("N0")</div>
                                <div class="cc-monthly-stat-lbl">Lowest: @Model.LowestMonthLabel</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="color:#9ca3af;font-size:.88em;padding:10px 0;">No registration data available.</p>
                }
            </div>
        </div>

        <!-- Company Size Distribution -->
        <div class="sc-col-half">
            <div class="sc-donut-wrap">
                <div class="sc-donut-title"><i class="fa fa-pie-chart" style="color:#3b82f6;margin-right:8px;"></i>Company Size Distribution</div>
                @{
                    var fsColors = new[] { "#2563eb", "#22c55e", "#f59e0b", "#a855f7", "#f97316" };
                    var fsLabels = new[] { "1 Power Unit", "2&ndash;5 Units", "6&ndash;20 Units", "21&ndash;100 Units", "101+ Units" };
                    var fsVals   = new[] { sd.OneUnit, sd.TwoToFive, sd.SixToTwenty, sd.TwentyOneToHundred, sd.OverHundred };
                    int fsSize = 180; int fsCx = 90; int fsCy = 90; int fsR = 72; int fsIn = 46;
                    double fsTotal = fsVals.Sum(x => (double)x);
                    if (fsTotal < 1) { fsTotal = 1; }
                    double fsAngle = -90.0;
                    var fsPaths = new System.Text.StringBuilder();
                    for (int fi = 0; fi < fsVals.Length; fi++)
                    {
                        double fsDeg = fsVals[fi] / fsTotal * 360.0;
                        if (fsDeg == 0) { continue; }
                        double fsEnd = fsAngle + fsDeg;
                        double fsSR  = fsAngle * Math.PI / 180.0;
                        double fsER  = fsEnd   * Math.PI / 180.0;
                        double fx1 = fsCx + fsR  * Math.Cos(fsSR); double fy1 = fsCy + fsR  * Math.Sin(fsSR);
                        double fx2 = fsCx + fsR  * Math.Cos(fsER); double fy2 = fsCy + fsR  * Math.Sin(fsER);
                        double fix1 = fsCx + fsIn * Math.Cos(fsSR); double fiy1 = fsCy + fsIn * Math.Sin(fsSR);
                        double fix2 = fsCx + fsIn * Math.Cos(fsER); double fiy2 = fsCy + fsIn * Math.Sin(fsER);
                        int fla = fsDeg > 180 ? 1 : 0;
                        fsPaths.AppendFormat(System.Globalization.CultureInfo.InvariantCulture,
                            "<path d='M {0:F1} {1:F1} A {2} {2} 0 {7} 1 {3:F1} {4:F1} L {8:F1} {9:F1} A {10} {10} 0 {7} 0 {5:F1} {6:F1} Z' fill='{11}'/>",
                            fx1, fy1, fsR, fx2, fy2, fix1, fiy1, fla, fix2, fiy2, fsIn, fsColors[fi]);
                        fsAngle = fsEnd;
                    }
                }
                <div class="sc-donut-body">
                    <div class="sc-donut-svg-wrap">
                        <svg width="@fsSize" height="@fsSize" viewBox="0 0 @fsSize @fsSize">
                            @Html.Raw(fsPaths.ToString())
                            <circle cx="@fsCx" cy="@fsCy" r="@fsIn" fill="#fff"/>
                        </svg>
                        <div class="sc-donut-center">
                            <div class="sc-donut-center-num">@sd.TotalReporting.ToString("N0")</div>
                            <div class="sc-donut-center-lbl">Reporting<br/>Fleets</div>
                        </div>
                    </div>
                    <div class="sc-donut-legend">
                        @for (int fi = 0; fi < fsVals.Length; fi++)
                        {
                            double fpct = fsVals[fi] / fsTotal * 100.0;
                            <div class="sc-legend-row">
                                <div class="sc-legend-dot" style="background:@fsColors[fi]"></div>
                                <span class="sc-legend-label">@Html.Raw(fsLabels[fi])</span>
                                <span class="sc-legend-count">@fsVals[fi].ToString("N0")</span>
                                <span class="sc-legend-pct">@fpct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%</span>
                            </div>
                        }
                    </div>
                </div>
                <p class="sc-donut-note"><i class="fa fa-info-circle"></i> Based on total power units reported to FMCSA.@if (Model.MedianFleetSize > 0) {<span> Median: @Model.MedianFleetSize unit(s).</span>}</p>
            </div>
        </div>

    </div>

    <!-- ── Section 4: Age Distribution donut + Authority Types ── -->
    <div class="sc-row">

        <!-- Company Age Distribution donut -->
        <div class="sc-col-half">
            <div class="sc-donut-wrap">
                <div class="sc-donut-title"><i class="fa fa-history" style="color:#3b82f6;margin-right:8px;"></i>Company Age Distribution</div>
                @{
                    var ageColors = new[] { "#22c55e", "#3b82f6", "#f59e0b", "#a78bfa", "#6b7280" };
                    var ageLabels = new[] { "0&ndash;2 Years", "3&ndash;5 Years", "6&ndash;10 Years", "11&ndash;20 Years", "20+ Years" };
                    var ageValues = new[] { ad.ZeroToTwo, ad.ThreeToFive, ad.SixToTen, ad.ElevenToTwenty, ad.OverTwenty };
                    int ageSize = 180;
                    int ageCx = ageSize / 2;
                    int ageCy = ageSize / 2;
                    int ageR = 72;
                    int ageInner = 46;
                    double ageTotal = ageValues.Sum(x => (double)x);
                    if (ageTotal == 0) { ageTotal = 1; }
                    double ageStartAngle = -90.0;
                    var agePaths = new System.Text.StringBuilder();
                    for (int ai = 0; ai < ageValues.Length; ai++)
                    {
                        double sliceDeg = ageValues[ai] / ageTotal * 360.0;
                        if (sliceDeg == 0) { continue; }
                        double endAngle = ageStartAngle + sliceDeg;
                        double startRad = ageStartAngle * Math.PI / 180.0;
                        double endRad = endAngle * Math.PI / 180.0;
                        double x1 = ageCx + ageR * Math.Cos(startRad);
                        double y1 = ageCy + ageR * Math.Sin(startRad);
                        double x2 = ageCx + ageR * Math.Cos(endRad);
                        double y2 = ageCy + ageR * Math.Sin(endRad);
                        double ix1 = ageCx + ageInner * Math.Cos(startRad);
                        double iy1 = ageCy + ageInner * Math.Sin(startRad);
                        double ix2 = ageCx + ageInner * Math.Cos(endRad);
                        double iy2 = ageCy + ageInner * Math.Sin(endRad);
                        int largeArc = sliceDeg > 180 ? 1 : 0;
                        string agePath = string.Format(
                            System.Globalization.CultureInfo.InvariantCulture,
                            "M {0:F1} {1:F1} A {2} {2} 0 {7} 1 {3:F1} {4:F1} L {8:F1} {9:F1} A {10} {10} 0 {7} 0 {5:F1} {6:F1} Z",
                            x1, y1, ageR, x2, y2, ix1, iy1, largeArc, ix2, iy2, ageInner);
                        agePaths.AppendFormat("<path d=\"{0}\" fill=\"{1}\" />", agePath, ageColors[ai]);
                        ageStartAngle = endAngle;
                    }
                }
                <div class="sc-donut-body">
                    <div class="sc-donut-svg-wrap">
                        <svg width="@ageSize" height="@ageSize" viewBox="0 0 @ageSize @ageSize">
                            @Html.Raw(agePaths.ToString())
                            <circle cx="@ageCx" cy="@ageCy" r="@ageInner" fill="#fff" />
                        </svg>
                        <div class="sc-donut-center">
                            @if (ad.AverageAgeYears > 0)
                            {
                                <div class="sc-donut-center-num">@ad.AverageAgeYears.ToString("F1")</div>
                                <div class="sc-donut-center-lbl">Avg age<br />(years)</div>
                            }
                            else
                            {
                                <div class="sc-donut-center-num">@Model.TotalActiveCompanies.ToString("N0")</div>
                                <div class="sc-donut-center-lbl">Companies</div>
                            }
                        </div>
                    </div>
                    <div class="sc-donut-legend">
                        @for (int ai = 0; ai < ageValues.Length; ai++)
                        {
                            double pct = ageValues[ai] / ageTotal * 100.0;
                            <div class="sc-legend-row">
                                <div class="sc-legend-dot" style="background:@ageColors[ai]"></div>
                                <span class="sc-legend-label">@Html.Raw(ageLabels[ai])</span>
                                <span class="sc-legend-count">@ageValues[ai].ToString("N0")</span>
                                <span class="sc-legend-pct">@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%</span>
                            </div>
                        }
                    </div>
                </div>
                @if (ad.AverageAgeYears > 0)
                {
                    <p class="sc-donut-note"><i class="fa fa-info-circle"></i> Based on FMCSA registration date. Average age: @ad.AverageAgeYears.ToString("F1") years.</p>
                }
            </div>
        </div>

        <!-- Authority Types -->
        <div class="sc-col-half">
            <div class="cc-auth-card">
                <div class="sc-donut-title"><i class="fa fa-id-badge" style="color:#3b82f6;margin-right:8px;"></i>Company Authority Types</div>
                @if (Model.TopAuthorityTypes != null && Model.TopAuthorityTypes.Any())
                {
                    var authColors = new[] { "#2563eb", "#10b981", "#f59e0b", "#8b5cf6", "#f97316", "#14b8a6" };
                    var authIcons = new[] { "fa-truck", "fa-handshake-o", "fa-industry", "fa-share-alt", "fa-cubes", "fa-tint" };
                    int maxAuthCount = Model.TopAuthorityTypes[0].CompanyCount;
                    for (int ai = 0; ai < Model.TopAuthorityTypes.Count; ai++)
                    {
                        var auth = Model.TopAuthorityTypes[ai];
                        string authColor = authColors[ai % authColors.Length];
                        string authIcon = authIcons[ai % authIcons.Length];
                        double authBarPct = maxAuthCount > 0 ? (double)auth.CompanyCount / maxAuthCount * 100.0 : 0;
                        <div class="cc-auth-row">
                            <div class="cc-auth-icon" style="background:#f3f4f6;color:@authColor;">
                                <i class="fa @authIcon"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="display:flex;align-items:baseline;gap:8px;">
                                    <span class="cc-auth-name">@auth.AuthorityTypeName</span>
                                    <span class="cc-auth-count">@auth.CompanyCount.ToString("N0")</span>
                                    <span class="cc-auth-pct">@auth.PercentOfTotal.ToString("F1")%</span>
                                </div>
                                <div class="cc-auth-bar-bg">
                                    <div class="cc-auth-bar-fill" style="width:@authBarPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;background:@authColor;"></div>
                                </div>
                            </div>
                        </div>
                    }
                    <p class="sc-donut-note" style="margin-top:14px;">
                        <i class="fa fa-info-circle"></i> A company may hold multiple authority types simultaneously.
                    </p>
                }
                else
                {
                    <p style="color:#9ca3af;font-size:.88em;padding:20px 0;">No authority type data available.</p>
                }
            </div>
        </div>

    </div>

    <!-- ── Section 3: Top 10 tables ── -->
    <div class="sc-row">

        <!-- Top 10 Cargo Types -->
        <div class="sc-col-half">
            <div class="sc-table-card">
                <div class="sc-table-header">
                    <i class="fa fa-list-ul"></i>
                    <span class="sc-table-title">Top 10 Cargo Types</span>
                </div>
                <div class="sc-table-body">
                    @if (Model.TopCargoTypes != null && Model.TopCargoTypes.Any())
                    {
                        var maxCargo = Model.TopCargoTypes[0].CompanyCount;
                        <table class="sc-ranked-table">
                            <thead>
                                <tr>
                                    <th style="width:28px">#</th>
                                    <th>Cargo Type</th>
                                    <th>Companies</th>
                                    <th>% of City</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopCargoTypes.Count; i++)
                                {
                                    var row = Model.TopCargoTypes[i];
                                    <tr>
                                        <td class="sc-rank-num">@(i + 1)</td>
                                        <td>@row.CargoTypeName</td>
                                        <td class="sc-rank-count">@row.CompanyCount.ToString("N0")</td>
                                        <td class="sc-rank-pct">@row.PercentOfTotal.ToString("F1")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="padding:20px;color:#6b7280;font-size:.88em;">No cargo data available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Top 10 Companies by Fleet Size -->
        <div class="sc-col-half">
            <div class="sc-table-card">
                <div class="sc-table-header">
                    <i class="fa fa-truck"></i>
                    <span class="sc-table-title">Largest Fleets in @cityDisplay</span>
                </div>
                <div class="sc-table-body">
                    @if (Model.TopCompaniesByFleetSize != null && Model.TopCompaniesByFleetSize.Any())
                    {
                        <table class="sc-ranked-table">
                            <thead>
                                <tr>
                                    <th style="width:28px">#</th>
                                    <th>Company</th>
                                    <th>Fleet</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopCompaniesByFleetSize.Count; i++)
                                {
                                    var row = Model.TopCompaniesByFleetSize[i];
                                    string companyName = !string.IsNullOrEmpty(row.LegalName) ? row.LegalName : "USDOT #" + row.USDOTNumber;
                                    <tr>
                                        <td class="sc-rank-num">@(i + 1)</td>
                                        <td>
                                            <a href="/@Model.StateCode/USDOT-@row.USDOTNumber" class="cc-dot-link" title="View USDOT @row.USDOTNumber">
                                                @companyName
                                            </a>
                                        </td>
                                        <td class="sc-rank-count">@row.FleetSize.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="padding:20px;color:#6b7280;font-size:.88em;">No fleet data available.</p>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- ── CTA Banner ── -->
    <div class="sc-cta-banner">
        <div class="sc-cta-icon"><i class="fa fa-search"></i></div>
        <div class="sc-cta-text">
            <h3>Browse all active trucking companies in @cityDisplay</h3>
            <p>Search, filter, and compare @Model.TotalActiveCompanies.ToString("N0") companies by cargo type, fleet size, authority type, and more.</p>
        </div>
        <a href="@Url.Action("City", "Home", new { stateCode = Model.StateCode.ToUpper(), city = Model.CityName.ToUpper().Replace(" ", "-") })" class="sc-cta-btn">
            Browse @cityDisplay Companies
        </a>
    </div>

    <!-- ── Source footer ── -->
    <div class="sc-source-bar" id="ccPageBottom">
        <i class="fa fa-shield"></i>
        <div>
            <strong>Data source:</strong> U.S. Federal Motor Carrier Safety Administration (FMCSA) &mdash; active carrier registrations.
            @if (Model.LastDataUpdate.HasValue)
            {
                <span>Last updated: @Model.LastDataUpdate.Value.ToString("MMMM d, yyyy").</span>
            }
            Active status reflects carriers with FMCSA status code "A" at the time of data collection.
        </div>
    </div>

</div>
<script>
function ccToggleRange(e) {
    e.stopPropagation();
    var m = document.getElementById('ccRangeMenu');
    m.style.display = m.style.display === 'none' ? 'block' : 'none';
}
document.addEventListener('click', function() {
    var m = document.getElementById('ccRangeMenu');
    if (m) m.style.display = 'none';
});
</script>
