                        <div class="ac-donut-body">
                            <div class="ac-donut-svg-wrap">
                                <svg width="@ctSize" height="@ctSize" viewBox="0 0 @ctSize @ctSize">
                                    @Html.Raw(ctPaths.ToString())
                                    <circle cx="@ctCx" cy="@ctCy" r="@ctInner" fill="#fff" />
                                </svg>
                                <div class="ac-donut-center">
                                    <div class="ac-donut-center-num" style="font-size:.80em;">Cargo</div>
                                    <div class="ac-donut-center-lbl">Type</div>
                                </div>
                            </div>
                            <div>
                                <table class="ac-ranked-table" style="font-size:.80em;">
                                    <thead>
                                        <tr>
                                            <th colspan="2">Cargo Type</th>
                                            <th>Companies</th>
                                            <th>% of Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int li = 0; li < Model.TopCargoTypes.Count && li < ctColors.Length; li++)
                                        {
                                            var cr = Model.TopCargoTypes[li];
                                            <tr>
                                                <td style="width:12px;padding-right:0;"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@ctColors[li];"></span></td>
                                                <td>@cr.CargoTypeName</td>
                                                <td class="ac-rank-count">@cr.CompanyCount.ToString("N0")</td>
                                                <td class="ac-rank-pct">@cr.PercentOfTotal.ToString("F1")%</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p style="padding:20px;color:#6b7280;font-size:.88em;">No cargo data available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Trends chart -->
        <div class="ac-col-33">
            <div class="ac-card" style="height:100%;">
                <div class="ac-card-header">
                    <div class="ac-card-title"><i class="fa fa-line-chart"></i> New FMCSA Registrations <span style="font-weight:400;color:#6b7280;font-size:.88em;">(Last 24 Months)</span></div>
                </div>
                <div class="ac-trends-wrap">
                    @if (Model.MonthlyRegistrations != null && Model.MonthlyRegistrations.Count >= 2)
                    {
                        int trW = 300; int trH = 160; int trPadL = 38; int trPadR = 6; int trPadT = 12; int trPadB = 28;
                        int trChartW = trW - trPadL - trPadR;
                        int trChartH = trH - trPadT - trPadB;
                        int trMinVal = Model.MonthlyRegistrations.Min(x => x.Count);
                        int trMaxVal = Model.MonthlyRegistrations.Max(x => x.Count);
                        int trRange  = trMaxVal - trMinVal;
                        if (trRange == 0) { trRange = 1; }
                        int trN = Model.MonthlyRegistrations.Count;
                        double trStepX = (double)trChartW / Math.Max(trN - 1, 1);
                        var trPoints = new System.Text.StringBuilder();
                        var trFill   = new System.Text.StringBuilder();
                        for (int pi = 0; pi < trN; pi++)
                        {
                            double px = trPadL + pi * trStepX;
                            double py = trPadT + trChartH - (double)(Model.MonthlyRegistrations[pi].Count - trMinVal) / trRange * trChartH;
                            trPoints.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, "{0:F1},{1:F1} ", px, py);
                            if (pi == 0) { trFill.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, "M{0:F1},{1:F1} ", px, trPadT + trChartH); }
                            trFill.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, "L{0:F1},{1:F1} ", px, py);
                        }
                        double trLastX = trPadL + (trN - 1) * trStepX;
                        trFill.AppendFormat(System.Globalization.CultureInfo.InvariantCulture, "L{0:F1},{1:F1} Z", trLastX, trPadT + trChartH);

                        var trLabels = new System.Text.StringBuilder();
                        for (int li = 0; li < trN; li++)
                        {
                            if (li % 6 == 0 || li == trN - 1)
                            {
                                double lx = trPadL + li * trStepX;
                                trLabels.AppendFormat(System.Globalization.CultureInfo.InvariantCulture,
                                    "<text x=\"{0:F1}\" y=\"{1}\" text-anchor=\"middle\" font-size=\"7\" fill=\"#9ca3af\">{2}</text>",
                                    lx, trH - 4, Model.MonthlyRegistrations[li].Label);
                            }
                        }
                        string trMinLbl = trMinVal >= 1000 ? (trMinVal / 1000.0).ToString("F0") + "k" : trMinVal.ToString();
                        string trMaxLbl = trMaxVal >= 1000 ? (trMaxVal / 1000.0).ToString("F0") + "k" : trMaxVal.ToString();

                        <svg class="ac-trends-svg" viewBox="0 0 @trW @trH">
                            <defs>
                                <linearGradient id="acTrendGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#2563eb" stop-opacity="0.15"/>
                                    <stop offset="100%" stop-color="#2563eb" stop-opacity="0"/>
                                </linearGradient>
                            </defs>
                            <line x1="@trPadL" y1="@trPadT" x2="@trPadL" y2="@(trPadT + trChartH)" stroke="#e5e7eb" stroke-width="1"/>
                            <line x1="@trPadL" y1="@(trPadT + trChartH / 2)" x2="@(trPadL + trChartW)" y2="@(trPadT + trChartH / 2)" stroke="#f3f4f6" stroke-width="1" stroke-dasharray="4,3"/>
                            <line x1="@trPadL" y1="@(trPadT + trChartH)" x2="@(trPadL + trChartW)" y2="@(trPadT + trChartH)" stroke="#e5e7eb" stroke-width="1"/>
                            <text x="@(trPadL - 4)" y="@(trPadT + 4)" text-anchor="end" font-size="7" fill="#9ca3af">@trMaxLbl</text>
                            <text x="@(trPadL - 4)" y="@(trPadT + trChartH + 4)" text-anchor="end" font-size="7" fill="#9ca3af">@trMinLbl</text>
                            <path d="@trFill" fill="url(#acTrendGrad)" />
                            <polyline points="@trPoints" fill="none" stroke="#2563eb" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>
                            @for (int di2 = 0; di2 < trN; di2++)
                            {
                                if (di2 == trN - 1)
                                {
                                    double dpx = trPadL + di2 * trStepX;
                                    double dpy = trPadT + trChartH - (double)(Model.MonthlyRegistrations[di2].Count - trMinVal) / trRange * trChartH;
                                    @:<circle cx="@dpx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" cy="@dpy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" r="3.5" fill="#2563eb" stroke="#fff" stroke-width="1.5"/>
                                }
                            }
                            @Html.Raw(trLabels.ToString())
                        </svg>

                        int trTotal24 = Model.MonthlyRegistrations.Sum(x => x.Count);
                        int trAvg = trN > 0 ? trTotal24 / trN : 0;
                        var trBest   = Model.MonthlyRegistrations.OrderByDescending(x => x.Count).First();
                        var trLowest = Model.MonthlyRegistrations.OrderBy(x => x.Count).First();
                        <div class="ac-trends-yoy" style="display:-webkit-box;display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;">
                            <div class="ac-trends-yoy-cell" style="-webkit-box-flex:1;-ms-flex:1 1 50%;flex:1 1 50%;border-bottom:1px solid #f3f4f6;">
                                <div class="ac-trends-yoy-lbl">Total (24 Months)</div>
                                <div class="ac-trends-yoy-val">@trTotal24.ToString("N0")</div>
                            </div>
                            <div class="ac-trends-yoy-cell" style="-webkit-box-flex:1;-ms-flex:1 1 50%;flex:1 1 50%;border-left:1px solid #f3f4f6;border-bottom:1px solid #f3f4f6;">
                                <div class="ac-trends-yoy-lbl">Average / Month</div>
                                <div class="ac-trends-yoy-val">@trAvg.ToString("N0")</div>
                            </div>
                            <div class="ac-trends-yoy-cell" style="-webkit-box-flex:1;-ms-flex:1 1 50%;flex:1 1 50%;">
                                <div class="ac-trends-yoy-lbl">Best Month</div>
                                <div class="ac-trends-yoy-val col-green">@trBest.Label (@trBest.Count.ToString("N0"))</div>
                            </div>
                            <div class="ac-trends-yoy-cell" style="-webkit-box-flex:1;-ms-flex:1 1 50%;flex:1 1 50%;border-left:1px solid #f3f4f6;">
                                <div class="ac-trends-yoy-lbl">Lowest Month</div>
                                <div class="ac-trends-yoy-val col-red">@trLowest.Label (@trLowest.Count.ToString("N0"))</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p style="color:#6b7280;font-size:.88em;">No trend data available.</p>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- Row 3: Top Cities + Top States by New Reg + Top Companies -->
    <div class="ac-row">

        <!-- Top 10 Cities -->
        <div class="ac-col-33">
            <div class="ac-card" style="height:100%;">
                <div class="ac-card-header">
                    <div class="ac-card-title"><i class="fa fa-map-marker"></i> Top 10 Cities by Active Trucking Companies</div>
                </div>
                <div class="ac-card-body">
                    @if (Model.TopCities != null && Model.TopCities.Any())
                    {
                        <table class="ac-ranked-table">
                            <thead>
                                <tr>
                                    <th style="width:24px">#</th>
                                    <th>City</th>
                                    <th>State</th>
                                    <th>Companies</th>
                                    <th>% of U.S.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopCities.Count; i++)
                                {
                                    var row = Model.TopCities[i];
                                    <tr>
                                        <td class="ac-rank-num">@(i + 1)</td>
                                        <td>
                                            <a href="@Url.Action("CityCompanies", "Home", new { stateCode = row.StateCode, cityName = row.CityName.Replace(" ", "-") })" style="color:#2563eb;text-decoration:none;">
                                                @ti.ToTitleCase(row.CityName.ToLower())
                                            </a>
                                        </td>
                                        <td style="color:#6b7280;">@row.StateCode</td>
                                        <td class="ac-rank-count"><a href="/@row.StateCode/@row.CityName.Replace(" ", "-")" style="color:#2563eb;text-decoration:none;">@row.CompanyCount.ToString("N0")</a></td>
                                        <td class="ac-rank-pct">@row.PercentOfTotal.ToString("F2")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="padding:20px;color:#6b7280;font-size:.88em;">No data available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Top 10 States by New Registrations -->
        <div class="ac-col-33">
            <div class="ac-card" style="height:100%;">
                <div class="ac-card-header">
                    <div class="ac-card-title"><i class="fa fa-map"></i> Top 10 States by New Registrations <span style="font-weight:400;color:#6b7280;font-size:.85em;">(Last 12 Months)</span></div>
                </div>
                <div class="ac-card-body">
                    @if (Model.TopStatesByNewRegistrations != null && Model.TopStatesByNewRegistrations.Any())
                    {
                        <table class="ac-ranked-table">
                            <thead>
                                <tr>
                                    <th style="width:24px">#</th>
                                    <th>State</th>
                                    <th>New Registrations</th>
                                    <th>% of Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopStatesByNewRegistrations.Count; i++)
