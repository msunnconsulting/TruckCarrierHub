@using PartnerCarrier.ViewModels.User
@model BusinessVM
@{
    ViewBag.Title = "Reset Password";
}

<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        @if (string.IsNullOrEmpty(Model.DoingBusinessAsName))
        {
            <h2 class="text-center">
                @Model.LegalName
            </h2>
        }
        else
        {
            var aka = " aka ";
            <h2 class="text-center"><t class="legalName-font-color">@Model.DoingBusinessAsName</t> @aka @Model.LegalName </h2>
        }
    </div>
    <div class="col-md-2"></div>
</div>

<div class="row">
    <div class="col-sm-3"></div>
    <div class="col-md-6 col-sm-6">
        <section id="loginForm">
            @using (Ajax.BeginForm("ResetPasswordSubmit", "Home", null, new AjaxOptions
            {
                HttpMethod = "POST",
                OnSuccess = "vm.ResetPasswordOnSuccess",
                OnFailure = "vm.ResetPasswordOnFailure"
            }, new { @class = "form-horizontal" }))
            {
                @Html.HiddenFor(x=>x.USDOTNumber)
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-sm-12 col-md-12">
                        <div class="form-group">
                            <label class="col-md-12">Password (at least six characters that are a combination of letters and numbers):</label>
                            <div class="col-md-8">
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12 col-md-12">
                        <div class="form-group">
                            <label class="col-md-12">Confirm Password :</label>
                            <div class="col-md-8">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12 col-md-12">
                        <button class="btn btn-primary text-center" type="submit">Submit</button>
                    </div>
                </div>
            }
        </section>
    </div>
    <div class="col-sm-3"></div>
</div>

<div class="row">
    <div class="col-sm-3"></div>
     
    <div class="col-sm-3"></div>
</div>

@section Scripts{
    <script src="~/Content/User/business-change-password.js"></script>
}



