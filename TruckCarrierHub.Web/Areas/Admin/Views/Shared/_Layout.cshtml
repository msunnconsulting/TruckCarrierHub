<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css-Area")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <img src="~/Images/ajax-loader.gif" id="al" class="ajax-loader" style="display:none;" />
    <div id="disabledpage"></div>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @Html.ActionLink("Truck Carrier Hub Admin", "Index", "Home", new { area = "" }, new { @class = "navbar-brand", @target = "_blank" })
            </div>
            <div class="navbar-collapse collapse">
                @Html.Partial("_TopMenu")
            </div>
        </div>
    </div>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Truck Carrier Hub</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery-area")
    @Scripts.Render("~/bundles/bootstrap-Area")
    @Scripts.Render("~/Areas/Admin/bundles/common-ajax-area")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("scripts", required: false)
</body>
</html>