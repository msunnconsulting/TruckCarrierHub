@using PartnerCarrier.ViewModels.Admin;
@model ForgotPasswordVM

@{
    ViewBag.Title = "Forgot your password?";
}
<div class="row">
    <div class="col-md-12">
        <h2>@ViewBag.Title</h2>
    </div>
</div>
<hr class="small" />
<div id="dvNotification" class="row"></div>
@using (Ajax.BeginForm("ForgotPassword", "Account", null, new AjaxOptions
{

    HttpMethod = "POST",
    OnSuccess = "vm.forgotPasswordOnSuccess",
    OnFailure = "vm.forgotPasswordOnFailure"

}, new { @class = "form-horizontal" }))
{


    @Html.AntiForgeryToken()


    <div class="row">
        <div class="col-md-4 col-sm-5">
            <div class="form-group">
                @Html.LabelFor(m => m.Email, new { @class = "col-md-12" })
                <div class="col-md-12">
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-12">
                    <input type="submit" class="btn btn-primary" value="Send" />

                </div>
            </div>
        </div>
    </div>
}
@section Scripts{
    <script src="~/Areas/Admin/Content/PageScript/Account/forgot-password.js"></script>
}


