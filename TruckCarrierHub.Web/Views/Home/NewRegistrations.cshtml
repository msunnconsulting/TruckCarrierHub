                </div>
            </div>

            <!-- Entity Type Donut -->
            <div class="nr-col-40">
                <div class="nr-card" style="height:100%;">
                    <div class="nr-card-header">
                        <div class="nr-card-title"><i class="fa fa-pie-chart"></i> Entity Type Distribution <span style="font-weight:400;color:#6b7280;font-size:.88em;">(@rangeLabel)</span></div>
                    </div>
                    <div class="nr-donut-wrap">
                        @{
                            var nrDColors = new[] { "#2563eb", "#16a34a", "#8b5cf6", "#f97316" };
                            var nrDLabels = new[] { "Motor Carrier only", "Broker only", "Both MC+Broker", "Other" };
                            var nrDVals   = new[] { Model.EntityMCCount, Model.EntityBrokerCount, Model.EntityBothCount, Model.EntityOtherCount };
                            int nrDS = 130; int nrDCx = nrDS / 2; int nrDCy = nrDS / 2; int nrDR = 52; int nrDInner = 34;
                            double nrDTotal = nrDVals.Sum(x => (double)x);
                            if (nrDTotal == 0) { nrDTotal = 1; }
                            double nrDA = -90.0;
                            var nrDPaths = new System.Text.StringBuilder();
                            for (int di = 0; di < nrDVals.Length; di++)
                            {
                                if (nrDVals[di] == 0) { continue; }
                                double sd = nrDVals[di] / nrDTotal * 360.0;
                                if (sd < 0.1) { continue; }
                                double sr = nrDA * Math.PI / 180.0;
                                double er = (nrDA + sd) * Math.PI / 180.0;
                                double x1 = nrDCx + nrDR * Math.Cos(sr); double y1 = nrDCy + nrDR * Math.Sin(sr);
                                double x2 = nrDCx + nrDR * Math.Cos(er); double y2 = nrDCy + nrDR * Math.Sin(er);
                                double ix1 = nrDCx + nrDInner * Math.Cos(sr); double iy1 = nrDCy + nrDInner * Math.Sin(sr);
                                double ix2 = nrDCx + nrDInner * Math.Cos(er); double iy2 = nrDCy + nrDInner * Math.Sin(er);
                                int la = sd > 180 ? 1 : 0;
                                string dp = string.Format(CultureInfo.InvariantCulture,
                                    "M{0:F1},{1:F1} A{2},{2} 0 {7} 1 {3:F1},{4:F1} L{8:F1},{9:F1} A{10},{10} 0 {7} 0 {5:F1},{6:F1} Z",
                                    x1, y1, nrDR, x2, y2, ix1, iy1, la, ix2, iy2, nrDInner);
                                nrDPaths.AppendFormat("<path d=\"{0}\" fill=\"{1}\" />", dp, nrDColors[di]);
                                nrDA += sd;
                            }
                        }
                        <div class="nr-donut-body">
                            <div class="nr-donut-svg-wrap">
                                <svg width="@nrDS" height="@nrDS" viewBox="0 0 @nrDS @nrDS">
                                    @Html.Raw(nrDPaths.ToString())
                                    <circle cx="@nrDCx" cy="@nrDCy" r="@nrDInner" fill="#fff" />
                                </svg>
                                <div class="nr-donut-center">
                                    <div class="nr-donut-center-num" style="font-size:.75em;">@Model.TotalNewCount.ToString("N0")</div>
                                    <div class="nr-donut-center-lbl">New Regs.</div>
                                </div>
                            </div>
                            <div>
                                <table class="nr-table" style="font-size:.80em;">
                                    <thead>
                                        <tr>
                                            <th colspan="2">Entity Type</th>
                                            <th>Count</th>
                                            <th>%</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int li = 0; li < nrDVals.Length; li++)
                                        {
                                            double pct = nrDVals[li] / nrDTotal * 100.0;
                                            <tr>
                                                <td style="width:12px;padding-right:0;"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@nrDColors[li];"></span></td>
                                                <td>@nrDLabels[li]</td>
                                                <td class="nr-count">@nrDVals[li].ToString("N0")</td>
                                                <td class="nr-pct">@pct.ToString("F1")%</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <p class="nr-donut-note">Exclusive segments &middot; any MC: @Model.NewMotorCarrierCount.ToString("N0") &middot; any broker: @Model.NewBrokerCount.ToString("N0")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

