@model PartnerCarrier.ViewModels.Admin.StatisticsFleetOperationsVM
@using System.Globalization
@{
    Layout = "~/Themes/Bootstrap/Views/Shared/_Layout.cshtml";
    string mdash = System.Char.ConvertFromUtf32(0x2014);
    var pageTitle = ViewBag.Title ?? "Fleet & Operations Statistics " + mdash + " U.S. Trucking | Truck Carrier Hub";
    string foCanonical = "https://truckcarrierhub.com/statistics/fleet-operations";
    int foTotal = Model != null ? Model.TotalActiveCompanies : 0;
    string foTotalFmt = foTotal.ToString("N0");
    string foMetaFull = "U.S. trucking fleet and operations statistics " + mdash + " " + foTotalFmt + " active carriers. Fleet size distribution, power units, owner-operators, equipment types, interstate vs. intrastate, and hazmat carriers.";
    string foMetaDesc = foMetaFull.Length <= 160 ? foMetaFull : foMetaFull.Substring(0, 157) + "...";
    var foLd = new Newtonsoft.Json.Linq.JObject {
        ["@context"]    = "https://schema.org",
        ["@type"]       = "WebPage",
        ["name"]        = "Fleet & Operations Statistics " + mdash + " U.S. Trucking",
        ["description"] = foMetaDesc,
        ["url"]         = foCanonical,
        ["breadcrumb"]  = new Newtonsoft.Json.Linq.JObject {
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new Newtonsoft.Json.Linq.JArray {
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home",                ["item"] = "https://truckcarrierhub.com" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Statistics",          ["item"] = "https://truckcarrierhub.com/statistics" },
                new Newtonsoft.Json.Linq.JObject { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "Fleet & Operations",  ["item"] = foCanonical }
            }
        }
    };

    int  reporting    = Model.ReportingCount;
    long totalPU      = Model.TotalPowerUnits;
    double avgFleet   = Model.AvgFleetSize;

    double reportingPct       = foTotal > 0 ? Math.Round(100.0 * reporting / foTotal, 1) : 0;
    double ownerOpPctOfTotal  = foTotal > 0 ? Math.Round(100.0 * Model.OwnerOperatorCount / foTotal, 1) : 0;
    double ownerOpPctOfReport = reporting > 0 ? Math.Round(100.0 * Model.OwnerOperatorCount / reporting, 1) : 0;
    double interstatePct      = foTotal > 0 ? Math.Round(100.0 * Model.InterstateCount / foTotal, 1) : 0;
    double intrastatePct      = foTotal > 0 ? Math.Round(100.0 * Model.IntrastateCount / foTotal, 1) : 0;
    double hazmatPct          = foTotal > 0 ? Math.Round(100.0 * Model.HazmatCount / foTotal, 1) : 0;

    int maxBucketCount = 1;
    if (Model.FleetBuckets != null && Model.FleetBuckets.Count > 0)
    {
        foreach (var b in Model.FleetBuckets) { if (b.CompanyCount > maxBucketCount) { maxBucketCount = b.CompanyCount; } }
    }

    long   maxStatePU  = Model.TopStatesByPowerUnits != null && Model.TopStatesByPowerUnits.Count > 0 ? Model.TopStatesByPowerUnits[0].TotalPowerUnits : 1;
    double maxStateAvg = Model.TopStatesByAvgFleet   != null && Model.TopStatesByAvgFleet.Count   > 0 ? Model.TopStatesByAvgFleet[0].AvgFleetSize     : 1.0;
    if (maxStatePU  < 1)   { maxStatePU  = 1; }
    if (maxStateAvg < 0.1) { maxStateAvg = 1.0; }
}
@section AdditionalMeta {
<meta name="description" content="@foMetaDesc" />
<link rel="canonical" href="@foCanonical" />
<script type="application/ld+json">@Html.Raw(foLd.ToString(Newtonsoft.Json.Formatting.None))</script>
}
<link rel="stylesheet" href="@Url.Content("~/Content/statistics-page.css")" />
<style>
    /* ── section cards ── */
    .fo-card { background:#fff; border:1px solid #e5e7eb; border-radius:10px; box-shadow:0 1px 4px rgba(0,0,0,.06); overflow:hidden; }
    .fo-card-header { padding:14px 18px 12px; border-bottom:1px solid #e5e7eb; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:10px; }
    .fo-card-title { font-size:1em; font-weight:700; color:#111827; margin:0; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:8px; }
    .fo-card-title .fa { color:#0d9488; }

    /* ── two-col layout ── */
    .fo-row { display:-webkit-box; display:-ms-flexbox; display:flex; gap:20px; margin-bottom:24px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .fo-col-50 { -webkit-box-flex:0; -ms-flex:0 0 calc(50% - 10px); flex:0 0 calc(50% - 10px); min-width:0; }
    @@media (max-width:860px) { .fo-col-50 { -webkit-box-flex:0; -ms-flex:0 0 100%; flex:0 0 100%; } }

    /* ── fleet bucket chart ── */
    .fo-buckets-wrap { padding:18px; }
    .fo-bucket-row { display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:12px; margin-bottom:14px; }
    .fo-bucket-row:last-child { margin-bottom:0; }
    .fo-bucket-lbl { -webkit-box-flex:0; -ms-flex:0 0 210px; flex:0 0 210px; font-size:.82em; color:#374151; font-weight:600; }
    .fo-bucket-bar-col { -webkit-box-flex:1; -ms-flex:1; flex:1; }
    .fo-bucket-bar-bg   { background:#e5e7eb; border-radius:4px; height:16px; }
    .fo-bucket-bar-fill { background:#14b8a6; border-radius:4px; height:16px; }
    .fo-bucket-stats { -webkit-box-flex:0; -ms-flex:0 0 150px; flex:0 0 150px; text-align:right; font-size:.82em; }
    .fo-bucket-count { font-weight:700; color:#111827; }
    .fo-bucket-pct   { color:#6b7280; font-size:.85em; margin-left:4px; }
    @@media (max-width:700px) {
        .fo-bucket-lbl   { -webkit-box-flex:0; -ms-flex:0 0 110px; flex:0 0 110px; }
        .fo-bucket-stats { -webkit-box-flex:0; -ms-flex:0 0 80px; flex:0 0 80px; }
    }

    /* ── equipment breakdown ── */
    .fo-equip-grid { display:-webkit-box; display:-ms-flexbox; display:flex; gap:14px; padding:18px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .fo-equip-box { -webkit-box-flex:1; -ms-flex:1 1 120px; flex:1 1 120px; background:#f0fdfa; border:1px solid #99f6e4; border-radius:8px; padding:14px 16px; text-align:center; }
    .fo-equip-icon { font-size:1.25em; color:#0d9488; margin-bottom:6px; }
    .fo-equip-num  { font-size:1.3em; font-weight:700; color:#111827; line-height:1.1; }
    .fo-equip-lbl  { font-size:.78em; color:#374151; margin-top:4px; font-weight:600; }
    .fo-equip-sub  { font-size:.72em; color:#6b7280; margin-top:2px; }
    .fo-equip-total { margin:0 18px 18px; padding:12px 16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:justify; -ms-flex-pack:justify; justify-content:space-between; gap:12px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .fo-equip-total-lbl { font-size:.85em; color:#374151; font-weight:600; }
    .fo-equip-total-num { font-size:1.05em; font-weight:700; color:#111827; }

    /* ── teal callout ── */
    .fo-callout { background:#f0fdfa; border:1px solid #99f6e4; border-radius:10px; padding:22px 24px; margin-bottom:24px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:20px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .fo-callout-icon { width:52px; height:52px; background:#ccfbf1; border-radius:50%; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:center; -ms-flex-pack:center; justify-content:center; font-size:1.3em; color:#0d9488; -ms-flex-negative:0; flex-shrink:0; }
    .fo-callout-body { -webkit-box-flex:1; -ms-flex:1; flex:1; min-width:0; }
    .fo-callout-num  { font-size:2em; font-weight:700; color:#0d9488; line-height:1; margin-bottom:3px; }
    .fo-callout-lbl  { font-size:.95em; font-weight:700; color:#111827; }
    .fo-callout-desc { font-size:.82em; color:#374151; margin-top:4px; }

    /* ── hazmat callout ── */
    .fo-hazmat { background:#fff7ed; border:1px solid #fed7aa; border-radius:10px; padding:22px 24px; margin-bottom:24px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:20px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .fo-hazmat-icon { width:52px; height:52px; background:#ffedd5; border-radius:50%; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:center; -ms-flex-pack:center; justify-content:center; font-size:1.3em; color:#ea580c; -ms-flex-negative:0; flex-shrink:0; }
    .fo-hazmat-num  { font-size:2em; font-weight:700; color:#ea580c; line-height:1; margin-bottom:3px; }
    .fo-hazmat-lbl  { font-size:.95em; font-weight:700; color:#111827; }
    .fo-hazmat-desc { font-size:.82em; color:#374151; margin-top:4px; }

    /* ── operational scope ── */
    .fo-scope-grid { display:-webkit-box; display:-ms-flexbox; display:flex; gap:20px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .fo-scope-card { -webkit-box-flex:1; -ms-flex:1 1 200px; flex:1 1 200px; background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:20px 22px; }
    .fo-scope-hdr { display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:10px; margin-bottom:12px; }
    .fo-scope-accent { width:4px; height:32px; border-radius:3px; -ms-flex-negative:0; flex-shrink:0; }
    .fo-scope-title { font-size:.92em; font-weight:700; color:#111827; }
    .fo-scope-num   { font-size:1.9em; font-weight:700; color:#111827; line-height:1; margin-bottom:3px; }
    .fo-scope-sub   { font-size:.82em; color:#6b7280; margin-bottom:8px; }
    .fo-scope-pu    { font-size:.88em; color:#374151; }
    .fo-scope-pu strong { color:#111827; }

    /* ── tables ── */
    .fo-table { width:100%; border-collapse:collapse; font-size:.88em; }
    .fo-table th { background:#f3f4f6; color:#374151; font-weight:600; padding:9px 12px; text-align:left; border-bottom:2px solid #e5e7eb; white-space:nowrap; }
    .fo-table td { padding:8px 12px; border-bottom:1px solid #f3f4f6; color:#374151; vertical-align:middle; }
    .fo-table tr:last-child td { border-bottom:none; }
    .fo-table tr:hover td { background:#f9fafb; }
    .fo-rank-num   { font-weight:700; color:#9ca3af; width:28px; }
    .fo-rank-count { font-weight:700; color:#111827; white-space:nowrap; }
    .fo-rank-bar-wrap { width:70px; display:inline-block; vertical-align:middle; }
    .fo-rank-bar-bg   { background:#e5e7eb; border-radius:3px; height:5px; }
    .fo-rank-bar-fill { background:#0d9488; border-radius:3px; height:5px; }

    /* ── related statistics ── */
    .fo-related { margin-bottom:28px; }
    .fo-related-title { font-size:.88em; font-weight:700; color:#6b7280; text-transform:uppercase; letter-spacing:.06em; margin-bottom:14px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:8px; }
    .fo-related-grid { display:-webkit-box; display:-ms-flexbox; display:flex; gap:14px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .fo-related-item { -webkit-box-flex:1; -ms-flex:1 1 160px; flex:1 1 160px; background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:14px 16px; text-decoration:none; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:12px; -webkit-transition:border-color .15s; transition:border-color .15s; }
    .fo-related-item:hover { border-color:#99f6e4; text-decoration:none; }
    .fo-related-icon { width:36px; height:36px; border-radius:8px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:center; -ms-flex-pack:center; justify-content:center; font-size:.95em; -ms-flex-negative:0; flex-shrink:0; }
    .fo-related-text strong { display:block; font-size:.82em; color:#111827; font-weight:600; }
    .fo-related-text span   { display:block; font-size:.75em; color:#6b7280; }
    .fo-related-arrow { margin-left:auto; color:#9ca3af; font-size:.85em; -ms-flex-negative:0; flex-shrink:0; }

    /* ── source + footer ── */
    .fo-source-bar { background:#f0fdfa; border:1px solid #99f6e4; border-radius:10px; padding:16px 22px; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-pack:justify; -ms-flex-pack:justify; justify-content:space-between; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:16px; -ms-flex-wrap:wrap; flex-wrap:wrap; margin-bottom:20px; }
    .fo-source-left { display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:14px; }
    .fo-source-icon { width:46px; height:46px; background:#ccfbf1; border-radius:50%; display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-align:center; -ms-flex-align:center; align-items:center; -webkit-box-pack:center; -ms-flex-pack:center; justify-content:center; color:#0d9488; font-size:1.2em; -ms-flex-negative:0; flex-shrink:0; }
    .fo-source-text strong { font-size:.92em; color:#065f46; display:block; }
    .fo-source-text span   { font-size:.80em; color:#374151; }
    .fo-footer-bar { display:-webkit-box; display:-ms-flexbox; display:flex; -webkit-box-pack:justify; -ms-flex-pack:justify; justify-content:space-between; -webkit-box-align:center; -ms-flex-align:center; align-items:center; gap:16px; border-top:1px solid #e5e7eb; padding-top:14px; margin-bottom:30px; -ms-flex-wrap:wrap; flex-wrap:wrap; }
    .fo-footer-bar span { font-size:.8em; color:#9ca3af; }
</style>

<div class="container stats-page">

    <!-- Section 1: Breadcrumb + Hero -->
    <div class="stats-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="sep">/</span>
        <a href="@Url.Action("Statistics", "Home")">Statistics</a>
        <span class="sep">/</span>
        Fleet &amp; Operations
    </div>

    <div class="stats-hero">
        <div class="stats-hero-text">
            <h1 class="stats-hero-title">Fleet &amp; Operations</h1>
            <p style="font-size:1.05em;font-weight:600;color:#374151;margin:-6px 0 10px;">U.S. Trucking Statistics Overview</p>
            <p class="stats-hero-desc">
                Fleet size distribution, power unit counts, equipment types, owner-operator breakdowns,
                and operational scope for active U.S. motor carriers based on FMCSA registration data.
            </p>
            @if (Model.LastDataUpdate.HasValue)
            {
                <div style="margin-top:10px;font-size:.82em;color:#6b7280;display:-webkit-box;display:-ms-flexbox;display:flex;gap:18px;-ms-flex-wrap:wrap;flex-wrap:wrap;">
                    <span><i class="fa fa-calendar-o" style="margin-right:5px;color:#9ca3af;"></i>Data updated: @Model.LastDataUpdate.Value.ToString("MMMM d, yyyy")</span>
                    <span><i class="fa fa-database" style="margin-right:5px;color:#9ca3af;"></i>Source: FMCSA SAFER</span>
                </div>
            }
        </div>
        <div class="stats-hero-map">
            <img src="@Url.Content("~/Content/images/truck.png")" alt="Fleet and operations statistics" class="stats-hero-map-img" />
        </div>
    </div>

    <!-- Section 2: KPI Cards -->
    <div class="stat-cards-wrap" style="margin-bottom:28px;">

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-teal"><i class="fa fa-truck"></i></div>
                <div class="stat-card-num">@foTotalFmt</div>
                <div class="stat-card-label">Active U.S. Carriers</div>
                <div class="stat-card-desc">Active trucking companies, excluding pure broker-only authorities</div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-teal"><i class="fa fa-check-circle-o"></i></div>
                <div class="stat-card-num">@reporting.ToString("N0")</div>
                <div class="stat-card-label">Reporting Fleet Size</div>
                <div class="stat-card-desc">@reportingPct.ToString("F1", CultureInfo.InvariantCulture)% of all active companies</div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-teal"><i class="fa fa-bar-chart"></i></div>
                <div class="stat-card-num">@totalPU.ToString("N0")</div>
                <div class="stat-card-label">Total Power Units</div>
                <div class="stat-card-desc">Across reporting companies</div>
            </div>
        </div>

        <div class="stat-card-col">
            <div class="stat-card-v2">
                <div class="stat-icon-circle sic-teal"><i class="fa fa-calculator"></i></div>
                <div class="stat-card-num">@avgFleet.ToString("F1", CultureInfo.InvariantCulture)</div>
                <div class="stat-card-label">Avg Fleet Size</div>
                <div class="stat-card-desc">Per company reporting fleet size</div>
            </div>
        </div>

    </div>

    <!-- Section 3: Fleet Size Distribution -->
    <div class="fo-card" style="margin-bottom:24px;">
        <div class="fo-card-header">
            <h2 class="fo-card-title"><i class="fa fa-bar-chart"></i> Fleet Size Distribution</h2>
        </div>
        <div class="fo-buckets-wrap">
            <p style="font-size:.82em;color:#6b7280;margin:0 0 18px;">Based on @reporting.ToString("N0") companies reporting fleet size (1&ndash;50,000 power units). Percentages are of companies reporting fleet size.</p>
            @if (Model.FleetBuckets != null)
            {
                foreach (var bucket in Model.FleetBuckets)
                {
                    int barPct = maxBucketCount > 0 ? (int)Math.Round(100.0 * bucket.CompanyCount / maxBucketCount) : 0;
                    double bucketPctOfReporting = reporting > 0 ? Math.Round(100.0 * bucket.CompanyCount / reporting, 1) : 0;
                    <div class="fo-bucket-row">
                        <div class="fo-bucket-lbl">@bucket.Label</div>
                        <div class="fo-bucket-bar-col">
                            <div class="fo-bucket-bar-bg">
                                <div class="fo-bucket-bar-fill" style="width:@(barPct)%"></div>
                            </div>
                        </div>
                        <div class="fo-bucket-stats">
                            <span class="fo-bucket-count">@bucket.CompanyCount.ToString("N0")</span>
                            <span class="fo-bucket-pct">(@bucketPctOfReporting.ToString("F1", CultureInfo.InvariantCulture)%)</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Section 5: Owner-Operators -->
    <div class="fo-callout">
        <div class="fo-callout-icon"><i class="fa fa-user"></i></div>
        <div class="fo-callout-body">
            <div class="fo-callout-num">@Model.OwnerOperatorCount.ToString("N0")</div>
            <div class="fo-callout-lbl">Owner-Operators (1 power unit)</div>
            <div class="fo-callout-desc">
                @ownerOpPctOfTotal.ToString("F1", CultureInfo.InvariantCulture)% of all active companies &bull;
                @ownerOpPctOfReport.ToString("F1", CultureInfo.InvariantCulture)% of companies reporting fleet size
            </div>
        </div>
    </div>

    <!-- Section 6: Operational Scope -->
    <div class="fo-card" style="margin-bottom:24px;">
        <div class="fo-card-header">
            <h2 class="fo-card-title"><i class="fa fa-map"></i> Operational Scope</h2>
        </div>
        <div style="padding:18px;">
            <div class="fo-scope-grid">
                <div class="fo-scope-card">
                    <div class="fo-scope-hdr">
                        <div class="fo-scope-accent" style="background:#2563eb;"></div>
                        <div class="fo-scope-title">Interstate Carriers</div>
                    </div>
                    <div class="fo-scope-num">@Model.InterstateCount.ToString("N0")</div>
                    <div class="fo-scope-sub">@interstatePct.ToString("F1", CultureInfo.InvariantCulture)% of all active companies</div>
                    <div class="fo-scope-pu"><strong>@Model.InterstatePowerUnits.ToString("N0")</strong> power units</div>
                </div>
                <div class="fo-scope-card">
                    <div class="fo-scope-hdr">
                        <div class="fo-scope-accent" style="background:#7c3aed;"></div>
                        <div class="fo-scope-title">Intrastate-Only Carriers</div>
                    </div>
                    <div class="fo-scope-num">@Model.IntrastateCount.ToString("N0")</div>
                    <div class="fo-scope-sub">@intrastatePct.ToString("F1", CultureInfo.InvariantCulture)% of all active companies</div>
                    <div class="fo-scope-pu"><strong>@Model.IntrastatePowerUnits.ToString("N0")</strong> power units</div>
                </div>
            </div>
            <p style="font-size:.78em;color:#9ca3af;margin:14px 0 0;">Interstate = authorized for interstate commerce. Intrastate-only = intrastate hazmat or non-hazmat authority without interstate authorization. Some companies may hold other or mixed authority types.</p>
        </div>
    </div>

    <!-- Section 7: Hazmat Carriers -->
    <div class="fo-hazmat">
        <div class="fo-hazmat-icon"><i class="fa fa-exclamation-triangle"></i></div>
        <div class="fo-callout-body">
            <div class="fo-hazmat-num">@Model.HazmatCount.ToString("N0")</div>
            <div class="fo-hazmat-lbl">Hazmat Carriers</div>
            <div class="fo-hazmat-desc">
                @hazmatPct.ToString("F1", CultureInfo.InvariantCulture)% of all active companies &bull;
                @Model.HazmatPowerUnits.ToString("N0") power units
            </div>
        </div>
    </div>

    <!-- Sections 8 & 9: State Tables -->
    <div class="fo-row">

        <div class="fo-col-50">
            <div class="fo-card">
                <div class="fo-card-header">
                    <h2 class="fo-card-title"><i class="fa fa-map-marker"></i> Top 10 States by Power Units</h2>
                </div>
                <table class="fo-table">
                    <thead>
                        <tr>
                            <th class="fo-rank-num">#</th>
                            <th>State</th>
                            <th style="text-align:right;">Power Units</th>
                            <th style="text-align:right;width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopStatesByPowerUnits != null)
                        {
                            int foRankPU = 0;
                            foreach (var row in Model.TopStatesByPowerUnits)
                            {
                                foRankPU++;
                                int barWPU = (int)Math.Round(100.0 * row.TotalPowerUnits / maxStatePU);
                                <tr>
                                    <td class="fo-rank-num">@foRankPU</td>
                                    <td><a href="/statistics/state/@row.StateCode" style="color:#0d9488;text-decoration:none;font-weight:600;">@row.StateName</a> <a href="/@row.StateCode" style="font-size:.78em;color:#9ca3af;margin-left:6px;text-decoration:none;">browse →</a></td>
                                    <td style="text-align:right;" class="fo-rank-count">@row.TotalPowerUnits.ToString("N0")</td>
                                    <td style="text-align:right;">
                                        <div class="fo-rank-bar-wrap">
                                            <div class="fo-rank-bar-bg"><div class="fo-rank-bar-fill" style="width:@(barWPU)%"></div></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="fo-col-50">
            <div class="fo-card">
                <div class="fo-card-header">
                    <h2 class="fo-card-title"><i class="fa fa-sort-amount-desc"></i> Top 10 States by Avg Fleet Size</h2>
                </div>
                <table class="fo-table">
                    <thead>
                        <tr>
                            <th class="fo-rank-num">#</th>
                            <th>State</th>
                            <th style="text-align:right;">Avg Units</th>
                            <th style="text-align:right;width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopStatesByAvgFleet != null)
                        {
                            int foRankAvg = 0;
                            foreach (var row in Model.TopStatesByAvgFleet)
                            {
                                foRankAvg++;
                                int barWAvg = (int)Math.Round(100.0 * row.AvgFleetSize / maxStateAvg);
                                <tr>
                                    <td class="fo-rank-num">@foRankAvg</td>
                                    <td><a href="/statistics/state/@row.StateCode" style="color:#0d9488;text-decoration:none;font-weight:600;">@row.StateName</a> <a href="/@row.StateCode" style="font-size:.78em;color:#9ca3af;margin-left:6px;text-decoration:none;">browse →</a></td>
                                    <td style="text-align:right;" class="fo-rank-count">@row.AvgFleetSize.ToString("F1", CultureInfo.InvariantCulture)</td>
                                    <td style="text-align:right;">
                                        <div class="fo-rank-bar-wrap">
                                            <div class="fo-rank-bar-bg"><div class="fo-rank-bar-fill" style="width:@(barWAvg)%"></div></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <p style="font-size:.78em;color:#9ca3af;padding:8px 12px 12px;margin:0;">States with at least 100 reporting companies.</p>
            </div>
        </div>

    </div>

    <!-- Section 10: Related Statistics -->
    <div class="fo-related">
        <div class="fo-related-title"><i class="fa fa-link"></i> Related Statistics</div>
        <div class="fo-related-grid">
            <a href="@Url.Action("Statistics", "Home")" class="fo-related-item">
                <div class="fo-related-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa fa-home"></i></div>
                <div class="fo-related-text"><strong>Statistics Overview</strong><span>All statistics sections</span></div>
                <div class="fo-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
            <a href="@Url.Action("ActiveCompanies", "Home")" class="fo-related-item">
                <div class="fo-related-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa fa-building"></i></div>
                <div class="fo-related-text"><strong>Active Trucking Companies</strong><span>Company counts by state &amp; city</span></div>
                <div class="fo-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
            <a href="/statistics/active-brokers" class="fo-related-item">
                <div class="fo-related-icon" style="background:#f0fdf4;color:#16a34a;"><i class="fa fa-handshake-o"></i></div>
                <div class="fo-related-text"><strong>Active Freight Brokers</strong><span>Broker statistics &amp; trends</span></div>
                <div class="fo-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
            <a href="/statistics/new-registrations" class="fo-related-item">
                <div class="fo-related-icon" style="background:#f5f3ff;color:#7c3aed;"><i class="fa fa-line-chart"></i></div>
                <div class="fo-related-text"><strong>New FMCSA Registrations</strong><span>Registration trends &amp; data</span></div>
                <div class="fo-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
            <a href="/statistics/cargo" class="fo-related-item">
                <div class="fo-related-icon" style="background:#fff7ed;color:#ea580c;"><i class="fa fa-cubes"></i></div>
                <div class="fo-related-text"><strong>Cargo Statistics</strong><span>Cargo types &amp; specialization</span></div>
                <div class="fo-related-arrow"><i class="fa fa-chevron-right"></i></div>
            </a>
        </div>
    </div>

    <!-- FMCSA Source Bar -->
    <div class="fo-source-bar">
        <div class="fo-source-left">
            <div class="fo-source-icon"><i class="fa fa-database"></i></div>
            <div class="fo-source-text">
                <strong>Data Source: FMCSA SAFER System</strong>
                <span>Active U.S. motor carriers. Fleet size excludes outliers above 50,000 power units.</span>
            </div>
        </div>
    </div>

    <div class="fo-footer-bar">
        <span>Truck Carrier Hub &mdash; Fleet &amp; Operations Statistics</span>
        @if (Model.LastDataUpdate.HasValue)
        {
            <span>Data as of @Model.LastDataUpdate.Value.ToString("MMMM d, yyyy")</span>
        }
    </div>

</div>
