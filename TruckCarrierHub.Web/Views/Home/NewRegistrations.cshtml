                            <div class="nr-legend-item"><span class="nr-legend-dot" style="background:#7c3aed;"></span>All New Registrations</div>
                            <div class="nr-legend-item"><span class="nr-legend-dot" style="background:#2563eb;"></span>Motor Carriers</div>
                            <div class="nr-legend-item"><span class="nr-legend-dot" style="background:#16a34a;"></span>Freight Brokers</div>
                        </div>
                        <div style="display:-webkit-box;display:-ms-flexbox;display:flex;gap:0;border-top:1px solid #f3f4f6;margin-top:12px;">
                            <div style="-webkit-box-flex:1;-ms-flex:1;flex:1;padding:10px 12px;border-right:1px solid #f3f4f6;">
