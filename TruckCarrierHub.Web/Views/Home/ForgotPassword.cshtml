@using PartnerCarrier.ViewModels.Admin
@model BusinessForgotPasswordVM
@{
    ViewBag.Title = "Forgot Password";
}


<div id="contactus-bg-img">
    <section class="content">
        <div class="container">
            <div class="row">
                <div class="col-sm-3"></div>
                <div class="col-sm-6 contact-form">
                    <h2 class="text-center">Forgot Password</h2>
                    <div class="row" id="dvNotification"></div>
                    @using (Ajax.BeginForm("ForgotPassword", "Home", null, new AjaxOptions
                    {
                        HttpMethod = "POST",
                        OnSuccess = "vm.ForgotPasswordOnSuccess",
                        OnFailure = "vm.ForgotPasswordOnFailure"
                    }, new { @class = "form-horizontal" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-xs-12 col-md-12 form-group">
                                <label>Email (of your record in US DOT SAFER website):</label>
                                @Html.TextBoxFor(m => m.Email, new { placeholder = "Enter Email", @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-xs-12 col-md-12 form-group">
                                <button class="btn btn-primary text-center" type="submit">Send Email Link</button>
                            </div>
                        </div>

                    }
                </div>
                <div class="col-sm-3"></div>
            </div>
        </div>
    </section>
</div>



@section Scripts{
    <script src="~/Content/User/business-change-password.js"></script>
}

