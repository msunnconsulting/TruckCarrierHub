            Company Owner/Manager: If you see any incorrect information on this page, please
            <a rel="nofollow" href="https://dataqs.fmcsa.dot.gov/">contact the DOT directly to make changes</a>
            to correct your record.
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/Content/User/add-edit-review.js"></script>
    <script>
        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const reviewId = urlParams.get("reviewId");
            const open = urlParams.get("open");
            if (open === "reviews") {
                reviewVm.onReplyReview(reviewId, @Model.USDOTNumber);
            }
        });
    </script>
}
