@using PartnerCarrier.ViewModels.Admin
@model BaseOutboundLinkVM

@{
    ViewBag.Title = "Outbound Links";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <div class="row">
        <div class="col-md-10">
            <h2> @ViewBag.Title</h2>
        </div>
    </div>
    <hr class="small" />
    <div id="dvNotification"></div>

    <div class="row margin-bottom-10">
        <form id="outboundLinkForm">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="col-md-2">
                @Html.TextBoxFor(model => model.Data.URLTitle, new { placeholder = "URL Title", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Data.URLTitle, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-3">
                @Html.TextBoxFor(model => model.Data.URL, new { placeholder = "URL", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Data.URL, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-2">
                @Html.TextBoxFor(model => model.Data.Number, new { placeholder = "Number", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Data.Number, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-1 padding0 checkbox">
                <label for="Data_IsFollow">
                    @Html.CheckBoxFor(model => model.Data.IsFollow)
                    Is Follow?
                </label>
            </div>
            <div class="col-md-3">
                @Html.TextBoxFor(model => model.Data.Comment, new { placeholder = "Comment", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Data.Comment, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-1">
                <button type="button" id="outboundLinkFormSubmit" onclick="onSaveButtonClick()" class="btn btn-success">Save</button>
            </div>
            @Html.Hidden("outboundLinkId")

        </form>
    </div>

    <div class="table-responsive">
        <table id="outboundLinkTable" class="table table-bordered">
            <tr>
                <th width="15%">URLTitle</th>
                <th width="25%">URL</th>
                <th width="5%">Number</th>
                <th width="8%">Follow (Y/N)</th>
                <th width="20%">Comment</th>
                <th width="5%">Actions</th>
            </tr>
            <tbody>
                @if (Model.List.Count > 0)
                {
                    foreach (var outboundLink in Model.List)
                    {
                        <tr id="@outboundLink.Id" data-urltitle="@outboundLink.URLTitle" data-url="@outboundLink.URL" data-number="@outboundLink.Number" data-comment="@outboundLink.Comment">

                            <td>
                                @Html.DisplayFor(modelItem => outboundLink.URLTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => outboundLink.URL)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => outboundLink.Number)
                            </td>
                            @{
                                var isFollow = "N";
                                if (outboundLink.IsFollow)
                                {
                                    isFollow = "Y";
                                }
                            }
                            <td>
                                @isFollow
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => outboundLink.Comment)
                            </td>
                            <td>
                                <a href="javascript:void(0);" type='button' title="Edit" onclick="onEditIconClick('@outboundLink.Id')"><i class="fa fa-edit"></i></a>
                                <a href="javascript:void(0);" type='button' title="Delete" onclick="onDeleteIconClick('@outboundLink.Id')"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td class="text-center well" colspan="7">No Records Found</td></tr>
                }
            </tbody>
        </table>
    </div>
    @section Scripts {
        <script type="text/javascript">
            $(document).ready(function () {
                $.validator.unobtrusive.parse($("#outboundLinkForm"));
            })

            /**
             * Called when edit icon gets clicked
             */
            function onEditIconClick(id) {
                // Get outbound lik details and bind it to form
                $.ajax({
                    type: "GET",
                    url: "/admin/business/outbound-detail/" + id,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        $("#Data_URLTitle").val(response.URLTitle);
                        $("#Data_URL").val(response.URL);
                        $("#Data_Number").val(response.Number);
                        $("#Data_IsFollow").prop("checked", response.IsFollow);
                        $("#Data_Comment").val(response.Comment);
                        $("#outboundLinkId").val(response.Id);
                    }
                });
            }

            /**
             * Called when delete icon gets clicked
             */
            function onDeleteIconClick(id) {
                // Take user confirmation before deletion link
                if (confirm('Are you sure you want to delete this link?')) {
                    $.ajax({
                        type: "POST",
                        url: "/admin/business/delete-outbound-link/" + id,
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function () {
                            location.reload();
                        }
                    });
                }
            }

            /**
             * Called when save button gets clicked
             */
            function onSaveButtonClick() {

                if ($("#outboundLinkForm").valid()) {

                    var formData = {
                        Id: $("#outboundLinkId").val(),
                        URLTitle: $("#Data_URLTitle").val(),
                        URL: $("#Data_URL").val(),
                        Number: $("#Data_Number").val(),
                        IsFollow: $("#Data_IsFollow").prop("checked"),
                        Comment: $("#Data_Comment").val(),
                    }

                    $.ajax({
                        url: "/admin/business/save-outbound-link",
                        type: "POST",
                        data: formData,
                        success: function (response) {
                            // If response false means you have already added 5 links
                            if (response == false) {
                                showAlertMessage("#dvNotification", "danger", "Maximum 5 outbound Links allowed.")
                            }
                            else {
                                location.reload();
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.responseText);
                        }
                    });
                }
            }
        </script>
    }
</body>
</html>



